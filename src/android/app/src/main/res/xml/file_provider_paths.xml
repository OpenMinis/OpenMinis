<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Scope: app cache dir. Used by provider-config export (JSON files
         written to ${context.cacheDir}/shared/). -->
    <cache-path name="shared" path="shared/" />
    <!-- Debug RPC attachment staging — chat.prompt's base64 payload lands here. -->
    <cache-path name="rpc-attachments" path="rpc-attachments/" />
    <!-- Camera-captured photos staged for the composer's "Take Photo" entry.
         Kept under filesDir (not cacheDir) because some MIUI builds clear
         cache while the camera Activity is in flight, leaving the FileProvider
         URI pointing at nothing by the time the result returns. -->
    <files-path name="camera-photos" path="camera-photos/" />
    <!-- T207: FullscreenImageViewer share / copy temp files. T197 wrote them
         to cacheDir root, which isn't covered by any declared root, so
         FileProvider.getUriForFile threw IllegalArgumentException and the
         user saw "分享失败" toasts instead of the share sheet. -->
    <cache-path name="share" path="share/" />
    <!-- PRoot rootfs — expose so inline video/audio cards can hand the host
         file to the system player via ACTION_VIEW. -->
    <files-path name="rootfs" path="alpine-rootfs/" />
    <!-- Per-session attachments/workspace/etc. where agent downloads land. -->
    <files-path name="sessions" path="minis-sessions/" />
    <files-path name="global" path="minis-global/" />
    <!-- Downloaded update APKs (UpdateChecker → PendingUpdateStore). Moved
         from cacheDir/shared/ to filesDir/updates/ so the OS doesn't evict
         the APK while the user is in system Settings granting "install
         unknown apps" permission (T-android-update-resume-33637). -->
    <files-path name="updates" path="updates/" />
    <!-- Daily-rotated app logs (AppLogger) + crash reports (T283 ACRA / NDK
         signal handler). Without this, LogManagementScreen.shareLogFile
         silently fell back to EXTRA_TEXT, sharing the log contents as a
         text body instead of a real file attachment — broke email / Drive
         / any chat target that wanted the .log file itself. -->
    <files-path name="logs" path="logs/" />
    <!-- [T-android-backup-local-export] Finished .minisbak packages
         (BackupExporter.backupsDirectory = filesDir/Backups/). Exposed so the
         backup screen's "Share…" can hand a package to another app; each grant
         is per-URI and read-only via FLAG_GRANT_READ_URI_PERMISSION, and the
         provider itself is not exported. -->
    <files-path name="backups" path="Backups/" />
    <!-- [T-android-mount-fileprovider-root] Mounted folders are picked with
         OpenDocumentTree (on-device storage only) and used by their real path
         under /storage — /storage/emulated/0/… for internal storage,
         /storage/XXXX-XXXX/… for an SD card. No root above covered them, so
         getUriForFile threw "Failed to find configured root" and every Share /
         Open-with on a mounted file failed (file preview, chat file links,
         inline media). root-path is scoped to /storage, not "/": the grant is
         still per-URI and read-only, and the provider is not exported. An
         external-path would cover internal storage only, not SD cards. -->
    <root-path name="device-storage" path="storage/" />
</paths>
