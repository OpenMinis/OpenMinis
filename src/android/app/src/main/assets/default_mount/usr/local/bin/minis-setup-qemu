#!/bin/sh
# Install qemu-user-static for x86_64 (and other arch) emulation. Idempotent.
# Part of the dev-suite "qemu-x86-64-compat" online tool.
#
# NOTE: binfmt_misc auto-registration does NOT work inside PRoot (no kernel
# binfmt access). The qemu-x86_64 binary itself works fine — invoke it
# EXPLICITLY:  qemu-x86_64 /path/to/x86_64/binary args…
#
# [T-devsuite-verify] No payload is fetched here: qemu-user-static comes from
# the archive the guest's apt sources point at, and apt/dpkg verify it against
# the repository Release/InRelease signature plus the per-package checksum, so
# there is nothing for this script to pin. Nothing in this file may be changed
# to a direct URL download — that is exactly the path the other minis-setup-*
# scripts have to guard with a digest (see /usr/local/lib/minis/offline.sh).
set -eu
export DEBIAN_FRONTEND=noninteractive
export TMPDIR=/tmp TMP=/tmp TEMP=/tmp

# [T-devsuite-qemu-probe] Which binary name counts as present: Ubuntu 24.04
# arm64 ships ONLY *-static names (/usr/bin/qemu-x86_64-static, no bare
# qemu-x86_64), while older Debian ships the bare name. Accept BOTH — pinning
# the check to one of them failed the idempotent path on the other distro and
# re-ran apt for a package that is already installed.
if command -v qemu-x86_64 >/dev/null 2>&1; then
  echo "qemu-x86_64 already present: $(qemu-x86_64 --version | head -1)"
  exit 0
fi
if command -v qemu-x86_64-static >/dev/null 2>&1; then
  echo "qemu-x86_64-static already present: $(qemu-x86_64-static --version | head -1)"
  echo "remember: PRoot has no binfmt_misc — call qemu-x86_64-static <binary> explicitly (or the bare name where it exists)."
  exit 0
fi

command -v apt-get >/dev/null 2>&1 || { echo "apt-get not found" >&2; exit 1; }
[ -f /usr/local/lib/minis/apt-lock.sh ] || { echo "shared apt lock helper missing" >&2; exit 1; }
. /usr/local/lib/minis/apt-lock.sh
minis_acquire_apt_lock 1800 || { echo "apt is busy" >&2; exit 1; }
trap minis_release_apt_lock EXIT
apt-get update
apt-get install -y --no-install-recommends qemu-user-static

command -v qemu-x86_64 >/dev/null 2>&1 || command -v qemu-x86_64-static >/dev/null 2>&1 || { echo "qemu-x86_64 still missing after install" >&2; exit 1; }
echo "qemu-user-static installed"
echo "remember: PRoot has no binfmt_misc — call qemu-x86_64 (or qemu-x86_64-static) <binary> explicitly."
