#!/bin/sh
# List every network payload the dev-suite recipes may fetch, so a
# network-restricted user can download them elsewhere and drop them into
# /var/minis/shared/offline/ (host-visible shared folder). Installers check
# that directory FIRST and skip the network entirely on a hit.
#
# Usage: minis-devsuite-offline-list [bundle-id]
set -eu

OFFLINE_DIR=/var/minis/shared/offline

emit() {
  # emit <file-name> <primary-url> [extra-urls...]
  name=$1; shift
  printf '%s\n' "FILE: $name"
  for u in "$@"; do printf '  URL: %s\n' "$u"; done
  printf '  PUT: %s/%s\n' "$OFFLINE_DIR" "$name"
}

case "${1:-all}" in
  all|android-core|android-suite)
    emit android-sdk-tools-static-aarch64.zip \
      "https://github.com/lzhiyong/android-sdk-tools/releases/download/35.0.2/android-sdk-tools-static-aarch64.zip"
    emit commandlinetools-linux-11076708_latest.zip \
      "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip"
    emit platform-36_r02.zip \
      "https://dl.google.com/android/repository/platform-36_r02.zip"
    emit platform-35-ext7_r03.zip \
      "https://dl.google.com/android/repository/platform-35-ext7_r03.zip"
    emit cmake-3.31.6-linux-aarch64.tar.gz \
      "https://github.com/Kitware/CMake/releases/download/v3.31.6/cmake-3.31.6-linux-aarch64.tar.gz"
    emit android-ndk-r29-aarch64.tar.xz \
      "https://github.com/lzhiyong/termux-ndk/releases/download/android-ndk/android-ndk-r29-aarch64.tar.xz"
    [ "${1:-}" = "android-core" ] && exit 0
    [ "${1:-}" = "android-suite" ] || exit 0
    ;;
esac

case "${1:-all}" in
  all|flutter)
    emit flutter_linux_3.24.5.tar.xz \
      "https://storage.googleapis.com/flutter_infra/releases/stable/linux/flutter_linux_3.24.5.tar.xz"
    ;;
esac

case "${1:-all}" in
  all|android-re)
    emit jadx-1.5.1.zip \
      "https://github.com/skylot/jadx/releases/download/v1.5.1/jadx-1.5.1.zip"
    ;;
esac

case "${1:-all}" in
  all|rust-dev)
    emit rustup-init.sh \
      "https://rsproxy.cn/rustup-init.sh" \
      "https://sh.rustup.rs"
    ;;
esac

case "${1:-all}" in
  all|llama-cpp)
    emit llama.cpp-master.tar.gz \
      "https://github.com/ggml-org/llama.cpp/archive/refs/heads/master.tar.gz"
    ;;
esac

echo
echo "把下载好的文件原样放进 $OFFLINE_DIR/（宿主侧同路径），"
echo "再回到插件市场点装配——安装器检测到本地文件会完全跳过网络。"
echo "apt 组件（rg/fd/nodejs/python3 等）走 apt 源，请用 minis-mirror 切国内源。"
