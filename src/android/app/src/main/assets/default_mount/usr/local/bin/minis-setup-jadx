#!/bin/sh
# Install jadx (Android reverse-engineering / decompiler) into /opt/jadx.
# Part of the dev-suite "android-re" component; idempotent.
set -eu
export TMPDIR=/tmp TMP=/tmp TEMP=/tmp

JADX_ROOT=/opt/jadx
JADX_VERSION="${JADX_VERSION:-1.5.1}"
ZIP="jadx-${JADX_VERSION}.zip"
GH="https://github.com/skylot/jadx/releases/download/v${JADX_VERSION}/${ZIP}"

if [ -x "$JADX_ROOT/bin/jadx" ]; then
  echo "jadx already present: $JADX_ROOT"
  exit 0
fi

command -v curl >/dev/null 2>&1 || { echo "curl missing — run minis-dev-setup first" >&2; exit 1; }
command -v unzip >/dev/null 2>&1 || {
  . /usr/local/lib/minis/apt-lock.sh
  minis_acquire_apt_lock 1800 || exit 1
  trap minis_release_apt_lock EXIT
  apt-get install -y --no-install-recommends unzip
}

# [T-devsuite-verify] skylot/jadx publishes NO checksum for its release assets
# (the v1.5.1 release carries only the two zips, no .sha256 and no signed
# digest file), so there is nothing published to compare the bytes against.
# Consequence, enforced by offline.sh: the download runs against the FIRST URL
# only — github.com over TLS — and the anonymous GitHub proxies below are
# skipped, because without a digest a proxy could substitute the zip and
# `unzip -qo` + the PATH links would run whatever it put there. To use a proxy
# or an offline copy, pin the digest yourself (Settings -> Environment
# Variables): MINIS_DEVSUITE_SHA256="$ZIP=<sha256-of-the-zip>".
tmp="/tmp/jadx-$$.zip"
. /usr/local/lib/minis/offline.sh
if ! resume_fetch "$tmp" "$ZIP" \
  "$GH" \
  "https://ghfast.top/$GH" \
  "https://ghproxy.net/$GH" \
  "https://mirror.ghproxy.com/$GH"
then
  echo "jadx download failed (all reachable sources) or checksum mismatch. Offline fallback: put $ZIP in /var/minis/shared/offline/ and set MINIS_ALLOW_OFFLINE=1." >&2
  exit 1
fi

# Verified (when a digest is known) — only now does the archive touch disk.
stage="/tmp/jadx-unpack-$$"
mkdir -p "$stage"
unzip -qo "$tmp" -d "$stage"
rm -f "$tmp"
[ -x "$stage/bin/jadx" ] || { echo "unexpected jadx zip layout" >&2; rm -rf "$stage"; exit 1; }

mkdir -p /opt
rm -rf "$JADX_ROOT"
mv "$stage" "$JADX_ROOT"
ln -sf "$JADX_ROOT/bin/jadx" /usr/local/bin/jadx
ln -sf "$JADX_ROOT/bin/jadx-gui" /usr/local/bin/jadx-gui 2>/dev/null || true
echo "jadx $JADX_VERSION -> $JADX_ROOT"
