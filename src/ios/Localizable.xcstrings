        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peristiwa sinkronisasi dicatat saat iCloud mengirim dan menerima data. Hingga 1.000 entri disimpan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 同期がデータを送受信するたびに同期イベントが記録されます。最大 1,000 件まで保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
