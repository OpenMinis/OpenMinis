          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un dossier pour y copier également chaque sauvegarde — y compris un serveur connecté dans l'app Fichiers (SMB, WebDAV) ou un fournisseur cloud."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte mapu da bi se svaka sigurnosna kopija kopirala i ondje — uključujući poslužitelj povezan u aplikaciji Files (SMB, WebDAV) ili pružatelja usluga u oblaku."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
