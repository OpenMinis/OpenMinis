    "Minis does not operate any server and does not collect, store, or process any of your personal data. All data stays on your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis betreibt keinen Server und erhebt, speichert oder verarbeitet keine Ihrer persönlichen Daten. Alle Daten verbleiben auf Ihrem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis does not operate any server and does not collect, store, or process any of your personal data. All data stays on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis no opera ningún servidor y no recopila, almacena ni procesa ninguno de tus datos personales. Todos los datos permanecen en tu dispositivo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Walang pinapatakbong server ang Minis at hindi ito nangongolekta, nag-iimbak, o nagpoproseso ng personal mong datos. Nananatili sa device mo lahat ng datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis n'exploite aucun serveur et ne collecte, stocke ou traite aucune de vos données personnelles. Toutes les données restent sur votre appareil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis ne upravlja nijednim poslužiteljem i ne prikuplja, sprema niti obrađuje nijedan vaš osobni podatak. Svi podaci ostaju na vašem uređaju."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis tidak mengoperasikan server apa pun dan tidak mengumpulkan, menyimpan, atau memproses data pribadi Anda. Semua data tetap di perangkat Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis はサーバーを運営しておらず、個人データの収集、保存、処理を一切行いません。すべてのデータはお使いのデバイスに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis는 서버를 운영하지 않으며 개인 데이터를 수집, 저장 또는 처리하지 않습니다. 모든 데이터는 기기에 보관됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis tidak mengendalikan sebarang server dan tidak mengumpul, menyimpan, atau memproses data peribadi anda. Semua data kekal pada peranti anda."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis nie prowadzi żadnego serwera i nie zbiera, nie przechowuje ani nie przetwarza Twoich danych osobowych. Wszystkie dane zostają na urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Minis não opera nenhum servidor e não coleta, armazena nem processa seus dados pessoais. Todos os dados ficam no seu dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis nu operează niciun server și nu colectează, stochează sau prelucrează datele tale personale. Toate datele rămân pe dispozitivul tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis не использует серверы и не собирает, не хранит и не обрабатывает ваши личные данные. Все данные остаются на вашем устройстве."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis ไม่ได้ดำเนินการเซิร์ฟเวอร์ใดๆ และไม่เก็บรวบรวม จัดเก็บ หรือประมวลผลข้อมูลส่วนบุคคลของคุณ ข้อมูลทั้งหมดอยู่บนอุปกรณ์ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis hiçbir sunucu işletmez ve kişisel verilerinizi toplamaz, saklamaz veya işlemez. Tüm veriler aygıtınızda kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis 不运营任何服务器，不会收集、存储或处理您的任何个人数据。所有数据都保存在您的设备上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis 不運營任何服務器，不會收集、存儲或處理您的任何個人資料。所有資料都儲存在您的設備上。"
          }
        }
      }
    },
