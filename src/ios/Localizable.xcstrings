    "Sync events are recorded as iCloud sync sends and receives data. Up to 1,000 entries are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisierungsereignisse werden aufgezeichnet, sobald iCloud-Synchronisierung Daten sendet und empfängt. Bis zu 1.000 Einträge werden gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync events are recorded as iCloud sync sends and receives data. Up to 1,000 entries are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos se registran a medida que la sincronización con iCloud envía y recibe datos. Se conservan hasta 1.000 entradas."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naitatala ang mga sync event habang nagpapadala at tumatanggap ng datos ang iCloud sync. Hanggang 1,000 entry ang itinatago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements de synchronisation sont enregistrés lorsque la synchronisation iCloud envoie et reçoit des données. Jusqu'à 1 000 entrées sont conservées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
