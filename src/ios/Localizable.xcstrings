    "Already-uploaded records stay on iCloud. Pending history backfill stops; you can request again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits hochgeladene Datensätze bleiben in iCloud. Das ausstehende Nachtragen des Verlaufs stoppt; du kannst es später erneut anfordern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Already-uploaded records stay on iCloud. Pending history backfill stops; you can request again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros ya subidos permanecen en iCloud. El relleno pendiente del historial se detiene; puedes solicitarlo de nuevo más adelante."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nananatili sa iCloud ang mga na-upload nang record. Titigil ang nakabinbing pagpuno ng history; puwede kang humiling ulit mamaya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements déjà envoyés restent sur iCloud. Le transfert de l'historique en attente s'arrête ; vous pourrez le redemander plus tard."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Već poslani zapisi ostaju na iCloudu. Dopunjavanje povijesti koje je na čekanju zaustavlja se; možete ga zatražiti ponovno kasnije."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catatan yang sudah diunggah tetap di iCloud. Pengisian riwayat yang tertunda berhenti; Anda dapat memintanya lagi nanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロード済みのレコードは iCloud に残ります。保留中の履歴転送は停止しますが、後で再度依頼できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 업로드된 레코드는 iCloud에 남습니다. 대기 중인 기록 전송은 중지되며, 나중에 다시 요청할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekod yang telah dimuat naik kekal di iCloud. Pengisian sejarah tertunda berhenti; anda boleh memintanya semula kemudian."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesłane już rekordy zostają w iCloud. Oczekujące uzupełnianie historii zatrzyma się; możesz je później ponowić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os registros já enviados ficam no iCloud. A transferência pendente do histórico para, e você pode solicitá-la de novo depois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înregistrările deja încărcate rămân în iCloud. Completarea istoricului în așteptare se oprește; poți solicita din nou mai târziu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже отправленные записи остаются в iCloud. Ожидающий перенос истории останавливается; вы сможете запросить его позже."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระเบียนที่อัปโหลดแล้วจะยังอยู่บน iCloud การเติมประวัติที่ค้างอยู่จะหยุดลง คุณขอใหม่ได้ภายหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklenmiş kayıtlar iCloud'da kalır. Bekleyen geçmiş doldurma durur; daha sonra yeniden isteyebilirsiniz."
          }
        },
