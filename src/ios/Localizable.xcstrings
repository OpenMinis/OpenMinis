    "Folders come from the Files app — on this iPhone, iCloud Drive, or a connected server." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner stammen aus der App „Dateien“ — von diesem iPhone, aus iCloud Drive oder von einem verbundenen Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folders come from the Files app — on this iPhone, iCloud Drive, or a connected server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las carpetas provienen de la app Archivos: en este iPhone, en iCloud Drive o en un servidor conectado."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Galing sa Files app ang mga folder — sa iPhone na ito, iCloud Drive, o nakakonektang server."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dossiers proviennent de l'app Fichiers — sur cet iPhone, dans iCloud Drive ou sur un serveur connecté."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mape dolaze iz aplikacije Datoteke — s ovog iPhonea, iCloud Drivea ili povezanog poslužitelja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder berasal dari aplikasi Files — di iPhone ini, iCloud Drive, atau server yang terhubung."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダは「ファイル」アプリから取得します。この iPhone、iCloud Drive、接続済みのサーバが対象です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더는 파일 앱에서 가져옵니다. 이 iPhone, iCloud Drive 또는 연결된 서버가 대상입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder datang dari apl Files — pada iPhone ini, iCloud Drive, atau server yang disambung."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foldery pochodzą z aplikacji Pliki — z tego iPhone'a, iCloud Drive lub podłączonego serwera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As pastas vêm do app Arquivos — neste iPhone, no iCloud Drive ou em um servidor conectado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosarele provin din aplicația Fișiere — de pe acest iPhone, din iCloud Drive sau de pe un server conectat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папки берутся из приложения «Файлы» — с этого iPhone, из iCloud Drive или с подключённого сервера."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โฟลเดอร์มาจากแอป Files — บน iPhone นี้ iCloud Drive หรือเซิร์ฟเวอร์ที่เชื่อมต่ออยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasörler Dosyalar uygulamasından gelir — bu iPhone'da, iCloud Drive'da veya bağlı bir sunucuda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件夹来自“文件”App——可以是本机、iCloud 云盘或已连接的服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料夾來自「檔案」App，可以在這台 iPhone、iCloud Drive 或已連線的伺服器上。"
          }
        }
      }
    },
