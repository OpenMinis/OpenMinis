    "Speech-to-text and text-to-speech vendors. The provider type and base URL are prefilled — just add your API key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anbieter für Sprache-zu-Text und Text-zu-Sprache. Anbietertyp und Basis-URL sind vorausgefüllt – füge nur deinen API-Schlüssel hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech-to-text and text-to-speech vendors. The provider type and base URL are prefilled — just add your API key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proveedores de voz a texto y texto a voz. El tipo de proveedor y la URL base ya están rellenados: solo añade tu clave de API."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga vendor ng speech-to-text at text-to-speech. Nakalagay na ang uri ng provider at base URL — idagdag na lang ang API key mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournisseurs de reconnaissance et de synthèse vocales. Le type de fournisseur et l’URL de base sont préremplis — ajoute simplement ta clé API."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pružatelji usluga govora u tekst i teksta u govor. Vrsta pružatelja i osnovni URL već su ispunjeni — samo dodajte svoj API ključ."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendor ucapan-ke-teks dan teks-ke-ucapan. Jenis penyedia dan URL basis sudah terisi — cukup tambahkan kunci API Anda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声認識と音声合成のベンダー。プロバイダーの種類とベース URL は入力済みです — API キーを追加するだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 인식 및 음성 합성 공급업체. 제공자 유형과 기본 URL은 미리 입력되어 있습니다 — API 키만 추가하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendor pertuturan-ke-teks dan teks-ke-pertuturan. Jenis pembekal dan URL asas sudah diisi — cuma tambah kunci API anda."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostawcy zamiany mowy na tekst i tekstu na mowę. Typ dostawcy i bazowy adres URL są już uzupełnione — wystarczy dodać klucz API."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provedores de fala para texto e de texto para fala. O tipo de provedor e a URL base já vêm preenchidos — basta adicionar sua chave de API."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Furnizori de transcriere și de sinteză vocală. Tipul furnizorului și adresa de bază sunt deja completate — mai trebuie doar cheia ta API."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поставщики распознавания и синтеза речи. Тип провайдера и базовый URL уже заполнены — просто добавьте ключ API."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ผู้ให้บริการเสียงพูดเป็นข้อความและข้อความเป็นเสียงพูด ประเภทผู้ให้บริการและ base URL กรอกไว้ให้แล้ว — เพียงเพิ่มคีย์ API ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşmadan metne ve metinden konuşmaya sağlayıcıları. Sağlayıcı türü ve temel URL önceden doldurulmuştur — yalnızca API anahtarınızı eklemeniz yeterli."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音转文字和文字转语音服务商。服务商类型和基础 URL 已预填 — 只需添加你的 API Key。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語音轉文字和文字轉語音服務商。服務商類型和基礎 URL 已預填 — 只需加入你的 API Key。"
          }
        }
      }
    },
