    "Override the User-Agent header sent to this endpoint. Leave empty to use the Minis default. Useful for relays that only accept specific clients (e.g. \"claude-cli/1.0\")." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überschreibe den an diesen Endpunkt gesendeten User-Agent-Header. Leer lassen, um den Minis-Standard zu verwenden. Nützlich für Relays, die nur bestimmte Clients akzeptieren (z. B. „claude-cli/1.0“)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Override the User-Agent header sent to this endpoint. Leave empty to use the Minis default. Useful for relays that only accept specific clients (e.g. \"claude-cli/1.0\")."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye la cabecera User-Agent que se envía a este endpoint. Déjalo vacío para usar el valor predeterminado de Minis. Es útil para relays que solo aceptan clientes concretos (p. ej. \"claude-cli/1.0\")."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palitan ang User-Agent header na ipinapadala sa endpoint na ito. Iwanang blangko para gamitin ang default ng Minis. Kapaki-pakinabang sa mga relay na tumatanggap lang ng partikular na client (hal. \"claude-cli/1.0\")."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace l’en-tête User-Agent envoyé à ce point de terminaison. Laisse vide pour utiliser la valeur par défaut de Minis. Utile pour les relais qui n’acceptent que certains clients (par ex. « claude-cli/1.0 »)."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadjačajte User-Agent zaglavlje koje se šalje ovoj krajnjoj točki. Ostavite prazno za zadanu Minis vrijednost. Korisno za releje koji prihvaćaju samo određene klijente (npr. \"claude-cli/1.0\")."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timpa header User-Agent yang dikirim ke endpoint ini. Kosongkan untuk memakai bawaan Minis. Berguna untuk relay yang hanya menerima klien tertentu (mis. \"claude-cli/1.0\")."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエンドポイントに送信される User-Agent ヘッダーを上書きします。空欄にすると Minis のデフォルトを使用します。特定のクライアントのみを受け付けるリレー（例：「claude-cli/1.0」）に便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 엔드포인트로 전송되는 User-Agent 헤더를 재정의합니다. 비워 두면 Minis 기본값을 사용합니다. 특정 클라이언트만 허용하는 릴레이(예: \"claude-cli/1.0\")에 유용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gantikan header User-Agent yang dihantar ke endpoint ini. Biarkan kosong untuk menggunakan lalai Minis. Berguna untuk relay yang hanya menerima klien tertentu (cth. \"claude-cli/1.0\")."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zastąp nagłówek User-Agent wysyłany do tego punktu końcowego. Pozostaw puste, aby użyć wartości domyślnej Minis. Przydatne przy przekaźnikach akceptujących tylko wybranych klientów (np. \"claude-cli/1.0\")."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitui o cabeçalho User-Agent enviado a este endpoint. Deixe vazio para usar o padrão do Minis. Útil para relays que só aceitam determinados clientes (ex.: \"claude-cli/1.0\")."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înlocuiește antetul User-Agent trimis către acest endpoint. Lasă gol pentru valoarea implicită Minis. Util pentru relee care acceptă doar anumiți clienți (ex. \"claude-cli/1.0\")."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переопределяет заголовок User-Agent, отправляемый на этот эндпойнт. Оставьте пустым, чтобы использовать значение Minis по умолчанию. Полезно для реле, принимающих только определённых клиентов (напр. «claude-cli/1.0»)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แทนที่ส่วนหัว User-Agent ที่ส่งไปยังเอนด์พอยต์นี้ เว้นว่างไว้เพื่อใช้ค่าเริ่มต้นของ Minis มีประโยชน์กับรีเลย์ที่รับเฉพาะไคลเอนต์บางตัว (เช่น \"claude-cli/1.0\")"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uç noktaya gönderilen User-Agent başlığını değiştirin. Minis varsayılanı için boş bırakın. Yalnızca belirli istemcileri kabul eden aktarıcılar için yararlıdır (ör. \"claude-cli/1.0\")."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆盖发送到此接口的 User-Agent 头。留空则使用 Minis 默认值。适用于仅接受特定客户端的中继（例如“claude-cli/1.0”）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆寫傳送到此端點的 User-Agent 標頭。留空則使用 Minis 預設值。適用於僅接受特定使用者端的中繼（例如「claude-cli/1.0」）。"
          }
        }
      }
    },
