          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Key 安全存儲在 iOS 鑰匙串中。"
          }
        }
      }
    },
    "API keys and tokens are stored only in the iOS Keychain on your device and are never sent to us" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Keys und Tokens werden nur im iOS-Schlüsselbund auf Ihrem Gerät gespeichert und niemals an uns gesendet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API keys and tokens are stored only in the iOS Keychain on your device and are never sent to us"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de API y los tokens se guardan únicamente en el Keychain de iOS de tu dispositivo y nunca se nos envían"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga API key at token ay nakaimbak lang sa iOS Keychain sa device mo at hindi kailanman ipinapadala sa amin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés API et tokens sont stockés uniquement dans le trousseau iOS de votre appareil et ne nous sont jamais envoyés"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API ključevi i tokeni pohranjeni su isključivo u iOS Keychainu na vašem uređaju i nikada nam se ne šalju"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci API dan token hanya disimpan di Keychain iOS pada perangkat Anda dan tidak pernah dikirim ke kami"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API KeyとTokenはデバイスのiOS キーチェーンにのみ保存され、私たちに送信されることはありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Key와 Token은 기기의 iOS 키체인에만 저장되며 저희에게 전송되지 않습니다"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci API dan token hanya disimpan dalam Keychain iOS pada peranti anda dan tidak pernah dihantar kepada kami"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucze API i tokeny są przechowywane wyłącznie w Pęku kluczy iOS na Twoim urządzeniu i nigdy nie trafiają do nas"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves de API e os tokens ficam apenas no Keychain do iOS do seu dispositivo e nunca são enviados para nós"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheile API și tokenurile sunt stocate doar în Keychain-ul iOS de pe dispozitivul tău și nu ne sunt trimise niciodată"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи API и токены хранятся только в Keychain iOS на вашем устройстве и никогда не отправляются нам"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คีย์ API และโทเคนถูกจัดเก็บใน iOS Keychain บนอุปกรณ์ของคุณเท่านั้น และไม่เคยถูกส่งมาให้เรา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API anahtarları ve token'lar yalnızca aygıtınızdaki iOS Anahtar Zinciri'nde saklanır ve bize hiç gönderilmez"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Key 和 Token 仅存储在设备的 iOS 钥匙串中，绝不会发送给我们"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Key 和 Token 僅存儲在設備的 iOS 鑰匙串中，絕不會傳送給我們"
          }
        }
      }
    },
    "API keys restored" : {
