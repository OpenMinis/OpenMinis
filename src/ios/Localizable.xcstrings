        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the name or folder to change them, or edit the connection to change the address and password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el nombre o la carpeta para cambiarlos, o edita la conexión para cambiar la dirección y la contraseña."
          }
        },
        "fil" : {
          "stringUnit" : {
