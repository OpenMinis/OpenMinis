    "Every backup is copied to these. Swipe to remove one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Sicherung wird hierher kopiert. Zum Entfernen streichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every backup is copied to these. Swipe to remove one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las copias de seguridad se copian aquí. Desliza para quitar una."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinokopya dito ang bawat backup. Mag-swipe para mag-alis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque sauvegarde y est copiée. Balayez pour en supprimer une."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svaka se sigurnosna kopija kopira ovamo. Povucite prstom da biste uklonili odredište."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap cadangan disalin ke sini. Geser untuk menghapus salah satu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのバックアップがここにコピーされます。スワイプで削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 백업이 이곳에 복사됩니다. 쓸어넘겨 제거할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap sandaran disalin ke sini. Leret untuk membuang salah satu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda kopia jest kopiowana tutaj. Przesuń, aby usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo backup é copiado para estes. Deslize para remover um."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiecare copie este copiată aici. Glisează pentru a elimina una."
          }
        },
        "ru" : {
          "stringUnit" : {
