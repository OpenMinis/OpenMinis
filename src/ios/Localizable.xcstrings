    "Mount limit reached (%d). Remove an existing mount before adding a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mount-Limit erreicht (%d). Entfernen Sie einen vorhandenen Mount, bevor Sie einen neuen hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mount limit reached (%d). Remove an existing mount before adding a new one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alcanzó el límite de montajes (%d). Elimina un montaje existente antes de añadir uno nuevo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naabot ang limitasyon sa mount (%d). Mag-alis muna bago magdagdag ng bago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de montages atteinte (%d). Supprimez un montage existant avant d'en ajouter un nouveau."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosegnuto ograničenje montiranja (%d). Uklonite postojeće montiranje prije dodavanja novog."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batas pemasangan tercapai (%d). Hapus pemasangan yang ada sebelum menambah yang baru."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウント数の上限（%d）に達しました。新規追加の前に既存のマウントを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마운트 한도(%d)에 도달했습니다. 새로 추가하기 전에 기존 마운트를 제거하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Had lekapan dicapai (%d). Buang lekapan sedia ada sebelum menambah yang baharu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osiągnięto limit zamontowań (%d). Usuń istniejące, zanim dodasz nowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite de montagens atingido (%d). Remova uma montagem antes de adicionar outra."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita de montări a fost atinsă (%d). Elimină una existentă înainte de a adăuga alta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достигнут лимит подключений (%d). Удалите существующее подключение, прежде чем добавлять новое."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถึงขีดจำกัดเมานต์แล้ว (%d) นำเมานต์เดิมออกก่อนเพิ่มใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlama sınırına ulaşıldı (%d). Yeni eklemeden önce var olan bir bağlamayı kaldırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已达到挂载数量上限（%d）。请先移除一个已有挂载再添加新的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已達到掛載數量上限（%d）。請先移除一個已有掛載再加入新的。"
          }
        }
      }
    },
