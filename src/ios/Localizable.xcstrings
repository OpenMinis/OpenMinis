    "Show local notifications when agent tasks start and complete, including tasks triggered by Shortcuts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale Benachrichtigungen anzeigen, wenn Agentenaufgaben starten und abgeschlossen werden, einschließlich über Kurzbefehle gestarteter Aufgaben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show local notifications when agent tasks start and complete, including tasks triggered by Shortcuts."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher des notifications locales au démarrage et à la fin des tâches de l'agent, y compris celles déclenchées par les Raccourcis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットから起動したタスクを含め、エージェントタスクの開始・完了時にローカル通知を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축어로 실행된 작업을 포함하여 에이전트 작업 시작 및 완료 시 로컬 알림을 표시합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать локальные уведомления при запуске и завершении задач Agent, включая задачи, запущенные из «Быстрых команд»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在代理任务开始和完成时显示本地通知，包括快捷指令触发的任务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在代理任務開始和完成時顯示本地通知，包括快捷指令觸發的任務。"
          }
        }
      }
    },
