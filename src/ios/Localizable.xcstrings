    "API keys and tokens are stored only in the iOS Keychain on your device and are never sent to us" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Keys und Tokens werden nur im iOS-Schlüsselbund auf Ihrem Gerät gespeichert und niemals an uns gesendet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API keys and tokens are stored only in the iOS Keychain on your device and are never sent to us"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de API y los tokens se guardan únicamente en el Keychain de iOS de tu dispositivo y nunca se nos envían"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés API et tokens sont stockés uniquement dans le trousseau iOS de votre appareil et ne nous sont jamais envoyés"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API KeyとTokenはデバイスのiOS キーチェーンにのみ保存され、私たちに送信されることはありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Key와 Token은 기기의 iOS 키체인에만 저장되며 저희에게 전송되지 않습니다"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи API и токены хранятся только в Keychain iOS на вашем устройстве и никогда не отправляются нам"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Key 和 Token 仅存储在设备的 iOS 钥匙串中，绝不会发送给我们"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API Key 和 Token 僅存儲在設備的 iOS 鑰匙串中，絕不會發送給我們"
