    "Groups let you combine models for fallback or load balancing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppen ermöglichen die Kombination von Modellen für Fallback oder Lastverteilung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groups let you combine models for fallback or load balancing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los grupos te permiten combinar modelos para respaldo o balanceo de carga."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puwede mong pagsamahin ang mga model sa group para sa fallback o load balancing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les groupes permettent de combiner des modèles pour le basculement ou la répartition de charge."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupe omogućuju kombiniranje modela za zamjenu ili raspodjelu opterećenja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grup memungkinkan Anda menggabungkan model untuk cadangan atau penyeimbangan beban."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グループを使うとフォールバックや負荷分散のためにモデルを組み合わせられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그룹을 사용하면 대체 또는 로드 밸런싱을 위해 모델을 결합할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumpulan membolehkan anda menggabungkan model untuk sandaran atau imbangan beban."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupy pozwalają łączyć modele na potrzeby przełączania awaryjnego lub równoważenia obciążenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os grupos permitem combinar modelos para fallback ou balanceamento de carga."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grupurile îți permit să combini modele pentru rezervă sau pentru echilibrarea încărcării."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Группы позволяют объединять модели для резервирования или балансировки нагрузки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลุ่มช่วยให้คุณรวมโมเดลเพื่อใช้เป็นตัวสำรองหรือกระจายโหลด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruplar, yedekleme ya da yük dengeleme için modelleri birleştirmenizi sağlar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型分组可实现回退或负载均衡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型分組可實現回退或負載均衡。"
          }
        }
      }
    },
