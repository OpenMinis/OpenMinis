    "Are you sure you want to delete \"%@\"? This action cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie „%@“ wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete \"%@\"? This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que quieres eliminar \"%@\"? Esta acción no se puede deshacer."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurado ka bang tatanggalin ang \"%@\"? Hindi na ito maibabalik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment supprimer « %@ » ? Cette action est irréversible."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeste li sigurni da želite obrisati \"%@\"? Ova se radnja ne može poništiti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakin ingin menghapus \"%@\"? Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を削除してもよろしいですか？この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”을(를) 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasti mahu memadam \"%@\"? Tindakan ini tidak boleh dibatalkan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno usunąć: \"%@\"? Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
