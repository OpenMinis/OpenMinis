    "Add a folder in Settings ▸ Shared Folders — including a server connected in the Files app (SMB, WebDAV) or a cloud provider — and it can be selected here." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a folder in Settings ▸ Shared Folders — including a server connected in the Files app (SMB, WebDAV) or a cloud provider — and it can be selected here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una carpeta en Ajustes ▸ Carpetas compartidas —incluido un servidor conectado en la app Archivos (SMB, WebDAV) o un proveedor en la nube— y podrás seleccionarla aquí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 ▸ 共享文件夹”中添加文件夹（包括在“文件”App 中连接的服务器，如 SMB、WebDAV，或各类云盘），即可在此选择。"
          }
        }
      }
    },
    "Add a folder to also copy each backup there — including a server connected in the Files app (SMB, WebDAV) or a cloud provider." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a folder to also copy each backup there — including a server connected in the Files app (SMB, WebDAV) or a cloud provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una carpeta para copiar allí también cada copia de seguridad, incluido un servidor conectado en la app Archivos (SMB, WebDAV) o un proveedor en la nube."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加文件夹后，每次备份都会同时复制到那里——包括在“文件”App 中连接的服务器（SMB、WebDAV）和各类云盘。"
          }
        }
      }
    },
