    "Override the display language for this app. \"System\" follows your device language." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzeigesprache dieser App ändern. „System“ folgt der Gerätesprache."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Override the display language for this app. \"System\" follows your device language."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye el idioma de la interfaz de esta app. \"Sistema\" sigue el idioma de tu dispositivo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palitan ang wika ng app na ito. Sinusunod ng \"System\" ang wika ng device mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer la langue d'affichage de l'app. « Système » suit la langue de l'appareil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadjačajte jezik prikaza za ovu aplikaciju. \"Sustav\" prati jezik vašeg uređaja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
