    "Sessions are distributed across models for load balancing." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzungen werden zur Lastverteilung auf die Modelle verteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions are distributed across models for load balancing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones se distribuyen entre los modelos para equilibrar la carga."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipinapamahagi ang mga session sa iba't ibang model para sa load balancing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
