    "The connection dropped — this reply may be incomplete. Tap Resume to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung wurde unterbrochen – diese Antwort ist möglicherweise unvollständig. Tippe auf „Fortsetzen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection dropped — this reply may be incomplete. Tap Resume to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perdió la conexión: es posible que esta respuesta esté incompleta. Toca Reanudar para continuar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naputol ang koneksyon — maaaring kulang ang sagot na ito. I-tap ang Ituloy para magpatuloy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a été interrompue — cette réponse est peut-être incomplète. Appuyez sur Reprendre."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza je prekinuta — ovaj odgovor može biti nepotpun. Dodirnite Nastavi za nastavak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi terputus — balasan ini mungkin tidak lengkap. Ketuk Lanjutkan untuk meneruskan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続が切断されました — この返信は不完全な可能性があります。「再開」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결이 끊어졌습니다 — 이 답변은 불완전할 수 있습니다. 다시 시작을 누르세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungan terputus — balasan ini mungkin tidak lengkap. Ketik Sambung untuk teruskan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenie zerwane — ta odpowiedź może być niepełna. Dotknij Wznów, aby kontynuować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão caiu — esta resposta pode estar incompleta. Toque em Retomar para continuar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiunea s-a întrerupt — răspunsul poate fi incomplet. Atinge Reia pentru a continua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение прервано — этот ответ может быть неполным. Нажмите «Продолжить»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเชื่อมต่อหลุด — คำตอบนี้อาจไม่สมบูรณ์ แตะดำเนินการต่อเพื่อไปต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı koptu — bu yanıt eksik olabilir. Sürdürmek için Sürdür'e dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络连接中断 — 回复可能不完整。点按「继续」以恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "網路連線中斷 — 回覆可能不完整。點按「繼續」以恢復。"
          }
        }
      }
    },
    "The connection stays encrypted, but its identity isn't verified. Only do this on a network and server you trust." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung bleibt verschlüsselt, aber ihre Identität wird nicht überprüft. Tu dies nur in einem Netzwerk und auf einem Server, denen du vertraust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection stays encrypted, but its identity isn't verified. Only do this on a network and server you trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión sigue cifrada, pero su identidad no está verificada. Hazlo solo en una red y un servidor de confianza."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nananatiling naka-encrypt ang koneksyon, pero hindi na-verify ang pagkakakilanlan nito. Gawin lang ito sa network at server na pinagkakatiwalaan mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion reste chiffrée, mais son identité n'est pas vérifiée. Ne le faites que sur un réseau et un serveur de confiance."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza ostaje šifrirana, ali njezin identitet nije provjeren. Učinite to samo na mreži i poslužitelju kojima vjerujete."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi tetap terenkripsi, tetapi identitasnya tidak terverifikasi. Lakukan ini hanya di jaringan dan server yang Anda percayai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通信は暗号化されたままですが、接続先の身元は検証されません。信頼できるネットワークとサーバでのみ実行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결은 암호화된 상태로 유지되지만 신원은 확인되지 않습니다. 신뢰할 수 있는 네트워크와 서버에서만 사용하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sambungan kekal disulitkan, tetapi identitinya tidak disahkan. Lakukan ini hanya pada rangkaian dan server yang anda percayai."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenie pozostaje zaszyfrowane, ale jego tożsamość nie jest weryfikowana. Rób tak tylko w zaufanej sieci i na zaufanym serwerze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão continua criptografada, mas a identidade não é verificada. Faça isso só em uma rede e um servidor de confiança."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conexiunea rămâne criptată, dar identitatea nu este verificată. Fă asta doar într-o rețea și pe un server în care ai încredere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединение остаётся зашифрованным, но его подлинность не проверяется. Делайте это только в сети и на сервере, которым доверяете."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเชื่อมต่อยังคงเข้ารหัสอยู่ แต่ตัวตนไม่ได้รับการยืนยัน ทำเช่นนี้เฉพาะบนเครือข่ายและเซิร์ฟเวอร์ที่คุณไว้ใจ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı şifreli kalır ama kimliği doğrulanmaz. Bunu yalnızca güvendiğiniz bir ağ ve sunucuda yapın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接仍然加密，但服务器身份未经验证。请仅在你信任的网络和服务器上启用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線仍會加密，但不會驗證身分。請只在你信任的網路與伺服器上這樣做。"
          }
        }
      }
    },
