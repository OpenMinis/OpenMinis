    "Voice synthesis failed — some content may not be read aloud." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprachsynthese fehlgeschlagen – einige Inhalte werden möglicherweise nicht vorgelesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice synthesis failed — some content may not be read aloud."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falló la síntesis de voz: es posible que parte del contenido no se lea en voz alta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabigo ang voice synthesis — maaaring hindi mabasa nang malakas ang ilang nilalaman."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la synthèse vocale — une partie du contenu pourrait ne pas être lue à voix haute."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinteza govora nije uspjela — dio sadržaja možda neće biti pročitan naglas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sintesis suara gagal — sebagian konten mungkin tidak dibacakan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声合成に失敗しました — 一部のコンテンツが読み上げられない場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 합성 실패 — 일부 콘텐츠가 소리 내어 읽히지 않을 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sintesis suara gagal — sebahagian kandungan mungkin tidak dibaca."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synteza mowy nie powiodła się — część treści może nie zostać odczytana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A síntese de voz falhou — parte do conteúdo pode não ser lida em voz alta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinteza vocală a eșuat — o parte din conținut poate să nu fie citită."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синтез речи не удался — часть содержимого может не быть прочитана вслух."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสังเคราะห์เสียงล้มเหลว — เนื้อหาบางส่วนอาจไม่ถูกอ่านออกเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses sentezi başarısız — bazı içerikler sesli okunmayabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音合成失败 — 部分内容可能不会被朗读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "語音合成失敗 — 部分內容可能不會被朗讀。"
          }
        }
      }
    },
    "Volume" : {
      "localizations" : {
