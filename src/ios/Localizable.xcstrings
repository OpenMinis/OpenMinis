    "Passwords are stored in the iOS Keychain on this device only — never in the backup file." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwörter werden nur im iOS-Schlüsselbund dieses Geräts gespeichert — niemals in der Sicherungsdatei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passwords are stored in the iOS Keychain on this device only — never in the backup file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las contraseñas se guardan en el Llavero de iOS solo en este dispositivo, nunca en el archivo de copia de seguridad."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakaimbak ang mga password sa iOS Keychain sa device na ito lamang — hindi kailanman sa backup file."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mots de passe sont stockés dans le trousseau iOS de cet appareil uniquement — jamais dans le fichier de sauvegarde."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lozinke se spremaju u iOS Keychain samo na ovom uređaju — nikada u datoteku sigurnosne kopije."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata sandi disimpan di Keychain iOS pada perangkat ini saja — tidak pernah di file cadangan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードはこのデバイスの iOS キーチェーンにのみ保存され、バックアップファイルには含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호는 이 기기의 iOS 키체인에만 저장되며, 백업 파일에는 포함되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata laluan disimpan dalam Keychain iOS pada peranti ini sahaja — tidak pernah dalam file sandaran."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasła są przechowywane wyłącznie w Pęku kluczy iOS na tym urządzeniu — nigdy w pliku kopii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As senhas ficam no Keychain do iOS apenas neste dispositivo — nunca no arquivo de backup."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolele sunt stocate în Keychain-ul iOS doar pe acest dispozitiv — niciodată în fișierul de rezervă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пароли хранятся в связке ключей iOS только на этом устройстве — никогда в файле копии."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รหัสผ่านถูกจัดเก็บใน iOS Keychain บนอุปกรณ์นี้เท่านั้น — ไม่เคยอยู่ในไฟล์ข้อมูลสำรอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parolalar yalnızca bu aygıttaki iOS Anahtar Zinciri'nde saklanır — asla yedek dosyasında değil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密码仅存储在本机的 iOS 钥匙串中——绝不会写入备份文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密碼只會儲存在這台裝置的 iOS 鑰匙圈中，絕不會寫入備份檔案。"
          }
        }
      }
    },
