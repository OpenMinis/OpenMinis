    "Messages above this point will be compacted into a summary. This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachrichten oberhalb dieser Stelle werden zu einer Zusammenfassung komprimiert. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messages above this point will be compacted into a summary. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes anteriores a este punto se compactarán en un resumen. Esta acción no se puede deshacer."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iko-compact sa buod ang mga mensahe sa itaas nito. Hindi na ito maibabalik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages au-dessus de ce point seront compactés en un résumé. Cette action est irréversible."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poruke iznad ove točke sažet će se u kratki pregled. To se ne može poništiti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesan di atas titik ini akan diringkas menjadi rangkuman. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここより上のメッセージは要約に圧縮されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 지점 위의 메시지가 요약으로 압축됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesej di atas titik ini akan dipadatkan menjadi ringkasan. Ini tidak boleh dibatalkan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiadomości powyżej tego miejsca zostaną skompresowane do podsumowania. Nie można tego cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens acima deste ponto serão compactadas em um resumo. Isso não pode ser desfeito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesajele de deasupra acestui punct vor fi comprimate într-un rezumat. Acțiunea nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщения выше этой точки будут свёрнуты в сводку. Это действие нельзя отменить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความเหนือจุดนี้จะถูกบีบอัดเป็นบทสรุป การกระทำนี้ย้อนกลับไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu noktanın üzerindeki mesajlar bir özete sıkıştırılacak. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此处之前的消息将被压缩为摘要。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此處之前的訊息將被壓縮為摘要。此操作無法復原。"
          }
        }
      }
    },
    "Microphone access denied — enable it in Settings" : {
      "comment" : "Inline voice permission denied\nVoice input: microphone permission denied",
      "localizations" : {
        "de" : {
