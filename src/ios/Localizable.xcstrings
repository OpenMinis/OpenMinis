    },
    "The summary will be discarded and the messages it covered will become active again. This may push the conversation past the model's context window — if that happens, long-press a message to re-compact from that point." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Zusammenfassung wird verworfen und die davon abgedeckten Nachrichten werden wieder aktiv. Dadurch kann die Unterhaltung das Kontextfenster des Modells überschreiten – tippe in diesem Fall lange auf eine Nachricht, um ab diesem Punkt erneut zu komprimieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The summary will be discarded and the messages it covered will become active again. This may push the conversation past the model's context window — if that happens, long-press a message to re-compact from that point."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El resumen se descartará y los mensajes que cubría volverán a estar activos. Esto puede hacer que la conversación supere la ventana de contexto del modelo: si ocurre, mantén pulsado un mensaje para volver a compactar desde ese punto."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itatapon ang buod at magiging aktibo ulit ang mga mensaheng saklaw nito. Maaari nitong itulak ang usapan lampas sa context window ng model — kung mangyari iyon, pindutin nang matagal ang mensahe para i-compact ulit mula doon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le résumé sera supprimé et les messages qu’il couvrait redeviendront actifs. Cela peut faire dépasser à la conversation la fenêtre de contexte du modèle — si cela arrive, appuie longuement sur un message pour recompacter à partir de ce point."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sažetak će biti odbačen, a poruke koje je obuhvaćao ponovno će postati aktivne. To može razgovor gurnuti preko kontekstnog prozora modela — ako se to dogodi, dugo pritisnite poruku kako biste ponovno saželi od te točke."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rangkuman akan dibuang dan pesan yang dicakupnya akan aktif kembali. Ini dapat mendorong percakapan melampaui jendela konteks model — jika itu terjadi, tekan lama sebuah pesan untuk meringkas ulang dari titik tersebut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要約は破棄され、それが対象としていたメッセージが再びアクティブになります。これにより会話がモデルのコンテキストウィンドウを超える可能性があります — その場合は、メッセージを長押ししてその時点から再圧縮してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요약이 삭제되고 요약이 포함했던 메시지가 다시 활성화됩니다. 이로 인해 대화가 모델의 컨텍스트 창을 초과할 수 있습니다 — 그럴 경우 메시지를 길게 눌러 그 지점부터 다시 압축하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringkasan akan dibuang dan mesej yang dirangkuminya akan aktif semula. Ini mungkin menolak perbualan melepasi tetingkap konteks model — jika itu berlaku, tekan lama sesuatu mesej untuk memadatkan semula dari titik tersebut."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podsumowanie zostanie odrzucone, a objęte nim wiadomości znów staną się aktywne. Może to przekroczyć okno kontekstu modelu — jeśli tak się stanie, przytrzymaj wiadomość, aby skompresować ponownie od tego miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O resumo será descartado e as mensagens que ele cobria voltarão a ficar ativas. Isso pode levar a conversa além da janela de contexto do modelo — se acontecer, toque e segure uma mensagem para compactar de novo a partir dali."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rezumatul va fi eliminat, iar mesajele acoperite de el vor redeveni active. Asta poate împinge conversația peste fereastra de context a modelului — dacă se întâmplă, apasă lung pe un mesaj pentru a comprima din nou de acolo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сводка будет удалена, а охваченные ею сообщения снова станут активными. Из-за этого разговор может выйти за пределы контекстного окна модели — если так произойдёт, нажмите и удерживайте сообщение, чтобы пересжать с этого места."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บทสรุปจะถูกทิ้งและข้อความที่บทสรุปครอบคลุมจะกลับมาใช้งานอีกครั้ง อาจทำให้การสนทนาเกินหน้าต่างบริบทของโมเดล — หากเกิดขึ้น ให้กดข้อความค้างไว้เพื่อบีบอัดใหม่จากจุดนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özet atılacak ve kapsadığı mesajlar yeniden etkin olacak. Bu, sohbeti modelin bağlam penceresinin ötesine taşıyabilir — böyle olursa o noktadan yeniden sıkıştırmak için bir mesaja basılı tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摘要将被丢弃，被其涵盖的消息将重新变为活动状态。这可能使对话超出模型的上下文窗口 — 若发生这种情况，请长按某条消息以从该处重新压缩。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "摘要將被捨棄，被其涵蓋的訊息將重新變為活動狀態。這可能使對話超出模型的上下文視窗 — 若發生這種情況，請長按某則訊息以從該處重新壓縮。"
          }
        }
      }
    },
    "The terminal engine isn't running yet. Open a chat or the terminal once, then retry." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Terminal-Engine läuft noch nicht. Öffne einmal einen Chat oder das Terminal und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El motor del terminal aún no está en ejecución. Abre un chat o el terminal una vez y vuelve a intentarlo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi pa tumatakbo ang terminal engine. Magbukas muna ng chat o terminal, tapos subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moteur du terminal n'est pas encore lancé. Ouvrez une fois une conversation ou le terminal, puis réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehanizam terminala još nije pokrenut. Jednom otvorite razgovor ili terminal, a zatim pokušajte ponovno."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesin terminal belum berjalan. Buka obrolan atau terminal sekali, lalu coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナルのエンジンがまだ起動していません。チャットかターミナルを一度開いてから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널 엔진이 아직 실행되지 않았습니다. 채팅이나 터미널을 한 번 연 다음 다시 시도하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enjin terminal belum berjalan. Buka sembang atau terminal sekali, kemudian cuba lagi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silnik terminala jeszcze nie działa. Otwórz raz czat lub terminal, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O motor do terminal ainda não está rodando. Abra um chat ou o terminal uma vez e tente de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motorul terminalului încă nu rulează. Deschide o dată un chat sau terminalul, apoi reîncearcă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Движок терминала ещё не запущен. Откройте один раз чат или терминал и повторите."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอนจินเทอร์มินัลยังไม่ทำงาน เปิดแชทหรือเทอร์มินัลสักครั้ง แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal motoru henüz çalışmıyor. Bir sohbeti ya da terminali bir kez açıp yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "终端引擎尚未启动。请先打开一次聊天或终端，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終端機引擎尚未啟動。請先開啟一次聊天或終端機，然後重試。"
          }
        }
      }
    },
