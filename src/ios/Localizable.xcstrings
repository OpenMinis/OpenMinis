    "Advanced: write a value at a dotted field path. Not validated by Minis." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced: write a value at a dotted field path. Not validated by Minis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanzado: escribe un valor en una ruta de campo con puntos. Minis no lo valida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高级：向指定的点分字段路径写入值。Minis 不会校验其正确性。"
          }
        }
      }
    },
    "After leaving an unlocked session, the lock re-engages once the idle window elapses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Verlassen einer entsperrten Sitzung wird die Sperre nach Ablauf des Inaktivitätsfensters wieder aktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After leaving an unlocked session, the lock re-engages once the idle window elapses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al salir de una sesión desbloqueada, el bloqueo se reactiva cuando transcurre el periodo de inactividad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir quitté une session déverrouillée, le verrouillage se réactive une fois la période d'inactivité écoulée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック解除したセッションを離れた後、アイドル時間が経過するとロックが再度かかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 해제된 세션을 떠난 후 유휴 시간이 지나면 잠금이 다시 걸립니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После выхода из разблокированной сессии блокировка снова сработает по истечении времени простоя."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开已解锁的会话后，空闲时间到达即重新锁定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開已解鎖的會話後，閒置時間到達即重新鎖定。"
          }
        }
      }
    },
    "After leaving an unlocked session, the lock re-engages once the idle window elapses. Going to the home screen or app switcher always re-locks the current session immediately." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After leaving an unlocked session, the lock re-engages once the idle window elapses. Going to the home screen or app switcher always re-locks the current session immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al salir de una sesión desbloqueada, el bloqueo se reactiva cuando transcurre el periodo de inactividad. Ir a la pantalla de inicio o al selector de apps siempre vuelve a bloquear la sesión actual de inmediato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开已解锁的会话后，超过空闲时长会重新锁定。回到主屏或切换应用时会立即重新锁定当前会话。"
          }
        }
      }
    },
