    "Stopped — the next backup picks up from here." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestoppt — die nächste Sicherung setzt hier an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopped — the next backup picks up from here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenido: la próxima copia de seguridad continuará desde aquí."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huminto — magpapatuloy dito ang susunod na backup."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêté — la prochaine sauvegarde repartira d'ici."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaustavljeno — sljedeća sigurnosna kopija nastavlja odavde."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihentikan — pencadangan berikutnya lanjut dari sini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止しました。次回のバックアップはここから再開します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중지했습니다. 다음 백업은 여기서부터 재개합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihentikan — sandaran seterusnya bersambung dari sini."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatrzymano — następna kopia ruszy od tego miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompido — o próximo backup continua daqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprit — următoarea copie continuă de aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановлено — следующая копия продолжит отсюда."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยุดแล้ว — การสำรองข้อมูลครั้งถัดไปจะเริ่มจากจุดนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durduruldu — sonraki yedekleme buradan sürer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已停止 — 下次备份将从此处继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已停止，下次備份會從這裡繼續。"
          }
        }
      }
    },
    "Stopping keeps what has been backed up so far, and the next backup resumes from there. Stop and Delete throws that away." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Stoppen bleibt das bisher Gesicherte erhalten und die nächste Sicherung setzt dort an. „Stoppen und löschen“ verwirft das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopping keeps what has been backed up so far, and the next backup resumes from there. Stop and Delete throws that away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al detener se conserva lo que ya se ha respaldado y la próxima copia continúa desde ahí. Detener y eliminar descarta ese progreso."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mananatili ang na-backup na kapag huminto, at doon magpapatuloy ang susunod na backup. Itatapon ito ng Ihinto at Tanggalin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'arrêt conserve ce qui a déjà été sauvegardé, et la prochaine sauvegarde repart de là. « Arrêter et supprimer » abandonne tout cela."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaustavljanje zadržava sve što je dosad kopirano, a sljedeća sigurnosna kopija nastavlja od te točke. Zaustavi i obriši sve to odbacuje."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghentikan akan mempertahankan yang sudah tercadangkan, dan pencadangan berikutnya lanjut dari sana. Hentikan dan Hapus akan membuangnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止しても、これまでの内容は保持され、次回のバックアップはそこから再開します。「停止して削除」を選ぶと、その内容は破棄されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중지해도 지금까지 백업한 내용은 유지되며, 다음 백업은 그 지점부터 재개합니다. '중지하고 삭제'를 선택하면 해당 내용은 폐기됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghentikan akan mengekalkan apa yang telah disandarkan, dan sandaran seterusnya bersambung dari sana. Henti dan Padam akan membuangnya."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatrzymanie zachowuje to, co już zapisano, a następna kopia ruszy od tego miejsca. Zatrzymaj i usuń odrzuca te dane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parar mantém o que já foi salvo, e o próximo backup continua daí. Parar e excluir descarta tudo isso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oprirea păstrează ce s-a salvat până acum, iar următoarea copie continuă de acolo. Oprește și șterge renunță la tot."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При остановке сохранённое до сих пор остаётся, и следующая копия продолжит оттуда. «Остановить и удалить» отменяет всё это."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การหยุดจะเก็บสิ่งที่สำรองไว้แล้ว และการสำรองข้อมูลครั้งถัดไปจะเริ่มจากจุดนั้น ส่วนหยุดและลบจะทิ้งข้อมูลนั้นไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durdurmak, şimdiye kadar yedeklenenleri korur ve sonraki yedekleme oradan sürer. Durdur ve Sil ise bunları atar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止会保留已备份的部分，下次备份从该处继续。停止并删除会丢弃这些内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止後目前已備份的內容會保留，下次備份會從該處繼續。「停止並刪除」則會捨棄這些內容。"
          }
        }
      }
    },
