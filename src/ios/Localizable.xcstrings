    "No other devices found yet. Devices appear here after they enable iCloud Sync." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bisher keine anderen Geräte gefunden. Geräte erscheinen hier, nachdem sie die iCloud-Synchronisierung aktiviert haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No other devices found yet. Devices appear here after they enable iCloud Sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se encontraron otros dispositivos. Los dispositivos aparecen aquí después de activar la sincronización con iCloud."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wala pang ibang device na nakita. Lalabas dito ang mga device pagkatapos nilang i-enable ang iCloud Sync."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun autre appareil trouvé pour l'instant. Les appareils apparaissent ici après avoir activé la synchronisation iCloud."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Još nisu pronađeni drugi uređaji. Uređaji se ovdje pojavljuju nakon što omoguće iCloud sinkronizaciju."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada perangkat lain ditemukan. Perangkat muncul di sini setelah mengaktifkan Sinkronisasi iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のデバイスはまだ見つかりません。iCloud 同期を有効にしたデバイスがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 다른 기기를 찾을 수 없습니다. iCloud 동기화를 활성화한 기기가 여기에 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belum ada peranti lain dijumpai. Peranti muncul di sini selepas mengaktifkan Penyegerakan iCloud."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleziono jeszcze innych urządzeń. Pojawią się tutaj po włączeniu synchronizacji iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum outro dispositivo encontrado ainda. Os dispositivos aparecem aqui depois que ativam a sincronização do iCloud."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încă niciun alt dispozitiv găsit. Dispozitivele apar aici după ce activează sincronizarea iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Другие устройства пока не найдены. Устройства появятся здесь после включения синхронизации iCloud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่พบอุปกรณ์อื่น อุปกรณ์จะแสดงที่นี่หลังจากเปิดใช้งานการซิงค์ iCloud"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Henüz başka aygıt bulunamadı. Aygıtlar, iCloud Eşitleme'yi etkinleştirdikten sonra burada görünür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未发现其他设备。设备启用 iCloud 同步后会显示在此处。"
          }
