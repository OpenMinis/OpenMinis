        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linux 環境已被重設。請重新啟動應用程式以重新安裝後再使用終端機。"
          }
        }
      }
    },
    "The model declined to respond to this request. Try rephrasing, or switch to a different model." : {
      "localizations" : {
