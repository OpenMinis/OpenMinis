        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위 경로는 iOS가 선택한 폴더를 노출하는 방식입니다. 이 데이터가 어느 앱에 속하는지 확인할 때 사용하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Путь выше — это то, как iOS отображает выбранную вами папку. Используйте его, чтобы убедиться, какому приложению принадлежат эти данные."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
