    "Show a live preview thumbnail alongside the tool status bar during agent execution." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt während der Agent-Ausführung eine Live-Vorschau-Miniatur neben der Werkzeug-Statusleiste an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a live preview thumbnail alongside the tool status bar during Agent execution."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una miniatura de vista previa en vivo junto a la barra de estado de herramientas mientras se ejecuta Minis Agent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche une vignette d'aperçu en direct à côté de la barre d'état de l'outil pendant l'exécution de Minis Agent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 実行中、ツールステータスバーの横にライブプレビューサムネイルを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 실행 중 도구 상태 표시줄 옆에 실시간 미리보기 썸네일을 표시합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать миниатюру предпросмотра в реальном времени рядом со строкой состояния инструментов во время выполнения Agent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Agent 执行期间，于工具状态栏旁显示实时预览缩略图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Agent 執行期間，於工具狀態欄旁顯示實時預覽縮略圖。"
          }
        }
      }
    },
    "Show a sticky title pill at the top of the chat once you scroll up to read history." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt oben im Chat eine angeheftete Titelpille an, sobald du nach oben scrollst, um den Verlauf zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a sticky title pill at the top of the chat once you scroll up to read history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una etiqueta de título fija en la parte superior del chat cuando te desplazas hacia arriba para leer el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche une pastille de titre épinglée en haut de la discussion lorsque vous remontez pour lire l'historique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴を読むために上にスクロールすると、チャット上部に固定タイトルピルを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록을 보기 위해 위로 스크롤하면 채팅 상단에 고정된 제목 알약을 표시합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать закреплённую плашку с заголовком вверху чата при прокрутке вверх для чтения истории."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上滚动查看历史时，在对话顶部显示一个吸顶的标题胶囊。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上捲動查看歷史時，在對話頂端顯示一個吸頂的標題膠囊。"
          }
        }
      }
    },
    "Show agent task progress on the Lock Screen and in the Dynamic Island. Turning this off also removes the currently displayed Live Activity." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Fortschritt von Agentenaufgaben auf dem Sperrbildschirm und in der Dynamic Island an. Beim Ausschalten wird die aktuell angezeigte Live-Aktivität ebenfalls entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show Agent task progress on the Lock Screen and in the Dynamic Island. Turning this off also removes the currently displayed Live Activity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el progreso de las tareas de Minis Agent en la pantalla bloqueada y en la Dynamic Island. Al desactivarlo también se elimina la Live Activity que se muestra actualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la progression des tâches de Minis Agent sur l'écran verrouillé et dans la Dynamic Island. La désactivation supprime aussi l'activité en direct actuellement affichée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面と Dynamic Island に Agent タスクの進行状況を表示します。オフにすると、表示中のライブアクティビティも削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면과 Dynamic Island에 Agent 작업 진행 상황을 표시합니다. 끄면 현재 표시 중인 라이브 활동도 제거됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать ход выполнения задач Minis Agent на экране блокировки и в Dynamic Island. При отключении текущая Live Activity также будет удалена."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在锁定屏幕和灵动岛上显示 Agent 任务进度。关闭后会同时移除当前正在显示的实时活动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在鎖定畫面和動態島上顯示智慧 Agent 任務進度。關閉後也會移除目前顯示的即時動態。"
          }
        }
      }
    },
    "Show agent task progress on the Lock Screen and in the Dynamic Island. Turning this off also removes the currently displayed Live Activity. Tip: enable Location Tracking below so the Live Activity keeps refreshing while the app stays in the background — without it, updates pause about 30 seconds after you leave the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt den Fortschritt von Agent-Aufgaben auf dem Sperrbildschirm und in der Dynamic Island. Wenn du dies deaktivierst, wird die aktuell angezeigte Live-Aktivität entfernt. Tipp: Aktiviere unten „Standortverfolgung“, damit die Live-Aktivität weiter aktualisiert wird, während die App im Hintergrund bleibt – ohne sie pausieren Aktualisierungen etwa 30 Sekunden nach dem Verlassen der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show Agent task progress on the Lock Screen and in the Dynamic Island. Turning this off also removes the currently displayed Live Activity. Tip: enable Location Tracking below so the Live Activity keeps refreshing while the app stays in the background — without it, updates pause about 30 seconds after you leave the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra el progreso de las tareas de Minis Agent en la pantalla bloqueada y en la Dynamic Island. Al desactivarlo también se elimina la Live Activity que se muestra actualmente. Consejo: activa el seguimiento de ubicación más abajo para que la Live Activity siga actualizándose mientras la app está en segundo plano; sin esto, las actualizaciones se detienen unos 30 segundos después de que salgas de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la progression des tâches de l’Agent sur l’écran verrouillé et dans la Dynamic Island. La désactivation supprime aussi l’activité en direct affichée. Astuce : activez le suivi de localisation ci-dessous pour que l’activité en direct continue de s’actualiser lorsque l’app reste en arrière-plan — sans cela, les mises à jour s’interrompent environ 30 secondes après avoir quitté l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面とDynamic Islandに Agent のタスク進行状況を表示します。オフにすると、現在表示中のライブアクティビティも削除されます。ヒント：下の「位置情報の追跡」をオンにすると、アプリがバックグラウンドにある間もライブアクティビティが更新され続けます。オフの場合、アプリを離れてから約30秒で更新が停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면과 다이나믹 아일랜드에 Agent 작업 진행 상황을 표시합니다. 이 기능을 끄면 현재 표시된 실시간 활동도 사라집니다. 팁: 아래에서 위치 추적을 켜면 앱이 백그라운드에 있는 동안에도 실시간 활동이 계속 갱신됩니다. 켜지 않으면 앱을 벗어난 후 약 30초 뒤에 업데이트가 중단됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает прогресс задач Minis Agent на заблокированном экране и в Dynamic Island. При отключении текущая Live Activity также будет удалена. Совет: включите «Отслеживание местоположения» ниже, чтобы Live Activity продолжала обновляться, пока приложение остаётся в фоне — без этого обновления приостанавливаются примерно через 30 секунд после выхода из приложения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在锁定屏幕和灵动岛上显示 Agent 任务进度。关闭后也会移除当前显示的实时活动。提示：开启下方的“位置追踪”可让实时活动在应用位于后台时持续刷新；未开启时，离开应用约 30 秒后更新会暂停。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在鎖定畫面和動態島上顯示智能體任務進度。關閉後也會移除目前顯示的即時動態。提示：開啟下方的「位置追蹤」可讓即時動態在應用程式位於背景時持續更新；未開啟時，離開應用程式約 30 秒後更新會暫停。"
          }
        }
      }
    },
