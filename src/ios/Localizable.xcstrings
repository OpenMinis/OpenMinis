    "Leave Context Window empty to use auto-detected value. Leave Max Output Tokens empty to follow the provider default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasse das Kontextfenster leer, um den automatisch erkannten Wert zu verwenden. Lasse „Max. Ausgabe-Tokens“ leer, um den Anbieter-Standard zu übernehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave Context Window empty to use auto-detected value. Leave Max Output Tokens empty to follow the provider default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja la ventana de contexto vacía para usar el valor detectado automáticamente. Deja el máximo de tokens de salida vacío para seguir el valor predeterminado del proveedor."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iwanang blangko ang Context Window para gamitin ang awtomatikong natukoy na halaga. Iwanang blangko ang Max na Output Tokens para sundin ang default ng provider."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse la fenêtre de contexte vide pour utiliser la valeur détectée automatiquement. Laisse Jetons de sortie max. vide pour suivre la valeur par défaut du fournisseur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostavite prozor konteksta praznim za automatski prepoznatu vrijednost. Ostavite maksimalan broj izlaznih tokena praznim da biste slijedili zadanu vrijednost pružatelja usluge."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosongkan Jendela Konteks untuk memakai nilai yang terdeteksi otomatis. Kosongkan Token Keluaran Maks untuk mengikuti bawaan penyedia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテキストウィンドウを空欄にすると自動検出値を使用します。最大出力トークンを空欄にするとプロバイダーのデフォルトに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨텍스트 창을 비워 두면 자동 감지된 값을 사용합니다. 최대 출력 토큰을 비워 두면 제공자 기본값을 따릅니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan Tetingkap Konteks kosong untuk menggunakan nilai yang dikesan automatik. Biarkan Token Output Maks kosong untuk mengikut lalai pembekal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostaw okno kontekstu puste, aby użyć wartości wykrytej automatycznie. Pozostaw limit tokenów wyjściowych pusty, aby użyć ustawienia dostawcy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe Janela de contexto vazia para usar o valor detectado automaticamente. Deixe Tokens máximos de saída vazio para seguir o padrão do provedor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasă gol Fereastra de context pentru valoarea detectată automat. Lasă gol Tokenuri maxime de ieșire pentru valoarea implicită a furnizorului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте окно контекста пустым, чтобы использовать автоопределённое значение. Оставьте «Макс. выходных токенов» пустым, чтобы следовать значению провайдера по умолчанию."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เว้นหน้าต่างบริบทว่างไว้เพื่อใช้ค่าที่ตรวจพบอัตโนมัติ เว้นโทเคนเอาต์พุตสูงสุดว่างไว้เพื่อใช้ค่าเริ่มต้นของผู้ให้บริการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik algılanan değeri kullanmak için Bağlam Penceresi'ni boş bırakın. Sağlayıcı varsayılanı için Maks Çıkış Token'ını boş bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将上下文窗口留空以使用自动检测的值。将最大输出 Token 留空以采用服务商默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將上下文視窗留空以使用自動偵測的值。將最大輸出 Token 留空以採用服務商預設值。"
          }
        }
      }
    },
