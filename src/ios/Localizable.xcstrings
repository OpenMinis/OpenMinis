    "Mount name must not be empty, contain '/', or be '.' or '..'." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mount-Name darf nicht leer sein, kein '/' enthalten und nicht '.' oder '..' sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mount name must not be empty, contain '/', or be '.' or '..'."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre del montaje no puede estar vacío, contener '/', ni ser '.' o '..'."
          }
        },
        "fil" : {
