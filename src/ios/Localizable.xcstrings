    "•" : {

    },
    "• Reset: Delete everything\n• Backup: Save /root directory\n• Restore: Recover saved data" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Zurücksetzen: Alles löschen\n• Sicherung: /root-Verzeichnis speichern\n• Wiederherstellen: Gespeicherte Daten wiederherstellen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Reset: Delete everything\n• Backup: Save /root directory\n• Restore: Recover saved data"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Restablecer: eliminar todo\n• Copia de seguridad: guardar el directorio /root\n• Restaurar: recuperar los datos guardados"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• I-reset: Tanggalin lahat\n• Backup: I-save ang /root directory\n• I-restore: Bawiin ang na-save na datos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Réinitialiser : Tout supprimer\n• Sauvegarde : Enregistrer le répertoire /root\n• Restaurer : Récupérer les données sauvegardées"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Poništi: obriši sve\n• Sigurnosna kopija: spremi direktorij /root\n• Vrati: obnovi spremljene podatke"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Setel ulang: Hapus semuanya\n• Cadangkan: Simpan direktori /root\n• Pulihkan: Ambil kembali data tersimpan"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• リセット：すべてを削除\n• バックアップ：/root ディレクトリを保存\n• 復元：保存したデータを復元"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 재설정: 모든 항목 삭제\n• 백업: /root 디렉토리 저장\n• 복원: 저장된 데이터 복구"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Tetap semula: Padam semuanya\n• Sandarkan: Simpan direktori /root\n• Pulihkan: Dapatkan semula data disimpan"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Reset: usuń wszystko\n• Kopia: zapisz katalog /root\n• Przywróć: odzyskaj zapisane dane"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Redefinir: excluir tudo\n• Backup: salvar o diretório /root\n• Restaurar: recuperar os dados salvos"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Resetare: șterge tot\n• Copie: salvează directorul /root\n• Restaurare: recuperează datele salvate"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Сброс: удалить всё\n• Резервная копия: сохранить каталог /root\n• Восстановление: вернуть сохранённые данные"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• รีเซ็ต: ลบทั้งหมด\n• สำรองข้อมูล: บันทึกไดเรกทอรี /root\n• กู้คืน: เรียกคืนข้อมูลที่บันทึกไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Sıfırla: Her şeyi sil\n• Yedekle: /root dizinini kaydet\n• Geri yükle: Kaydedilen verileri kurtar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 重置：删除所有内容\n• 备份：保存 /root 目录\n• 恢复：恢复已保存的数据"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 重設：刪除所有內容\n• 備份：儲存 /root 目錄\n• 恢復：恢復已儲存的資料"
          }
        }
      }
    },
