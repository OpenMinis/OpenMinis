    "Mount limit reached (%d). Remove an existing mount before adding a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mount-Limit erreicht (%d). Entfernen Sie einen vorhandenen Mount, bevor Sie einen neuen hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mount limit reached (%d). Remove an existing mount before adding a new one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se alcanzó el límite de montajes (%d). Elimina un montaje existente antes de añadir uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
