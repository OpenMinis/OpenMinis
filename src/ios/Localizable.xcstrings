    "Open-ended work that needs its own tool loop: exploring a codebase or the web over many rounds, digesting bulk output into a conclusion, or running independent branches in parallel." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open-ended work that needs its own tool loop: exploring a codebase or the web over many rounds, digesting bulk output into a conclusion, or running independent branches in parallel."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvoreni poslovi koji trebaju vlastitu petlju alata: istraživanje baze koda ili weba kroz više krugova, sažimanje velike količine izlaza u zaključak ili usporedno izvođenje neovisnih grana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "独自のツールループを要する自由度の高い作業: コードベースやウェブを何度も探索する、大量の出力を結論にまとめる、独立した分岐を並行して進める。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要自己跑工具循环的开放性工作：多轮探索代码库或网页、把大量输出消化成结论、或并行处理互相独立的分支。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要自己跑工具循環的開放性工作：多輪探索程式庫或網頁、把大量輸出消化成結論、或並行處理互相獨立的分支。"
          }
        }
      }
    },
