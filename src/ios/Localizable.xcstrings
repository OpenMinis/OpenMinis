    "Re-runs the AI agent from a specific user message in a session. Presents a list of user messages to choose from, then retries from that point." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt den Minis Agent ab einer bestimmten Benutzernachricht in einer Sitzung erneut aus. Zeigt eine Liste von Benutzernachrichten zur Auswahl und wiederholt ab diesem Punkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-runs the Minis Agent from a specific user message in a session. Presents a list of user messages to choose from, then retries from that point."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a ejecutar Minis Agent desde un mensaje concreto del usuario en una sesión. Muestra una lista de mensajes del usuario para elegir y reintenta desde ese punto."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapatakbo ulit ang AI agent mula sa partikular na mensahe ng user sa session. Magpapakita ng listahan ng mensahe na mapagpipilian, tapos magsisimula ulit doon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relance Minis Agent à partir d'un message utilisateur spécifique dans une session. Présente une liste de messages utilisateur à choisir, puis retente à partir de ce point."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponovno pokreće Minis Agenta od određene korisničke poruke u sesiji. Prikazuje popis korisničkih poruka za odabir, a zatim ponavlja od te točke."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjalankan ulang agen AI dari pesan pengguna tertentu dalam sesi. Menampilkan daftar pesan pengguna untuk dipilih, lalu mencoba ulang dari titik itu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッション内の特定のユーザーメッセージから Minis Agent を再実行します。ユーザーメッセージのリストから選択し、その時点から再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션의 특정 사용자 메시지에서 Minis Agent를 다시 실행합니다. 선택할 사용자 메시지 목록을 표시한 다음 해당 시점부터 다시 시도합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjalankan semula ejen AI dari mesej pengguna tertentu dalam sesi. Memaparkan senarai mesej pengguna untuk dipilih, kemudian mencuba semula dari titik itu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamia agenta AI ponownie od wybranej wiadomości użytkownika w sesji. Pokazuje listę wiadomości do wyboru, a potem ponawia od tego miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa o agente de IA de novo a partir de uma mensagem específica do usuário numa sessão. Mostra uma lista de mensagens para escolher e repete a partir daquele ponto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rulează din nou agentul AI de la un anumit mesaj al utilizatorului dintr-o sesiune. Afișează o listă de mesaje din care poți alege, apoi reia din acel punct."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перезапускает AI-Minis Agent с определённого сообщения пользователя в сессии. Показывает список сообщений пользователя на выбор, а затем повторяет с этого момента."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรียกใช้เอเจนต์ AI ใหม่จากข้อความของผู้ใช้ที่ระบุในเซสชัน จะแสดงรายการข้อความให้เลือก แล้วลองใหม่จากจุดนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ aracısını bir oturumdaki belirli bir kullanıcı mesajından yeniden çalıştırır. Seçmeniz için kullanıcı mesajlarını listeler, sonra o noktadan yeniden dener."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从会话中的特定用户消息重新运行 Minis Agent。展示用户消息列表供选择，然后从该点重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從工作階段中的特定使用者訊息重新運行 Minis Agent。展示使用者訊息清單供選擇，然後從該點重試。"
          }
        }
      }
    },
