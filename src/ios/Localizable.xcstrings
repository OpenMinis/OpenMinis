    "Request too large (about %1$d MB, limit %2$d MB). Start a new conversation or remove large images/attachments, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfrage zu groß (etwa %1$d MB, Limit %2$d MB). Starte eine neue Unterhaltung oder entferne große Bilder/Anhänge und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Request too large (about %1$d MB, limit %2$d MB). Start a new conversation or remove large images/attachments, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitud demasiado grande (unos %1$d MB, límite %2$d MB). Inicia una conversación nueva o quita imágenes o adjuntos grandes y vuelve a intentarlo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masyadong malaki ang request (mga %1$d MB, limitasyon %2$d MB). Magsimula ng bagong usapan o mag-alis ng malalaking larawan/attachment, tapos subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requête trop volumineuse (environ %1$d Mo, limite %2$d Mo). Démarrez une nouvelle conversation ou retirez les images/pièces jointes volumineuses, puis réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahtjev je prevelik (približno %1$d MB, ograničenje %2$d MB). Započnite novi razgovor ili uklonite velike slike/privitke, zatim pokušajte ponovno."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan terlalu besar (sekitar %1$d MB, batas %2$d MB). Mulai percakapan baru atau hapus gambar/lampiran besar, lalu coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストが大きすぎます（約 %1$d MB、上限 %2$d MB）。新しい会話を開始するか、大きな画像や添付ファイルを削除してから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청이 너무 큽니다 (약 %1$d MB, 제한 %2$d MB). 새 대화를 시작하거나 큰 이미지·첨부 파일을 제거한 후 다시 시도하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan terlalu besar (kira-kira %1$d MB, had %2$d MB). Mulakan perbualan baharu atau buang imej/lampiran besar, kemudian cuba lagi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żądanie jest zbyt duże (około %1$d MB, limit %2$d MB). Rozpocznij nową rozmowę lub usuń duże obrazy i załączniki, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requisição grande demais (cerca de %1$d MB, limite de %2$d MB). Comece uma nova conversa ou remova imagens/anexos grandes e tente de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerere prea mare (aproximativ %1$d MB, limita %2$d MB). Începe o conversație nouă sau elimină imaginile/atașamentele mari, apoi încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос слишком большой (около %1$d МБ, лимит %2$d МБ). Начните новый диалог или удалите крупные изображения и вложения, затем повторите."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำขอใหญ่เกินไป (ประมาณ %1$d MB ขีดจำกัด %2$d MB) เริ่มการสนทนาใหม่หรือนำรูปภาพ/ไฟล์แนบขนาดใหญ่ออก แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstek çok büyük (yaklaşık %1$d MB, sınır %2$d MB). Yeni bir sohbet başlatın ya da büyük görselleri/ekleri kaldırıp yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求体积过大（约 %1$d MB，上限 %2$d MB）。请新建对话或移除大图片/附件后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請求體積過大（約 %1$d MB，上限 %2$d MB）。請新建對話或移除大圖片/附件後重試。"
          }
        }
      }
