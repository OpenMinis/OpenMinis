    "This deletes every record + asset inside the zone. It cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht jeden Datensatz + jedes Asset innerhalb der Zone. Es kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes every record + asset inside the zone. It cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todos los registros y recursos de la zona. No se puede deshacer."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinatanggal nito ang bawat record + asset sa loob ng zone. Hindi na ito maibabalik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime chaque enregistrement + ressource dans la zone. C’est irréversible."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo briše svaki zapis i resurs unutar zone. Ne može se poništiti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini menghapus setiap catatan + aset di dalam zona. Tidak dapat dibatalkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、ゾーン内のすべてのレコード + アセットが削除されます。取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이렇게 하면 영역 내의 모든 레코드 + 자산이 삭제됩니다. 취소할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memadam setiap rekod + aset di dalam zon. Ia tidak boleh dibatalkan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
