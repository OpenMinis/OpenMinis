    "Swipe a backup left to delete it. Deleted backup files cannot be recovered." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Streiche eine Sicherung nach links, um sie zu löschen. Gelöschte Sicherungsdateien können nicht wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe a backup left to delete it. Deleted backup files cannot be recovered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza una copia hacia la izquierda para eliminarla. Los archivos eliminados no se pueden recuperar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-swipe pakaliwa ang backup para tanggalin. Hindi na mababawi ang tinanggal na backup file."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balayez une sauvegarde vers la gauche pour la supprimer. Les fichiers supprimés sont irrécupérables."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite sigurnosnu kopiju ulijevo da biste je obrisali. Obrisane datoteke sigurnosnih kopija nije moguće vratiti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geser cadangan ke kiri untuk menghapusnya. File cadangan yang dihapus tidak dapat dipulihkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップを左にスワイプすると削除できます。削除したバックアップファイルは復元できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업을 왼쪽으로 쓸어넘기면 삭제됩니다. 삭제된 백업 파일은 복구할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leret sandaran ke kiri untuk memadamnya. File sandaran yang dipadam tidak boleh dipulihkan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przesuń kopię w lewo, aby ją usunąć. Usuniętych plików kopii nie można odzyskać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize um backup para a esquerda para excluí-lo. Arquivos de backup excluídos não podem ser recuperados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisează o copie spre stânga pentru a o șterge. Fișierele șterse nu pot fi recuperate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните копию влево, чтобы удалить её. Удалённые файлы копий восстановить нельзя."
