    "Minis is built on the shoulders of these open source projects. Thank you to all contributors." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis basiert auf diesen Open-Source-Projekten. Vielen Dank an alle Mitwirkenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis is built on the shoulders of these open source projects. Thank you to all contributors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis se apoya en estos proyectos de código abierto. Gracias a todas las personas que contribuyen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakabatay ang Minis sa mga open source project na ito. Salamat sa lahat ng contributor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis est construit grâce à ces projets open source. Merci à tous les contributeurs."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis je izgrađen na temeljima ovih projekata otvorenog koda. Hvala svim suradnicima."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis dibangun di atas proyek-proyek sumber terbuka berikut. Terima kasih kepada semua kontributor."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis はこれらのオープンソースプロジェクトを基盤としています。すべての貢献者に感謝します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis는 이러한 오픈 소스 프로젝트를 기반으로 합니다. 모든 기여자에게 감사드립니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis dibina di atas projek sumber terbuka berikut. Terima kasih kepada semua penyumbang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis powstał dzięki tym projektom open source. Dziękujemy wszystkim współtwórcom."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Minis é construído sobre estes projetos de código aberto. Obrigado a todos os contribuidores."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis este construit pe umerii acestor proiecte open source. Mulțumim tuturor contribuitorilor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis построен на основе этих проектов с открытым исходным кодом. Спасибо всем участникам."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis สร้างขึ้นบนพื้นฐานของโครงการโอเพนซอร์สเหล่านี้ ขอบคุณผู้มีส่วนร่วมทุกท่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis bu açık kaynak projelerin omuzlarında yükseliyor. Tüm katkıda bulunanlara teşekkürler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
