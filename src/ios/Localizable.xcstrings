    "For third-party Coding Plans (e.g. MiniMax, Kimi) or compatible proxy endpoints, enter the API base URL and bearer token manually." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie für Drittanbieter-Coding-Pläne (z. B. MiniMax, Kimi) oder kompatible Proxy-Endpoints die API-Basis-URL und das Bearer-Token manuell ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For third-party Coding Plans (e.g. MiniMax, Kimi) or compatible proxy endpoints, enter the API base URL and bearer token manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para Coding Plans de terceros (p. ej. MiniMax, Kimi) o endpoints proxy compatibles, introduce manualmente la URL base de la API y el bearer token."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para sa third-party na Coding Plan (hal. MiniMax, Kimi) o compatible na proxy endpoint, ilagay nang manual ang API base URL at bearer token."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les forfaits Coding tiers (par ex. MiniMax, Kimi) ou les points de terminaison proxy compatibles, saisissez manuellement l'URL de base de l'API et le token Bearer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za Coding Plan trećih strana (npr. MiniMax, Kimi) ili kompatibilne proxy krajnje točke ručno unesite osnovni API URL i bearer token."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk Coding Plan pihak ketiga (mis. MiniMax, Kimi) atau endpoint proksi yang kompatibel, masukkan URL basis API dan token bearer secara manual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サードパーティの Coding Plan（MiniMax、Kimi など）や互換プロキシエンドポイントの場合は、API ベース URL と Bearer トークンを手動で入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타사 Coding Plan(MiniMax, Kimi 등) 또는 호환되는 프록시 엔드포인트의 경우 API 기본 URL과 Bearer 토큰을 수동으로 입력하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk Coding Plan pihak ketiga (cth. MiniMax, Kimi) atau endpoint proksi serasi, masukkan URL asas API dan token bearer secara manual."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W przypadku planów Coding Plan innych firm (np. MiniMax, Kimi) lub zgodnych punktów końcowych proxy podaj ręcznie bazowy adres API i token Bearer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para Coding Plans de terceiros (ex.: MiniMax, Kimi) ou endpoints de proxy compatíveis, informe manualmente a URL base da API e o token Bearer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru planurile Coding Plan de la terți (ex. MiniMax, Kimi) sau pentru puncte finale proxy compatibile, introdu manual adresa API de bază și tokenul Bearer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для сторонних Coding Plans (например, MiniMax, Kimi) или совместимых прокси-эндпоинтов введите базовый API URL и bearer-токен вручную."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับ Coding Plan ภายนอก (เช่น MiniMax, Kimi) หรือเอนด์พอยต์พร็อกซีที่รองรับ ให้ป้อน API base URL และโทเคน bearer ด้วยตนเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üçüncü taraf Coding Plan'ları (örn. MiniMax, Kimi) ya da uyumlu proxy uç noktaları için API adresini ve bearer token'ı elle girin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于第三方编码计划（例如 MiniMax、Kimi）或兼容代理端点，请手动输入 API 基础 URL 和 Bearer Token。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對於第三方編碼方案（例如 MiniMax、Kimi）或相容代理端點，請手動輸入 API 基礎 URL 和 Bearer Token。"
          }
        }
      }
    },
