    "Turn off to hide this voice service. The provider's text models are unaffected." : {
      "comment" : "Shadow voice toggle note",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivieren, um diesen Sprachdienst auszublenden. Die Textmodelle des Anbieters sind nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off to hide this voice service. The provider's text models are unaffected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva esta opción para ocultar este servicio de voz. Los modelos de texto del proveedor no se ven afectados."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-off para itago ang voice service na ito. Hindi maaapektuhan ang mga text model ng provider."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactive pour masquer ce service vocal. Les modèles de texte du fournisseur ne sont pas affectés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isključite da biste sakrili ovu glasovnu uslugu. Tekstualni modeli pružatelja nisu zahvaćeni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nonaktifkan untuk menyembunyikan layanan suara ini. Model teks penyedia tidak terpengaruh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにするとこの音声サービスを非表示にします。プロバイダーのテキストモデルには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 음성 서비스를 숨기려면 끄세요. 제공자의 텍스트 모델에는 영향이 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matikan untuk menyembunyikan perkhidmatan suara ini. Model teks pembekal tidak terjejas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłącz, aby ukryć tę usługę głosową. Modele tekstowe dostawcy pozostają bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desative para ocultar este serviço de voz. Os modelos de texto do provedor não são afetados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezactivează pentru a ascunde acest serviciu vocal. Modelele text ale furnizorului nu sunt afectate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключите, чтобы скрыть этот голосовой сервис. Текстовые модели провайдера не затрагиваются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดเพื่อซ่อนบริการเสียงนี้ โมเดลข้อความของผู้ให้บริการจะไม่ได้รับผลกระทบ"
