    "Clear your custom display name and max output tokens, restoring the values reported by the provider." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt deinen benutzerdefinierten Anzeigenamen und die maximalen Ausgabe-Tokens zurück auf die vom Anbieter gemeldeten Werte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear your custom display name and max output tokens, restoring the values reported by the provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra el nombre personalizado y el máximo de tokens de salida, y restaura los valores indicados por el proveedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacez votre nom d'affichage personnalisé et le nombre maximum de jetons de sortie, restaurant les valeurs signalées par le fournisseur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタム表示名と最大出力トークン数をクリアし、プロバイダーが報告する値に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 지정 표시 이름 및 최대 출력 토큰을 지우고 공급자가 보고한 값으로 복원합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистить ваше пользовательское отображаемое имя и максимальное число выходных токенов, восстановив значения, заданные провайдером."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除您自定义的显示名称和最大输出 Token 数，恢复为服务商提供的值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除您自定義的顯示名稱和最大輸出 Token 數，恢復爲服務商提供的值。"
          }
        }
      }
    },
