    "Choose what to show when the app starts. \"Auto\" opens a new chat if the last session is older than 15 minutes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie, was beim App-Start angezeigt wird. „Automatisch“ öffnet einen neuen Chat, wenn die letzte Sitzung älter als 15 Minuten ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what to show when the app starts. \"Auto\" opens a new chat if the last session is older than 15 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué mostrar al abrir la app. \"Auto\" abre un chat nuevo si la última sesión tiene más de 15 minutos."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung ano ang ipapakita pagbukas ng app. Nagbubukas ang \"Auto\" ng bagong chat kung mas matanda sa 15 minuto ang huling session."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ce qui s'affiche au lancement. « Automatique » ouvre un nouveau chat si la dernière session date de plus de 15 minutes."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite što se prikazuje pri pokretanju aplikacije. \"Automatski\" otvara novi razgovor ako je posljednja sesija starija od 15 minuta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih apa yang ditampilkan saat aplikasi dibuka. \"Otomatis\" membuka obrolan baru jika sesi terakhir lebih lama dari 15 menit."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ起動時の表示を選択します。「自動」は最後のセッションが15分以上前の場合、新しいチャットを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 시작 시 표시할 내용을 선택합니다. \"자동\"은 마지막 세션이 15분 이상 지난 경우 새 채팅을 엽니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih apa yang ditunjukkan apabila apl dibuka. \"Auto\" membuka sembang baharu jika sesi terakhir lebih lama daripada 15 minit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, co ma się pojawiać po uruchomieniu aplikacji. „Automatycznie” otwiera nowy czat, jeśli ostatnia sesja jest starsza niż 15 minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o que aparece quando o app é aberto. “Automático” abre uma nova conversa se a última sessão tiver mais de 15 minutos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege ce se afișează la pornirea aplicației. „Automat” deschide o conversație nouă dacă ultima sesiune este mai veche de 15 minute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, что показывать при запуске приложения. «Авто» открывает новый чат, если последняя сессия старше 15 минут."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกสิ่งที่จะแสดงเมื่อเปิดแอป \"อัตโนมัติ\" จะเปิดแชทใหม่หากเซสชันล่าสุดเก่ากว่า 15 นาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama açıldığında ne görüneceğini seçin. \"Otomatik\", son oturum 15 dakikadan eskiyse yeni bir sohbet açar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择应用启动时显示的内容。\"自动\"会在上次会话超过 15 分钟时打开新对话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇應用啓動時顯示的內容。\"自動\"會在上次工作階段超過 15 分鐘時打開新對話。"
          }
        }
      }
    },
    "Choose whether the Return key in the chat input inserts a newline or sends the message. Hardware Shift+Return always inserts a newline." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt fest, ob die Eingabetaste im Chat-Eingabefeld einen Zeilenumbruch einfügt oder die Nachricht sendet. Hardware-Umschalt+Eingabe fügt immer einen Zeilenumbruch ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose whether the Return key in the chat input inserts a newline or sends the message. Hardware Shift+Return always inserts a newline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige si la tecla Retorno en la entrada del chat inserta un salto de línea o envía el mensaje. Mayús+Retorno en un teclado físico siempre inserta un salto de línea."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung ang Return key sa chat input ay gagawa ng bagong linya o magpapadala ng mensahe. Laging gumagawa ng bagong linya ang Shift+Return sa pisikal na keyboard."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez si la touche Entrée dans la saisie du chat insère un saut de ligne ou envoie le message. Maj+Entrée matériel insère toujours un saut de ligne."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite umeće li tipka Return u polju za unos razgovora novi redak ili šalje poruku. Hardverski Shift+Return uvijek umeće novi redak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih apakah tombol Return di input obrolan membuat baris baru atau mengirim pesan. Shift+Return pada papan ketik fisik selalu membuat baris baru."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャット入力欄で Return キーが改行を挿入するか、メッセージを送信するかを選択します。ハードウェアの Shift+Return は常に改行を挿入します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅 입력에서 Return 키가 줄바꿈을 삽입할지 메시지를 보낼지 선택합니다. 하드웨어 Shift+Return은 항상 줄바꿈을 삽입합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih sama ada kekunci Return dalam input sembang membuat baris baharu atau menghantar mesej. Shift+Return pada papan kekunci fizikal sentiasa membuat baris baharu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, czy klawisz Enter w polu czatu ma wstawiać nowy wiersz, czy wysyłać wiadomość. Shift+Enter na klawiaturze fizycznej zawsze wstawia nowy wiersz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha se a tecla Enter no campo de conversa insere uma quebra de linha ou envia a mensagem. Shift+Enter no teclado físico sempre insere uma quebra de linha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege dacă tasta Enter din câmpul de conversație inserează un rând nou sau trimite mesajul. Shift+Enter pe tastatura fizică inserează întotdeauna un rând nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, что делает клавиша «Ввод» в поле чата: вставляет новую строку или отправляет сообщение. Аппаратное сочетание Shift+Ввод всегда вставляет новую строку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกว่าปุ่ม Return ในช่องป้อนแชทจะขึ้นบรรทัดใหม่หรือส่งข้อความ ส่วน Shift+Return บนคีย์บอร์ดจริงจะขึ้นบรรทัดใหม่เสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbet alanındaki Enter tuşunun satır mı ekleyeceğini yoksa mesajı mı göndereceğini seçin. Fiziksel klavyede Shift+Enter her zaman satır ekler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择聊天输入框中回车键的行为：插入换行或发送消息。硬件键盘 Shift+Return 始终插入换行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇聊天輸入框中回車鍵的行爲：插入換行或傳送訊息。硬體鍵盤 Shift+Return 始終插入換行。"
          }
        }
      }
    },
    "Choose which data this device pushes to iCloud. API keys and secrets are synced securely via iCloud Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie aus, welche Daten dieses Gerät auf iCloud hochlädt. API-Schlüssel und Geheimnisse werden sicher über iCloud-Schlüsselbund synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which data this device pushes to iCloud. API keys and secrets are synced securely via iCloud Keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué datos envía este dispositivo a iCloud. Las claves de API y los secretos se sincronizan de forma segura mediante el llavero de iCloud."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piliin kung anong datos ang ipapadala ng device na ito sa iCloud. Ligtas na sini-sync ang mga API key at secret sa iCloud Keychain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les données que cet appareil envoie vers iCloud. Les clés API et les secrets sont synchronisés en toute sécurité via le trousseau iCloud."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite koje podatke ovaj uređaj šalje na iCloud. API ključevi i tajne sigurno se sinkroniziraju putem iCloud Keychaina."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih data mana yang dikirim perangkat ini ke iCloud. Kunci API dan rahasia disinkronkan dengan aman via iCloud Keychain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスから iCloud にプッシュするデータを選択します。API キーとシークレットは iCloud キーチェーン経由で安全に同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기가 iCloud로 푸시할 데이터를 선택하세요. API 키와 비밀은 iCloud 키체인을 통해 안전하게 동기화됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih data mana yang dihantar peranti ini ke iCloud. Kunci API dan rahsia disegerakkan dengan selamat melalui iCloud Keychain."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz, które dane to urządzenie wysyła do iCloud. Klucze API i sekrety są bezpiecznie synchronizowane przez Pęk kluczy iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha quais dados este dispositivo envia ao iCloud. Chaves de API e segredos são sincronizados com segurança pelo Keychain do iCloud."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege ce date trimite acest dispozitiv în iCloud. Cheile API și secretele se sincronizează în siguranță prin Keychain-ul iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите, какие данные это устройство отправляет в iCloud. API-ключи и секреты безопасно синхронизируются через Связку ключей iCloud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกว่าอุปกรณ์นี้จะส่งข้อมูลใดไปยัง iCloud คีย์ API และข้อมูลลับจะถูกซิงค์อย่างปลอดภัยผ่าน iCloud Keychain"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıtın iCloud'a hangi verileri göndereceğini seçin. API anahtarları ve gizli bilgiler iCloud Anahtar Zinciri ile güvenle eşitlenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择本设备推送到 iCloud 的数据类型。API 密钥和敏感信息通过 iCloud 钥匙串安全同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇本裝置推送到 iCloud 的資料類型。API 金鑰和機密資訊透過 iCloud 鑰匙圈安全同步。"
          }
        }
      }
    },
