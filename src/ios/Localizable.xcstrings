    "%@ outputs %@ and usually can't drive an Agent task. Pick a text-output model for the session, or add this model to Available Models in Agent Loop so the agent can call it via minis-model-use when it needs to generate %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ gibt %2$@ aus und kann eine Agent-Aufgabe normalerweise nicht steuern. Wähle für die Sitzung ein Modell mit Textausgabe oder füge dieses Modell zu „Verfügbare Modelle im Agent Loop“ hinzu, damit der Agent es bei Bedarf über minis-model-use aufrufen kann, um %3$@ zu generieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ outputs %2$@ and usually can't drive an Agent task. Pick a text-output model for the session, or add this model to Available Models in Agent Loop so the Agent can call it via minis-model-use when it needs to generate %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ genera %@ y normalmente no puede ejecutar una tarea de Agent. Elige un modelo de salida de texto para la sesión, o añade este modelo a Modelos disponibles en Agent Loop para que Minis Agent pueda invocarlo mediante minis-model-use cuando necesite generar %@."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagawa ang %@ ng %@ at karaniwang hindi kayang magpatakbo ng Agent task. Pumili ng model na text ang output para sa session, o idagdag ang model na ito sa Mga Available na Model sa Agent Loop para matawag ito ng agent gamit ang minis-model-use kapag kailangan nitong gumawa ng %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ produit %2$@ et ne peut généralement pas piloter une tâche Agent. Choisissez un modèle à sortie texte pour la session, ou ajoutez ce modèle aux « Modèles disponibles dans l’Agent Loop » afin que l’Agent puisse l’appeler via minis-model-use lorsqu’il a besoin de générer %3$@."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ daje izlaz %2$@ i obično ne može voditi Agent zadatak. Odaberite model s tekstualnim izlazom za sesiju ili dodajte ovaj model u Dostupne modele u Agent petlji kako bi ga Agent mogao pozvati putem minis-model-use kada treba generirati %3$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menghasilkan %@ dan biasanya tidak dapat menjalankan tugas Agen. Pilih model berkeluaran teks untuk sesi ini, atau tambahkan model ini ke Model Tersedia dalam Loop Agen agar agen dapat memanggilnya via minis-model-use saat perlu menghasilkan %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は %2$@ を出力するため、通常は Agent タスクを駆動できません。セッションにはテキスト出力モデルを選ぶか、このモデルを「Agent Loop 利用可能モデル」に追加してください。そうすれば Agent が %3$@ を生成する必要があるときに minis-model-use 経由で呼び出せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) %2$@을(를) 출력하므로 일반적으로 Agent 작업을 수행할 수 없습니다. 세션에는 텍스트 출력 모델을 선택하거나, 이 모델을 \"Agent Loop 사용 가능한 모델\"에 추가하세요. 그러면 Agent가 %3$@을(를) 생성해야 할 때 minis-model-use를 통해 호출할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ menghasilkan %@ dan biasanya tidak boleh menjalankan tugas Ejen. Pilih model beroutput teks untuk sesi ini, atau tambah model ini ke Model Tersedia dalam Gelung Ejen supaya ejen boleh memanggilnya melalui minis-model-use apabila perlu menjana %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zwraca %@ i zwykle nie nadaje się do prowadzenia zadania agenta. Wybierz dla sesji model z wyjściem tekstowym albo dodaj ten model do dostępnych modeli w pętli agenta, aby agent mógł go wywołać przez minis-model-use, gdy potrzebuje wygenerować: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ produz %@ e normalmente não consegue conduzir uma tarefa de agente. Escolha um modelo com saída de texto para a sessão ou adicione este modelo a Modelos disponíveis na Malha do agente, para o agente poder chamá-lo por minis-model-use quando precisar gerar %@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ produce %@ și de obicei nu poate conduce o sarcină de agent. Alege pentru sesiune un model cu ieșire text sau adaugă acest model la Modele disponibile în Bucla agentului, ca agentul să îl poată apela prin minis-model-use când trebuie să genereze %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ выдаёт %2$@ и обычно не может выполнять задачи Agent. Выберите для сессии модель с текстовым выводом или добавьте эту модель в «Доступные модели» в Agent Loop, чтобы Agent мог вызывать её через minis-model-use, когда ему нужно сгенерировать %3$@."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ สร้างเอาต์พุตเป็น %@ และมักใช้ขับเคลื่อนงานเอเจนต์ไม่ได้ เลือกโมเดลที่ให้เอาต์พุตเป็นข้อความสำหรับเซสชันนี้ หรือเพิ่มโมเดลนี้ในโมเดลที่ใช้ได้ในลูปเอเจนต์ เพื่อให้เอเจนต์เรียกใช้ผ่าน minis-model-use เมื่อต้องสร้าง %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ şunu üretir: %@ ve genellikle bir Aracı görevini yürütemez. Oturum için metin çıkışlı bir model seçin ya da bu modeli Aracı Döngüsündeki Kullanılabilir Modeller'e ekleyin; böylece aracı, şunu üretmesi gerektiğinde minis-model-use ile çağırabilir: %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 输出 %2$@，通常无法驱动 Agent 任务。请为会话选择文本输出模型，或将该模型加入「Agent Loop 可用模型」，这样 Agent 在需要生成 %3$@ 时可通过 minis-model-use 调用它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 輸出 %2$@，通常無法驅動 Agent 任務。請為對話選擇文字輸出模型，或將該模型加入「Agent Loop 可用模型」，這樣 Agent 在需要產生 %3$@ 時可透過 minis-model-use 呼叫它。"
          }
        }
      }
    },
