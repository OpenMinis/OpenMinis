    "If it's on a server, open it once in the Files app to reconnect, then pull down to refresh." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn es auf einem Server liegt, öffne es einmal in der App „Dateien“, um es neu zu verbinden, und ziehe dann zum Aktualisieren nach unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it's on a server, open it once in the Files app to reconnect, then pull down to refresh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está en un servidor, ábrelo una vez en la app Archivos para reconectar y desliza hacia abajo para actualizar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung nasa server ito, buksan minsan sa Files app para kumonekta ulit, tapos hilahin pababa para mag-refresh."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'il se trouve sur un serveur, ouvrez-le une fois dans l'app Fichiers pour le reconnecter, puis tirez vers le bas pour actualiser."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako se nalazi na poslužitelju, otvorite ga jednom u aplikaciji Files kako biste se ponovno povezali, zatim povucite prema dolje za osvježavanje."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika berada di server, buka sekali di aplikasi Files untuk menghubungkan ulang, lalu tarik ke bawah untuk memuat ulang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバ上にある場合は、「ファイル」App で一度開いて再接続してから、引き下げて再読み込みしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 있다면 파일 앱에서 한 번 열어 다시 연결한 다음, 아래로 당겨 새로 고치세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika ia di server, buka sekali dalam apl Files untuk menyambung semula, kemudian tarik ke bawah untuk muat semula."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli jest na serwerze, otwórz go raz w aplikacji Pliki, aby połączyć ponownie, a potem pociągnij w dół, by odświeżyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se estiver em um servidor, abra-o uma vez no app Arquivos para reconectar e puxe para baixo para atualizar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă e pe un server, deschide-l o dată în aplicația Fișiere pentru reconectare, apoi trage în jos pentru reîmprospătare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если это на сервере, откройте его один раз в приложении «Файлы» для переподключения, затем потяните вниз для обновления."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากอยู่บนเซิร์ฟเวอร์ ให้เปิดในแอป Files สักครั้งเพื่อเชื่อมต่อใหม่ แล้วดึงลงเพื่อรีเฟรช"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucudaysa yeniden bağlanmak için Dosyalar uygulamasında bir kez açın, sonra aşağı çekip yenileyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果它位于服务器上，请先在「文件」App 中打开一次以重新连接，然后下拉刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果它位於伺服器上，請先在「檔案」App 中打開一次以重新連接，然後下拉重新整理。"
          }
        }
      }
    },
