        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avançado: grave um valor em um caminho de campo com pontos. Não é validado pelo Minis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avansat: scrie o valoare la o cale de câmp cu puncte. Minis nu o validează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дополнительно: записывает значение по пути с точками. Minis его не проверяет."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขั้นสูง: เขียนค่าที่พาธฟิลด์แบบจุด Minis ไม่ตรวจสอบความถูกต้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelişmiş: noktalı alan yoluna bir değer yazın. Minis bunu doğrulamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高级：向指定的点分字段路径写入值。Minis 不会校验其正确性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進階：在點分隔的欄位路徑寫入值。Minis 不會驗證這個值。"
          }
        }
      }
    },
    "After leaving an unlocked session, the lock re-engages once the idle window elapses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Verlassen einer entsperrten Sitzung wird die Sperre nach Ablauf des Inaktivitätsfensters wieder aktiviert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After leaving an unlocked session, the lock re-engages once the idle window elapses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al salir de una sesión desbloqueada, el bloqueo se reactiva cuando transcurre el periodo de inactividad."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagkalabas sa naka-unlock na session, magla-lock ulit ito kapag lumipas ang idle window."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir quitté une session déverrouillée, le verrouillage se réactive une fois la période d'inactivité écoulée."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon napuštanja otključane sesije zaključavanje se ponovno aktivira kada istekne razdoblje neaktivnosti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah meninggalkan sesi yang terbuka, kunci aktif kembali begitu jendela menganggur berakhir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック解除したセッションを離れた後、アイドル時間が経過するとロックが再度かかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 해제된 세션을 떠난 후 유휴 시간이 지나면 잠금이 다시 걸립니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selepas meninggalkan sesi yang terbuka, kunci aktif semula setelah tetingkap melahu tamat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po opuszczeniu odblokowanej sesji blokada włącza się ponownie po upływie czasu bezczynności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois que você sai de uma sessão desbloqueada, o bloqueio volta a valer ao fim do tempo de inatividade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După părăsirea unei sesiuni deblocate, blocarea se reactivează la expirarea perioadei de inactivitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После выхода из разблокированной сессии блокировка снова сработает по истечении времени простоя."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังออกจากเซสชันที่ปลดล็อกแล้ว ระบบจะล็อกอีกครั้งเมื่อครบเวลาที่ไม่ได้ใช้งาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilidi açık bir oturumdan çıktıktan sonra, boşta kalma süresi dolunca kilit yeniden devreye girer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开已解锁的会话后，空闲时间到达即重新锁定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開已解鎖的工作階段後，閒置時間到達即重新鎖定。"
          }
        }
      }
    },
    "After leaving an unlocked session, the lock re-engages once the idle window elapses. Going to the home screen or app switcher always re-locks the current session immediately." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Verlassen einer entsperrten Sitzung greift die Sperre wieder, sobald die Inaktivitätszeit abgelaufen ist. Der Wechsel zum Home-Bildschirm oder App-Umschalter sperrt die aktuelle Sitzung immer sofort wieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After leaving an unlocked session, the lock re-engages once the idle window elapses. Going to the home screen or app switcher always re-locks the current session immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al salir de una sesión desbloqueada, el bloqueo se reactiva cuando transcurre el periodo de inactividad. Ir a la pantalla de inicio o al selector de apps siempre vuelve a bloquear la sesión actual de inmediato."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagkalabas sa naka-unlock na session, magla-lock ulit ito kapag lumipas ang idle window. Laging agad na nagla-lock ulit ang kasalukuyang session kapag pumunta sa home screen o app switcher."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir quitté une session déverrouillée, le verrouillage se réactive à la fin du délai d'inactivité. Passer à l'écran d'accueil ou au sélecteur d'apps reverrouille toujours immédiatement la session en cours."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakon napuštanja otključane sesije zaključavanje se ponovno aktivira kada istekne razdoblje neaktivnosti. Odlazak na početni zaslon ili u izbornik aplikacija uvijek odmah ponovno zaključava trenutnu sesiju."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah meninggalkan sesi yang terbuka, kunci aktif kembali begitu jendela menganggur berakhir. Beralih ke layar utama atau pengalih aplikasi selalu langsung mengunci ulang sesi saat ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックを解除したセッションから離れると、待機時間の経過後に再びロックされます。ホーム画面やアプリスイッチャーに移動した場合は、現在のセッションが常に即座に再ロックされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금을 해제한 세션에서 나가면 대기 시간이 지난 후 다시 잠깁니다. 홈 화면이나 앱 전환기로 이동하면 현재 세션은 항상 즉시 다시 잠깁니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selepas meninggalkan sesi yang terbuka, kunci aktif semula setelah tetingkap melahu tamat. Beralih ke skrin utama atau penukar apl sentiasa terus mengunci semula sesi semasa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po opuszczeniu odblokowanej sesji blokada wraca po upływie czasu bezczynności. Przejście na ekran początkowy lub do przełącznika aplikacji zawsze blokuje bieżącą sesję natychmiast."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois que você sai de uma sessão desbloqueada, o bloqueio volta a valer ao fim do tempo de inatividade. Ir para a Tela de Início ou o alternador de apps sempre bloqueia a sessão atual na hora."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "După părăsirea unei sesiuni deblocate, blocarea se reactivează la expirarea perioadei de inactivitate. Trecerea la ecranul principal sau la comutatorul de aplicații reblochează imediat sesiunea curentă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После выхода из разблокированной сессии блокировка снова включается по истечении времени бездействия. Переход на домашний экран или в переключатель приложений всегда блокирует текущую сессию немедленно."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังออกจากเซสชันที่ปลดล็อกแล้ว ระบบจะล็อกอีกครั้งเมื่อครบเวลาที่ไม่ได้ใช้งาน การไปที่หน้าจอโฮมหรือตัวสลับแอปจะล็อกเซสชันปัจจุบันทันทีเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilidi açık bir oturumdan çıktıktan sonra, boşta kalma süresi dolunca kilit yeniden devreye girer. Ana ekrana ya da uygulama değiştiriciye geçmek geçerli oturumu her zaman anında yeniden kilitler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "离开已解锁的会话后，超过空闲时长会重新锁定。回到主屏或切换应用时会立即重新锁定当前会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "離開已解鎖的工作階段後，閒置時間一到就會重新鎖定。切換到主畫面或 App 切換器時，目前的工作階段一律會立即重新鎖定。"
          }
        }
      }
    },
