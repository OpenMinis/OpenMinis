    "\"Automatic\" uses the system icon which adapts to Dark Mode on iOS 18+." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ verwendet das Systemsymbol, das sich auf iOS 18+ an den Dunkelmodus anpasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Automatic\" uses the system icon which adapts to Dark Mode on iOS 18+."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Automático\" usa el icono del sistema, que se adapta al modo oscuro en iOS 18 y posteriores."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit ng \"Automatic\" ang system icon na umaangkop sa Dark Mode sa iOS 18+."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Automatique » utilise l'icône système qui s'adapte au mode sombre sur iOS 18+."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Automatski\" koristi sustavsku ikonu koja se prilagođava tamnom načinu na iOS-u 18 i novijem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Otomatis\" memakai ikon sistem yang menyesuaikan Mode Gelap di iOS 18+."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」はシステムアイコンを使用し、iOS 18+でダークモードに対応します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"자동\"은 iOS 18+에서 다크 모드에 맞게 변하는 시스템 아이콘을 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Automatik\" menggunakan ikon sistem yang menyesuaikan Mod Gelap pada iOS 18+."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatycznie” używa ikony systemowej, która dostosowuje się do trybu ciemnego w iOS 18+."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Automático\" usa o ícone do sistema, que se adapta ao Modo Escuro no iOS 18 ou posterior."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automat” folosește pictograma de sistem, care se adaptează la modul întunecat pe iOS 18+."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Автоматически» использует системный значок, который адаптируется к тёмному режиму на iOS 18+."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"อัตโนมัติ\" ใช้ไอคอนระบบที่ปรับตามโหมดมืดบน iOS 18 ขึ้นไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Otomatik\", iOS 18 ve üzerinde Koyu Mod'a uyum sağlayan sistem simgesini kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自动」使用系统图标，在 iOS 18+ 上自动适配深色模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」使用系統圖標，在 iOS 18+ 上自動適配深色模式。"
          }
        }
      }
    },
