    "Use of an organization, enterprise, or production account is strongly discouraged. Please sign in with a personal account whose loss you are prepared to accept." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use of an organization, enterprise, or production account is strongly discouraged. Please sign in with a personal account whose loss you are prepared to accept."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强烈建议不要使用组织、企业或生产环境账号。请使用您能够承受损失的个人账号登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強烈建議不要使用組織、企業或生產環境帳號。請使用您能夠承受損失的個人帳號登入。"
          }
        }
      }
    },
    "Use may violate the provider's terms of service and may result in rate limiting, suspension, or permanent termination of your Copilot entitlement or your GitHub account. Any such consequence applies to your account and cannot be reversed by Minis." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use may violate the provider's terms of service and may result in rate limiting, suspension, or permanent termination of your Copilot entitlement or your GitHub account. Any such consequence applies to your account and cannot be reversed by Minis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用本功能可能违反服务方的服务条款，并可能导致您的 Copilot 权益或 GitHub 账号被限流、暂停乃至永久封禁。相关后果由您的账号承担，Minis 无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用本功能可能違反服務方的服務條款，並可能導致您的 Copilot 權益或 GitHub 帳號被限流、暫停乃至永久封鎖。相關後果由您的帳號承擔，Minis 無法撤銷。"
          }
        }
      }
    },
    "Used to identify this device in backup filenames and in the iCloud sync device list. Leave empty to use “%@”." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dient zur Kennzeichnung dieses Geräts in Sicherungsdateinamen und in der iCloud-Sync-Geräteliste. Leer lassen, um „%@“ zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to identify this device in backup filenames and in the iCloud sync device list. Leave empty to use “%@”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para identificar este dispositivo en los nombres de las copias y en la lista de dispositivos de iCloud. Déjalo vacío para usar “%@”."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit para makilala ang device na ito sa pangalan ng backup file at sa listahan ng device sa iCloud sync. Iwanang blangko para gamitin ang “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à identifier cet appareil dans les noms de fichiers de sauvegarde et dans la liste des appareils de la synchro iCloud. Laissez vide pour utiliser « %@ »."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi se za identifikaciju ovog uređaja u nazivima datoteka sigurnosnih kopija i na popisu uređaja iCloud sinkronizacije. Ostavite prazno da biste koristili “%@”."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dipakai untuk mengenali perangkat ini dalam nama file cadangan dan daftar perangkat sinkronisasi iCloud. Kosongkan untuk memakai “%@”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップのファイル名と iCloud 同期のデバイス一覧でこのデバイスを識別するために使われます。空欄の場合は「%@」を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업 파일 이름과 iCloud 동기화 기기 목록에서 이 기기를 식별하는 데 사용됩니다. 비워 두면 \"%@\"을(를) 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk mengenal pasti peranti ini dalam nama file sandaran dan senarai peranti penyegerakan iCloud. Biarkan kosong untuk menggunakan “%@”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy do rozpoznania tego urządzenia w nazwach plików kopii i na liście urządzeń synchronizacji iCloud. Pozostaw puste, aby użyć „%@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para identificar este dispositivo nos nomes dos arquivos de backup e na lista de dispositivos do iCloud. Deixe vazio para usar “%@”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosit pentru a identifica acest dispozitiv în numele fișierelor de rezervă și în lista de dispozitive iCloud. Lasă gol pentru a folosi „%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для обозначения этого устройства в именах файлов копий и в списке устройств синхронизации iCloud. Оставьте пустым, чтобы использовать «%@»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ระบุอุปกรณ์นี้ในชื่อไฟล์ข้อมูลสำรองและในรายการอุปกรณ์ซิงค์ iCloud เว้นว่างไว้เพื่อใช้ “%@”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıtı yedek dosya adlarında ve iCloud eşitleme aygıt listesinde tanımlamak için kullanılır. “%@” kullanmak için boş bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于在备份文件名和 iCloud 同步设备列表中标识本设备。留空则使用“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於在備份檔案名稱和 iCloud 同步裝置清單中識別本裝置。留空則使用「%@」。"
          }
        }
      }
    },
    "Verbose adds high-frequency traces (filesystem, rendering, context). Useful when reproducing a specific problem — logs grow very quickly, so switch back to Info afterwards." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbose adds high-frequency traces (filesystem, rendering, context). Useful when reproducing a specific problem — logs grow very quickly, so switch back to Info afterwards."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「详细」会额外记录高频追踪(文件系统、渲染、上下文),适合复现具体问题时开启。日志增长极快,排查完请切回「常规」。"
          }
        }
      }
    },
    "Verbose" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbose"
