    "This tool may have been paused by the system while running in the background. Enable enhanced background execution to improve background task reliability." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This tool may have been paused by the system while running in the background. Enable enhanced background execution to improve background task reliability."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que el sistema haya pausado esta herramienta mientras se ejecutaba en segundo plano. Activa la ejecución mejorada en segundo plano para mejorar la fiabilidad de las tareas en segundo plano."
          }
        },
