    "settings_memory_global_enabled_footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn deaktiviert, überspringen neue Sitzungen standardmäßig GLOBAL.md und tägliche Erinnerungen. Bestehende Sitzungen behalten ihre eigene Einstellung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, new sessions skip GLOBAL.md and daily memory by default. Existing sessions keep their own setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "settings_memory_global_enabled_footer"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : les nouvelles sessions ignorent GLOBAL.md et la mémoire quotidienne par défaut. Les sessions existantes conservent leur propre réglage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、新しいセッションは既定で GLOBAL.md と日次メモリをスキップします。既存セッションの設定は維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꺼두면 새 세션은 기본적으로 GLOBAL.md와 일일 메모리를 건너뜁니다. 기존 세션은 각자의 설정을 유지합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда выключено, новые сессии по умолчанию пропускают GLOBAL.md и ежедневную память. Существующие сессии сохраняют собственные настройки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后所有新会话默认不使用记忆（不注入 GLOBAL.md 与每日记忆）。已存在的会话保留各自的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉後所有新會話預設不使用記憶（不注入 GLOBAL.md 與每日記憶）。已存在的會話保留各自的設定。"
          }
        }
      }
