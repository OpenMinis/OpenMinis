        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 채팅에서 작업이 실행 중입니다. 새 채팅을 시작하면 중단됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
