        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將刪除區域內的所有記錄 + 資源。此操作無法還原。"
          }
        }
      }
    },
    "This device created this zone. Other devices of yours that haven't fetched everything yet will lose access to whatever they haven't pulled locally." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat diese Zone erstellt. Andere deiner Geräte, die noch nicht alles abgerufen haben, verlieren den Zugriff auf alles, was sie lokal noch nicht abgerufen haben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device created this zone. Other devices of yours that haven't fetched everything yet will lose access to whatever they haven't pulled locally."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo creó esta zona. Tus otros dispositivos que aún no lo hayan descargado todo perderán el acceso a lo que no hayan obtenido localmente."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang device na ito ang gumawa ng zone na ito. Mawawalan ng access ang iba mong device na hindi pa nakakakuha ng lahat sa kung anuman ang hindi pa nila nakuha nang lokal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil a créé cette zone. Tes autres appareils qui n’ont pas encore tout récupéré perdront l’accès à ce qu’ils n’ont pas téléchargé localement."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj je uređaj stvorio ovu zonu. Vaši drugi uređaji koji još nisu dohvatili sve izgubit će pristup svemu što nisu preuzeli lokalno."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat ini yang membuat zona tersebut. Perangkat Anda yang lain yang belum mengambil semuanya akan kehilangan akses ke apa pun yang belum ditarik ke lokal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスがこのゾーンを作成しました。まだすべてを取得していない他のデバイスは、ローカルに取得していないものへのアクセスを失います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기가 이 영역을 만들었습니다. 아직 모든 것을 가져오지 않은 다른 기기는 로컬로 가져오지 않은 항목에 대한 접근 권한을 잃게 됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peranti ini yang mencipta zon tersebut. Peranti anda yang lain yang belum mengambil semuanya akan kehilangan akses ke apa sahaja yang belum ditarik ke tempatan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie utworzyło tę strefę. Twoje inne urządzenia, które nie pobrały jeszcze wszystkiego, stracą dostęp do tego, czego nie ściągnęły lokalnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo criou esta zona. Seus outros dispositivos que ainda não baixaram tudo perderão o acesso ao que não tiverem trazido localmente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest dispozitiv a creat zona. Celelalte dispozitive ale tale care nu au preluat încă totul vor pierde accesul la ce nu au descărcat local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эту зону создало данное устройство. Другие ваши устройства, которые ещё не получили всё, потеряют доступ к тому, что не загрузили локально."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อุปกรณ์นี้เป็นผู้สร้างโซนนี้ อุปกรณ์อื่นของคุณที่ยังดึงข้อมูลไม่ครบจะเข้าถึงสิ่งที่ยังไม่ได้ดึงมาไว้ในเครื่องไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bölgeyi bu aygıt oluşturdu. Her şeyi henüz almamış diğer aygıtlarınız, yerele çekmedikleri verilere erişimini yitirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此区域由本设备创建。你尚未获取全部内容的其他设备，将无法访问它们尚未在本地拉取的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此區域由本裝置建立。你尚未取得全部內容的其他裝置，將無法存取它們尚未在本機拉取的內容。"
          }
        }
      }
    },
    "This device name is broadcast to your other devices in the iCloud Sync zone." : {
