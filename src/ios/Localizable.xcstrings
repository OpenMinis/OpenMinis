    "Restoring merges a backup into your existing data. Nothing is deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Wiederherstellen wird eine Sicherung mit deinen vorhandenen Daten zusammengeführt. Nichts wird gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauración fusiona una copia de seguridad con tus datos actuales. No se elimina nada."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinagsasama ng restore ang backup sa umiiral mong datos. Walang tinatanggal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La restauration fusionne une sauvegarde avec vos données existantes. Rien n'est supprimé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraćanje spaja sigurnosnu kopiju s vašim postojećim podacima. Ništa se ne briše."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemulihan menggabungkan cadangan ke data Anda yang ada. Tidak ada yang dihapus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元では、バックアップが既存のデータに統合されます。何も削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원하면 백업이 기존 데이터에 병합됩니다. 삭제되는 항목은 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemulihan menggabungkan sandaran ke dalam data sedia ada anda. Tiada apa-apa dipadam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywracanie scala kopię z istniejącymi danymi. Nic nie jest usuwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A restauração mescla um backup com os seus dados atuais. Nada é excluído."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurarea îmbină copia cu datele tale existente. Nimic nu este șters."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При восстановлении копия объединяется с вашими данными. Ничего не удаляется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกู้คืนจะรวมข้อมูลสำรองเข้ากับข้อมูลที่มีอยู่ ไม่มีอะไรถูกลบ"
