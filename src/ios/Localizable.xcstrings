    "Default rules are built in and cannot be deleted. Add a rule above them to override one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardregeln sind integriert und können nicht gelöscht werden. Füge darüber eine Regel hinzu, um eine zu überschreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Default rules are built in and cannot be deleted. Add a rule above them to override one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas predeterminadas son integradas y no se pueden eliminar. Añade una regla por encima de ellas para anular alguna."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built-in ang mga default na rule at hindi matatanggal. Magdagdag ng rule sa itaas nito para palitan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les règles par défaut sont intégrées et ne peuvent pas être supprimées. Ajoutez une règle au-dessus pour en remplacer une."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadana su pravila ugrađena i ne mogu se obrisati. Dodajte pravilo iznad njih da biste nadjačali neko od njih."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aturan bawaan sudah tertanam dan tidak dapat dihapus. Tambahkan aturan di atasnya untuk menimpanya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトのルールは組み込みで、削除できません。上書きするには、その上にルールを追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본 규칙은 내장되어 있어 삭제할 수 없습니다. 재정의하려면 그 위에 규칙을 추가하십시오."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peraturan lalai terbina dalam dan tidak boleh dipadam. Tambah peraturan di atasnya untuk menggantikannya."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reguły domyślne są wbudowane i nie można ich usunąć. Dodaj regułę powyżej, aby je zastąpić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As regras padrão são integradas e não podem ser excluídas. Adicione uma regra acima delas para substituir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regulile implicite sunt integrate și nu pot fi șterse. Adaugă o regulă deasupra lor pentru a le înlocui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила по умолчанию встроены и не могут быть удалены. Добавьте правило выше, чтобы переопределить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กฎเริ่มต้นมีมาในตัวและลบไม่ได้ เพิ่มกฎไว้เหนือกฎเหล่านั้นเพื่อแทนที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan kurallar yerleşiktir ve silinemez. Birini geçersiz kılmak için üstüne kural ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认规则内置于应用，无法删除。在其上方添加自定义规则即可覆盖。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設規則是內建的，無法刪除。若要覆寫，請在其上方新增規則。"
          }
        }
      }
    },
