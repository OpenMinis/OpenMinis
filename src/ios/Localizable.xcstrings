        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에 이미 있는 백업은 삭제되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandaran yang sudah ada di server tidak dipadam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie już znajdujące się na serwerze nie są usuwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups que já estão no servidor não são excluídos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiile aflate deja pe server nu sunt șterse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копии, уже находящиеся на сервере, не удаляются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลสำรองที่อยู่บนเซิร์ฟเวอร์แล้วจะไม่ถูกลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
