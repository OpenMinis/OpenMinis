          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powyżej limitu zgłoszonego przez dostawcę (%lld) — API może odrzucać żądania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acima do limite de %lld informado pelo provedor — a API pode rejeitar as requisições."
          }
        },
        "ro" : {
