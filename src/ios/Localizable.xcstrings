    "Use a static bearer token instead of the OAuth sign-in flow. Useful with custom proxy endpoints." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie ein statisches Bearer Token anstelle des OAuth-Anmeldeflusses. Nützlich mit benutzerdefinierten Proxy-Endpoints."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a static bearer token instead of the OAuth sign-in flow. Useful with custom proxy endpoints."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un bearer token estático en lugar del flujo de inicio de sesión con OAuth. Útil con endpoints de proxy personalizados."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumamit ng static na bearer token sa halip na OAuth sign-in flow. Kapaki-pakinabang sa custom na proxy endpoint."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser un jeton Bearer statique au lieu du flux OAuth. Utile avec des endpoints proxy personnalisés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristite statični bearer token umjesto OAuth prijave. Korisno uz prilagođene proxy endpointe."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan token bearer statis alih-alih alur masuk OAuth. Berguna dengan endpoint proksi kustom."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OAuthサインインの代わりに静態Bearerトークンを使用します。カスタムプロキシエンドポイントに便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OAuth 로그인 대신 정적 Bearer Token을 사용합니다. 사용자 정의 프록시 엔드포인트에 유용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guna token bearer statik dan bukan aliran log masuk OAuth. Berguna dengan endpoint proksi tersuai."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj stałego tokenu bearer zamiast logowania OAuth. Przydatne przy własnych punktach proxy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use um token bearer estático em vez do login por OAuth. Útil com endpoints de proxy personalizados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește un token bearer static în locul autentificării OAuth. Util cu endpoint-uri proxy personalizate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать статический bearer-токен вместо входа через OAuth. Удобно с произвольными прокси-эндпоинтами."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้โทเคน bearer แบบคงที่แทนขั้นตอนลงชื่อเข้าใช้ OAuth มีประโยชน์กับเอนด์พอยต์พร็อกซีที่กำหนดเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OAuth oturum açma akışı yerine sabit bir bearer token kullanın. Özel proxy uç noktalarında yararlıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用静态 Bearer Token 代替 OAuth 登录流程。适用于自定义代理端点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用靜態 Bearer Token 代替 OAuth 登入流程。適用於自訂代理端點。"
          }
        }
      }
    },
