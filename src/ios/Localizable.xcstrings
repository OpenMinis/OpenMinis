        }
      }
    },
    "Apple keeps Personal Automations private to the Shortcuts app, so Minis cannot create, list, or edit their schedules. Their next run is managed by Shortcuts." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple keeps Personal Automations private to the Shortcuts app, so Minis cannot create, list, or edit their schedules. Their next run is managed by Shortcuts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 仅允许“快捷指令”管理个人自动化，因此 Minis 无法创建、列出或编辑其计划。下次运行时间由“快捷指令”管理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
