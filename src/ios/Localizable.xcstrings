          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usando el viewport personalizado %lld×%lld. Toca «Predeterminado» para volver al valor del UA."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
