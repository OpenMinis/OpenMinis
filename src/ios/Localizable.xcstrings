    "Context full. Start a new session to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontext voll. Starten Sie eine neue Sitzung, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Context full. Start a new session to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contexto lleno. Inicia una sesión nueva para continuar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puno ang context. Magsimula ng bagong session para magpatuloy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contexte plein. Démarrez une nouvelle session pour continuer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontekst je pun. Pokrenite novu sesiju za nastavak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konteks penuh. Mulai sesi baru untuk melanjutkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテキストが満杯です。続行するには新しいセッションを開始してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨텍스트가 가득 찼습니다. 계속하려면 새 세션을 시작하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konteks penuh. Mulakan sesi baharu untuk teruskan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontekst pełny. Rozpocznij nową sesję, aby kontynuować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contexto cheio. Comece uma nova sessão para continuar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Context plin. Începe o sesiune nouă pentru a continua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контекст заполнен. Начните новую сессию, чтобы продолжить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บริบทเต็ม เริ่มเซสชันใหม่เพื่อดำเนินการต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
