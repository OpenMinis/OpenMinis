          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该授权服务器不支持必需的 PKCE(S256)。"
          }
        }
      }
    },
    "This backup contains your API keys, OAuth tokens and environment variable values, and it is NOT encrypted — anyone with the file can read them. Turn on encryption to protect it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup enthält deine API-Schlüssel, OAuth-Tokens und Werte von Umgebungsvariablen und ist NICHT verschlüsselt — wer die Datei hat, kann sie lesen. Aktiviere die Verschlüsselung zum Schutz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This backup contains your API keys, OAuth tokens and environment variable values, and it is NOT encrypted — anyone with the file can read them. Turn on encryption to protect it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia contiene tus claves de API, tokens de OAuth y valores de variables de entorno, y NO está cifrada: cualquiera que tenga el archivo puede leerlos. Activa el cifrado para protegerla."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naglalaman ang backup na ito ng iyong mga API key, OAuth token, at halaga ng environment variable, at HINDI ito naka-encrypt — mababasa ito ng sinumang may file. I-on ang encryption para protektahan ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde contient vos clés API, jetons OAuth et valeurs de variables d'environnement, et elle n'est PAS chiffrée — quiconque possède le fichier peut les lire. Activez le chiffrement pour la protéger."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova sigurnosna kopija sadrži vaše API ključeve, OAuth tokene i vrijednosti varijabli okruženja, a NIJE šifrirana — svatko tko ima datoteku može ih pročitati. Uključite šifriranje da biste je zaštitili."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadangan ini berisi kunci API, token OAuth, dan nilai variabel lingkungan Anda, dan TIDAK terenkripsi — siapa pun yang memiliki berkasnya dapat membacanya. Aktifkan enkripsi untuk melindunginya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックアップには API キー、OAuth トークン、環境変数の値が含まれており、暗号化されていません。ファイルを入手した誰もが読み取れます。保護するには暗号化を有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 백업에는 API 키, OAuth 토큰, 환경 변수 값이 포함되어 있으며 암호화되지 않았습니다. 파일을 가진 누구나 읽을 수 있습니다. 보호하려면 암호화를 켜세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandaran ini mengandungi kunci API, token OAuth, dan nilai pemboleh ubah persekitaran anda, dan ia TIDAK disulitkan — sesiapa yang memiliki filenya boleh membacanya. Aktifkan penyulitan untuk melindunginya."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kopia zapasowa zawiera Twoje klucze API, tokeny OAuth i wartości zmiennych środowiskowych, a NIE jest zaszyfrowana — każdy, kto ma ten plik, może je odczytać. Włącz szyfrowanie, aby ją chronić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este backup contém suas chaves de API, tokens OAuth e valores de variáveis de ambiente, e NÃO está criptografado — qualquer pessoa com o arquivo consegue lê-los. Ative a criptografia para proteger."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această copie de rezervă conține cheile tale API, tokenurile OAuth și valorile variabilelor de mediu și NU este criptată — oricine are fișierul le poate citi. Activează criptarea pentru a o proteja."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта резервная копия содержит ваши API-ключи, OAuth-токены и значения переменных окружения и НЕ зашифрована — любой, у кого есть файл, сможет их прочитать. Включите шифрование для защиты."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลสำรองนี้มีคีย์ API โทเคน OAuth และค่าตัวแปรสภาพแวดล้อมของคุณ และไม่ได้เข้ารหัส — ใครก็ตามที่มีไฟล์นี้อ่านได้ เปิดการเข้ารหัสเพื่อป้องกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yedek; API anahtarlarınızı, OAuth token'larınızı ve ortam değişkeni değerlerinizi içerir ve şifrelenmemiştir — dosyayı eline geçiren herkes bunları okuyabilir. Korumak için şifrelemeyi açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份包含你的 API 密钥、OAuth 令牌和环境变量的值，且未加密 —— 任何拿到该文件的人都能读取。开启加密可保护它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此備份包含你的 API 金鑰、OAuth 權杖和環境變數的值，且未加密 —— 任何拿到該檔案的人都能讀取。開啟加密可保護它。"
          }
        }
      }
    },
    "This conversation has scheduled tasks planned. Stopping will also cancel them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
