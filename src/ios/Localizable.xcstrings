        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프롬프트에 첨부할 이미지, 동영상 또는 파일. 이전 단축어 작업의 출력을 받습니다(예: 필터링된 사진 또는 문서)."
          }
        },
        "ru" : {
          "stringUnit" : {
