    "Devices that are signed in to the same iCloud account and have sync enabled. Last seen reflects the most recent push from that device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geräte, die bei demselben iCloud-Account angemeldet sind und Sync aktiviert haben. „Zuletzt gesehen“ zeigt die jüngste Übertragung dieses Geräts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devices that are signed in to the same iCloud account and have sync enabled. Last seen reflects the most recent push from that device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispositivos con sesión iniciada en la misma cuenta de iCloud y con la sincronización activada. \"Visto por última vez\" refleja el envío más reciente desde ese dispositivo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga device na naka-sign in sa parehong iCloud account at may naka-enable na sync. Ipinapakita ng huling nakita ang pinakabagong push mula sa device na iyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appareils connectés au même compte iCloud avec la synchro activée. « Vu pour la dernière fois » indique le dernier envoi de cet appareil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uređaji prijavljeni na isti iCloud račun s uključenom sinkronizacijom. „Zadnje viđeno” odražava posljednje slanje s tog uređaja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perangkat yang masuk ke akun iCloud yang sama dan mengaktifkan sinkronisasi. Terakhir terlihat mencerminkan pengiriman terbaru dari perangkat itu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ iCloud アカウントにサインインし、同期を有効にしているデバイスです。「最終確認」は、そのデバイスからの最新の送信時刻を示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 iCloud 계정에 로그인하고 동기화를 활성화한 기기입니다. '마지막 확인'은 해당 기기의 최근 전송 시각을 나타냅니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peranti yang log masuk ke akaun iCloud yang sama dan mengaktifkan penyegerakan. Terakhir dilihat mencerminkan penghantaran terbaru dari peranti itu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenia zalogowane na to samo konto iCloud z włączoną synchronizacją. „Ostatnio widziano” pokazuje najnowsze wysłanie z danego urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispositivos conectados à mesma conta do iCloud e com a sincronização ativa. “Visto por último” reflete o envio mais recente daquele dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dispozitivele autentificate în același cont iCloud și cu sincronizarea activă. „Văzut ultima dată” reflectă cea mai recentă trimitere de la acel dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Устройства, вошедшие в ту же учётную запись iCloud с включённой синхронизацией. «Последняя активность» показывает самую свежую отправку с этого устройства."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อุปกรณ์ที่ลงชื่อเข้าใช้บัญชี iCloud เดียวกันและเปิดใช้งานการซิงค์ เห็นล่าสุดสะท้อนการส่งข้อมูลครั้งล่าสุดจากอุปกรณ์นั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı iCloud hesabında oturum açmış ve eşitlemesi etkin aygıtlar. Son görülme, o aygıttan gelen en son gönderimi yansıtır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录到同一 iCloud 账号且启用了同步的设备。最近活跃反映该设备最近一次推送的时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登入同一個 iCloud 帳號且已啟用同步的裝置。「上次出現」代表該裝置最近一次上傳的時間。"
          }
        }
      }
    },
