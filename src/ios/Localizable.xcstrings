    "Scale fonts for chat input, message content, and general app text. Changes apply immediately." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaliert Schriftarten für Chat-Eingabe, Nachrichteninhalte und allgemeinen App-Text. Änderungen werden sofort angewendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scale fonts for chat input, message content, and general app text. Changes apply immediately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el tamaño de fuente del campo de entrada del chat, del contenido de los mensajes y del texto general de la app. Los cambios se aplican de inmediato."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-scale ang font para sa chat input, nilalaman ng mensahe, at pangkalahatang text ng app. Agad na magkakabisa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste la taille des polices pour la saisie, le contenu des messages et le texte général de l'application. Les changements s'appliquent immédiatement."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skalirajte fontove za unos razgovora, sadržaj poruka i općeniti tekst aplikacije. Promjene se primjenjuju odmah."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skalakan font untuk input obrolan, isi pesan, dan teks aplikasi umum. Perubahan langsung berlaku."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャット入力、メッセージ内容、アプリテキストのフォントサイズを調整します。変更は即座に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "채팅 입력, 메시지 내용, 일반 앱 텍스트의 글꼴 크기를 조절합니다. 변경 사항이 즉시 적용됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skalakan fon untuk input sembang, kandungan mesej, dan teks apl umum. Perubahan berkuat kuasa serta-merta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaluj czcionki pola czatu, treści wiadomości i ogólnego tekstu aplikacji. Zmiany są stosowane natychmiast."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste o tamanho da fonte do campo de conversa, do conteúdo das mensagens e do texto geral do app. As mudanças valem imediatamente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scalează textul pentru câmpul de conversație, conținutul mesajelor și textul general al aplicației. Modificările se aplică imediat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Масштабирование шрифтов для поля ввода, содержимого сообщений и общего текста приложения. Изменения применяются сразу."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับขนาดตัวอักษรสำหรับช่องป้อนแชท เนื้อหาข้อความ และข้อความทั่วไปในแอป การเปลี่ยนแปลงมีผลทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbet girişi, mesaj içeriği ve genel uygulama metni için yazı tipi boyutunu ayarlayın. Değişiklikler hemen uygulanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整聊天输入、消息内容和应用文本的字体大小。更改立即生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調整聊天輸入、訊息內容和應用文字的字體大小。更改立即生效。"
          }
        }
      }
    },
