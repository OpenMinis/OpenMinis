    "This JSON file looks like an exported provider configuration. Import it as a new provider, or add it to the chat as a file attachment?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese JSON-Datei sieht wie eine exportierte Anbieter-Konfiguration aus. Als neuen Anbieter importieren oder als Dateianhang zum Chat hinzufügen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This JSON file looks like an exported provider configuration. Import it as a new provider, or add it to the chat as a file attachment?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo JSON parece una configuración de proveedor exportada. ¿Quieres importarlo como un proveedor nuevo o añadirlo al chat como archivo adjunto?"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mukhang na-export na provider configuration ang JSON file na ito. I-import ito bilang bagong provider, o idagdag sa chat bilang file attachment?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier JSON ressemble à une configuration de fournisseur exportée. L'importer comme nouveau fournisseur ou l'ajouter comme pièce jointe ?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova JSON datoteka izgleda kao izvezena konfiguracija pružatelja. Želite li je uvesti kao novog pružatelja ili je dodati u razgovor kao privitak?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File JSON ini tampak seperti konfigurasi penyedia yang diekspor. Impor sebagai penyedia baru, atau tambahkan ke obrolan sebagai lampiran file?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このJSONファイルはエクスポートされたプロバイダ設定のようです。新しいプロバイダとしてインポートしますか、それともチャットの添付ファイルとして追加しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 JSON 파일은 내보낸 공급자 구성으로 보입니다. 새 공급자로 가져오시겠습니까, 아니면 채팅 첨부 파일로 추가하시겠습니까?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
