    "\"%@\" already has a value. Replace it with \"%@\"?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ hat bereits einen Wert. Durch „%2$@“ ersetzen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "\"%1$@\" already has a value. Replace it with \"%2$@\"?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » a déjà une valeur. La remplacer par « %2$@ » ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」にはすでに値があります。「%2$@」で置き換えますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”에 이미 값이 있습니다. “%2$@”(으)로 바꾸시겠습니까?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" уже имеет значение. Заменить его на \"%2$@\"?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” 已有值。是否替换为 “%2$@”？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」已有值。是否替換為「%2$@」？"
          }
        }
      }
    },
    "\"%@\" has been copied to your sessions. You can find it in the main session list." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wurde in Ihre Sitzungen kopiert. Sie finden es in der Hauptsitzungsliste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" has been copied to your sessions. You can find it in the main session list."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a été copié vers vos sessions. Vous le trouverez dans la liste des sessions."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」がセッションにコピーされました。メインのセッション一覧で確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”이(가) 세션에 복사되었습니다. 메인 세션 목록에서 확인할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" скопирована в ваши сессии. Вы найдёте её в основном списке сессий."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 已复制到您的会话。可以在主会话列表中找到它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」已複製到您的工作階段。可以在主工作階段列表中找到它。"
          }
        }
      }
    },
    "\"%@\" is already installed. Update to the latest version?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist bereits installiert. Auf die neueste Version aktualisieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is already installed. Update to the latest version?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est déjà installé. Mettre à jour vers la dernière version ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はすでにインストールされています。最新バージョンに更新しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”이(가) 이미 설치되어 있습니다. 최신 버전으로 업데이트하시겠습니까?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" уже установлено. Обновить до последней версии?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 已安装。是否更新到最新版本？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」已安裝。是否更新到最新版本？"
          }
        }
      }
    },
    "\"Automatic\" uses the system icon which adapts to Dark Mode on iOS 18+." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ verwendet das Systemsymbol, das sich auf iOS 18+ an den Dunkelmodus anpasst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Automatic\" uses the system icon which adapts to Dark Mode on iOS 18+."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Automatique » utilise l'icône système qui s'adapte au mode sombre sur iOS 18+."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」はシステムアイコンを使用し、iOS 18+でダークモードに対応します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"자동\"은 iOS 18+에서 다크 모드에 맞게 변하는 시스템 아이콘을 사용합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Автоматически» использует системный значок, который адаптируется к тёмному режиму на iOS 18+."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自动」使用系统图标，在 iOS 18+ 上自动适配深色模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」使用系統圖標，在 iOS 18+ 上自動適配深色模式。"
          }
        }
      }
    },
