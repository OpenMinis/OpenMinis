        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu mesaj ve sonrasındaki tüm mesajlar silinecek. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这条消息及其之后的所有消息都将被删除，此操作无法撤销。"
          }
        },
        "zh-Hant" : {
