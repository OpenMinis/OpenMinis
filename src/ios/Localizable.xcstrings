        }
      }
    },
    "Backups are stored in iCloud Drive and sync across your devices. Restoring will replace your current local data." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherungen werden in iCloud Drive gespeichert und über Ihre Geräte synchronisiert. Beim Wiederherstellen werden Ihre aktuellen lokalen Daten ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups are stored in iCloud Drive and sync across your devices. Restoring will replace your current local data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad se guardan en iCloud Drive y se sincronizan entre tus dispositivos. Al restaurar se reemplazarán tus datos locales actuales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes sont stockées dans iCloud Drive et synchronisées entre vos appareils. La restauration remplacera vos données locales actuelles."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップは iCloud Drive に保存され、デバイス間で同期されます。復元すると、現在のローカルデータが置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업은 iCloud Drive에 저장되고 기기 간에 동기화됩니다. 복원하면 현재 로컬 데이터가 교체됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервные копии хранятся в iCloud Drive и синхронизируются между вашими устройствами. Восстановление заменит текущие локальные данные."
          }
        },
        "zh-Hans" : {
