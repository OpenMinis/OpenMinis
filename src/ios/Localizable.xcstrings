    "Clear your custom display name and max output tokens, restoring the values reported by the provider." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt deinen benutzerdefinierten Anzeigenamen und die maximalen Ausgabe-Tokens zurück auf die vom Anbieter gemeldeten Werte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear your custom display name and max output tokens, restoring the values reported by the provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra el nombre personalizado y el máximo de tokens de salida, y restaura los valores indicados por el proveedor."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-clear ang custom mong display name at max na output tokens, para maibalik ang mga halagang iniulat ng provider."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacez votre nom d'affichage personnalisé et le nombre maximum de jetons de sortie, restaurant les valeurs signalées par le fournisseur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrišite vlastiti prikazani naziv i maksimalan broj izlaznih tokena te vratite vrijednosti koje prijavljuje pružatelj usluge."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersihkan nama tampilan dan token keluaran maks kustom Anda, memulihkan nilai yang dilaporkan penyedia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタム表示名と最大出力トークン数をクリアし、プロバイダーが報告する値に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 지정 표시 이름 및 최대 출력 토큰을 지우고 공급자가 보고한 값으로 복원합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kosongkan nama paparan dan token output maks tersuai anda, memulihkan nilai yang dilaporkan pembekal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczyść własną nazwę i limit tokenów wyjściowych, przywracając wartości zgłoszone przez dostawcę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpe o nome de exibição personalizado e os tokens máximos de saída, restaurando os valores informados pelo provedor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Șterge numele afișat personalizat și numărul maxim de tokenuri, restaurând valorile raportate de furnizor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очистить ваше пользовательское отображаемое имя и максимальное число выходных токенов, восстановив значения, заданные провайдером."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ล้างชื่อที่แสดงและโทเคนเอาต์พุตสูงสุดที่คุณกำหนดเอง เพื่อคืนค่าที่ผู้ให้บริการแจ้งไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel görünen adınızı ve maks çıkış token'ınızı temizleyip sağlayıcının bildirdiği değerleri geri yükleyin."
