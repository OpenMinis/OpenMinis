        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите конкретный голос для каждого языка. Загрузить дополнительные голоса можно в «Настройки» > «Универсальный доступ» > «Устный контент» > «Голоса»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为每种语言选择特定语音。在「设置 > 辅助功能 > 朗读内容 > 语音」中下载更多语音。"
