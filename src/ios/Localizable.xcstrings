    "Tap the name or folder to change it. Connection details and the password can't be edited — remove the server and add it again to change those." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the name or folder to change it. Connection details and the password can't be edited — remove the server and add it again to change those."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el nombre o la carpeta para cambiarlo. Los datos de conexión y la contraseña no se pueden editar: elimina el servidor y vuelve a añadirlo para cambiarlos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击名称或文件夹即可修改。连接信息和密码不支持编辑 —— 如需更改，请移除该服务器后重新添加。"
          }
        }
      }
    },
    "Tap the name or folder to change them, or edit the connection to change the address, share and password." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the name or folder to change them, or edit the connection to change the address, share and password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el nombre o la carpeta para cambiarlos, o edita la conexión para cambiar la dirección, el recurso compartido y la contraseña."
          }
        },
        "zh-Hans" : {
