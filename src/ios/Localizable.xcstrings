    "Leave blank to keep the current password." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave blank to keep the current password."
          }
        },
        "es" : {
          "stringUnit" : {
