    "Specify a model or model group to use. Leave empty to use the app default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib ein zu verwendendes Modell oder eine Modellgruppe an. Leer lassen, um den App-Standard zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Specify a model or model group to use. Leave empty to use the app default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica el modelo o grupo de modelos que se usará. Déjalo vacío para usar el valor predeterminado de la app."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukuyin ang model o model group na gagamitin. Iwanang blangko para sa default ng app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique un modèle ou un groupe de modèles à utiliser. Laisse vide pour utiliser la valeur par défaut de l’app."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navedite model ili grupu modela koja će se koristiti. Ostavite prazno za zadanu postavku aplikacije."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tentukan model atau grup model yang dipakai. Kosongkan untuk memakai bawaan aplikasi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用するモデルまたはモデルグループを指定します。空欄にするとアプリのデフォルトを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용할 모델 또는 모델 그룹을 지정하세요. 비워 두면 앱 기본값을 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tentukan model atau kumpulan model yang digunakan. Biarkan kosong untuk lalai apl."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskaż model lub grupę modeli. Pozostaw puste, aby użyć ustawienia domyślnego aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Especifique um modelo ou grupo de modelos. Deixe vazio para usar o padrão do app."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Specifică modelul sau grupul de modele de folosit. Lasă gol pentru valoarea implicită a aplicației."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Укажите модель или группу моделей для использования. Оставьте пустым, чтобы использовать значение приложения по умолчанию."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระบุโมเดลหรือกลุ่มโมเดลที่จะใช้ เว้นว่างไว้เพื่อใช้ค่าเริ่มต้นของแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kullanılacak modeli veya model grubunu belirtin. Uygulama varsayılanı için boş bırakın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定要使用的模型或模型分组。留空则使用应用默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定要使用的模型或模型分組。留空則使用應用程式預設值。"
          }
        }
      }
    },
