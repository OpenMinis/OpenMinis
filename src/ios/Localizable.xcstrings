    "Delete \"%@\"? Any default, voice, or vision selection pointing at this group will be cleared. The models themselves are not deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ löschen? Alle Standard-, Sprach- oder Bildauswahlen, die auf diese Gruppe verweisen, werden zurückgesetzt. Die Modelle selbst werden nicht gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete \"%@\"? Any default, voice, or vision selection pointing at this group will be cleared. The models themselves are not deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar \"%@\"? Se borrará cualquier selección predeterminada, de voz o de visión que apunte a este grupo. Los modelos en sí no se eliminan."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanggalin ang \"%@\"? Ic-clear ang anumang default, voice, o vision na pagpiling nakaturo sa group na ito. Hindi tatanggalin ang mga model mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer « %@ » ? Toute sélection par défaut, vocale ou visuelle pointant vers ce groupe sera effacée. Les modèles eux-mêmes ne sont pas supprimés."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrisati \"%@\"? Svaki zadani, glasovni ili vizualni odabir koji upućuje na ovu grupu bit će poništen. Sami modeli neće biti obrisani."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus \"%@\"? Setiap pilihan bawaan, suara, atau visual yang mengarah ke grup ini akan dibersihkan. Model itu sendiri tidak dihapus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を削除しますか？このグループを参照しているデフォルト、音声、画像の選択はすべて解除されます。モデル自体は削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'을(를) 삭제하시겠습니까? 이 그룹을 가리키는 기본, 음성, 이미지 선택이 모두 해제됩니다. 모델 자체는 삭제되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padam \"%@\"? Sebarang pilihan lalai, suara, atau visi yang menunjuk ke kumpulan ini akan dikosongkan. Model itu sendiri tidak dipadam."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć: \"%@\"? Wszelkie ustawienia domyślne, głosowe lub wizualne wskazujące tę grupę zostaną wyczyszczone. Same modele nie zostaną usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir \"%@\"? Qualquer seleção padrão, de voz ou de imagem que aponte para este grupo será limpa. Os modelos em si não são excluídos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ștergi \"%@\"? Orice selecție implicită, vocală sau de imagine care indică acest grup va fi anulată. Modelele în sine nu sunt șterse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить «%@»? Любой выбор по умолчанию, голосовой или визуальный, указывающий на эту группу, будет сброшен. Сами модели не удаляются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบ \"%@\" หรือไม่ การเลือกค่าเริ่มต้น เสียง หรือภาพที่ชี้มายังกลุ่มนี้จะถูกล้าง ตัวโมเดลเองจะไม่ถูกลบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silinsin mi: \"%@\"? Bu grubu gösteren varsayılan, ses veya görüntü seçimleri temizlenir. Modellerin kendisi silinmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除“%@”？指向该分组的默认、语音或视觉选择都会被清除。分组内的模型本身不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要刪除「%@」嗎？所有指向這個群組的預設、語音或圖片選項都會被清除，模型本身不會被刪除。"
          }
        }
      }
    },
