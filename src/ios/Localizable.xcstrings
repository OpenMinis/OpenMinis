    "This will delete the group. Model entries and provider instances are not affected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gruppe wird gelöscht. Modelleinträge und Anbieterinstanzen sind nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will delete the group. Model entries and provider instances are not affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará el grupo. Las entradas de modelos y las instancias de proveedores no se ven afectadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le groupe sera supprimé. Les entrées de modèle et les instances de fournisseur ne sont pas affectées."
          }
        },
        "ja" : {
