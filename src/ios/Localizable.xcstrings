    "Total is the app's full container size and should match the figure iOS Settings shows for Minis. \"Other\" covers everything not itemized above, so the categories always add up to the total." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total is the app's full container size and should match the figure iOS Settings shows for Minis. \"Other\" covers everything not itemized above, so the categories always add up to the total."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukupno je puna veličina spremnika aplikacije i trebala bi odgovarati brojci koju iOS Postavke prikazuju za Minis. \"Ostalo\" obuhvaća sve što nije pojedinačno navedeno iznad, pa je zbroj kategorija uvijek jednak ukupnom iznosu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“总计”为 App 容器的完整占用，应与 iOS 系统设置中显示的 Minis 占用一致。“其他”涵盖上面未单独列出的所有内容，因此各分类之和始终等于总计。"
          }
        }
      }
    },
