          }
        }
      }
    },
    "This message and all messages after it will be deleted. This cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Nachricht und alle nachfolgenden Nachrichten werden gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This message and all messages after it will be deleted. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este mensaje y todos los posteriores se eliminarán. Esta acción no se puede deshacer."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tatanggalin ang mensaheng ito at lahat ng kasunod nito. Hindi na ito maibabalik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce message et tous les messages suivants seront supprimés. Cette action est irréversible."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova poruka i sve poruke nakon nje bit će obrisane. Ovo se ne može poništiti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesan ini dan semua pesan setelahnya akan dihapus. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このメッセージとそれ以降のすべてのメッセージが削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 메시지와 이후의 모든 메시지가 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesej ini dan semua mesej selepasnya akan dipadam. Ini tidak boleh dibatalkan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wiadomość i wszystkie następne zostaną usunięte. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta mensagem e todas as posteriores serão excluídas. Isso não pode ser desfeito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acest mesaj și toate mesajele de după el vor fi șterse. Acțiunea nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это сообщение и все последующие сообщения будут удалены. Отменить это действие нельзя."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความนี้และข้อความทั้งหมดหลังจากนี้จะถูกลบ การกระทำนี้ย้อนกลับไม่ได้"
