    "Images, videos, or files to attach to the prompt. Accepts output from previous Shortcuts actions (e.g. filtered photos or documents)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilder, Videos oder Dateien zum Anhängen an den Prompt. Akzeptiert Ausgaben vorheriger Kurzbefehl-Aktionen (z. B. gefilterte Fotos oder Dokumente)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images, videos, or files to attach to the prompt. Accepts output from previous Shortcuts actions (e.g. filtered photos or documents)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imágenes, videos o archivos para adjuntar al prompt. Acepta la salida de acciones previas de Atajos (por ejemplo, fotos o documentos filtrados)."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga larawan, video, o file na ilalakip sa prompt. Tumatanggap ng output mula sa naunang Shortcuts action (hal. mga na-filter na litrato o dokumento)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Images, vidéos ou fichiers à joindre au prompt. Accepte la sortie des actions Raccourcis précédentes (ex. photos filtrées ou documents)."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slike, videozapisi ili datoteke koje se prilažu upitu. Prihvaća izlaz prethodnih radnji u Prečacima (npr. filtrirane fotografije ili dokumente)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar, video, atau file untuk dilampirkan ke prompt. Menerima keluaran dari tindakan Pintasan sebelumnya (mis. foto atau dokumen terfilter)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプトに添付する画像、動画、またはファイル。前のショートカットアクションからの出力を受け付けます（例：フィルタリングされた写真やドキュメント）。"
          }
        },
        "ko" : {
