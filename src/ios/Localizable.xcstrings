    "Runs a predefined Minis task like sleep analysis, weather check, or morning briefing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt eine vordefinierte Minis-Aufgabe wie Schlafanalyse, Wettercheck oder Morgenbriefing aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs a predefined Minis task like sleep analysis, weather check, or morning briefing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta una tarea predefinida de Minis, como análisis del sueño, consulta del tiempo o resumen matutino."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagpapatakbo ng nakatakdang Minis task gaya ng pagsusuri ng tulog, pagtingin sa panahon, o briefing sa umaga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécute une tâche Minis prédéfinie comme l'analyse du sommeil, la météo ou le briefing matinal."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokreće unaprijed definirani Minis zadatak poput analize spavanja, provjere vremena ili jutarnjeg pregleda."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjalankan tugas Minis yang telah ditentukan seperti analisis tidur, cek cuaca, atau ringkasan pagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠分析、天気確認、朝のブリーフィングなど、事前定義された Minis タスクを実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면 분석, 날씨 확인, 아침 브리핑 등 사전 정의된 Minis 작업을 실행합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menjalankan tugas Minis yang telah ditetapkan seperti analisis tidur, semakan cuaca, atau taklimat pagi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamia gotowe zadanie Minis, np. analizę snu, sprawdzenie pogody czy poranny przegląd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa uma tarefa predefinida do Minis, como análise do sono, previsão do tempo ou resumo matinal."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rulează o sarcină Minis predefinită, ca analiza somnului, verificarea vremii sau rezumatul de dimineață."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускает предопределённую задачу Minis, например анализ сна, проверку погоды или утреннюю сводку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรียกใช้งาน Minis ที่กำหนดไว้ล่วงหน้า เช่น วิเคราะห์การนอน ดูสภาพอากาศ หรือสรุปข่าวเช้า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
