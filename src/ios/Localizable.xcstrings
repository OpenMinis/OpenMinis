    "This will backup /root directory before resetting. You can restore it later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Verzeichnis /root wird vor dem Zurücksetzen gesichert. Sie können es später wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will backup /root directory before resetting. You can restore it later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto hará una copia de seguridad del directorio /root antes de restablecer. Podrás restaurarla más tarde."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iba-backup nito ang /root directory bago mag-reset. Puwede mo itong i-restore mamaya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le répertoire /root sera sauvegardé avant la réinitialisation. Vous pourrez le restaurer plus tard."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo će izraditi sigurnosnu kopiju direktorija /root prije resetiranja. Kasnije je možete vratiti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan mencadangkan direktori /root sebelum menyetel ulang. Anda dapat memulihkannya nanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リセット前に /root ディレクトリをバックアップします。後で復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재설정 전에 /root 디렉토리를 백업합니다. 나중에 복원할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menyandarkan direktori /root sebelum menetapkan semula. Anda boleh memulihkannya kemudian."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed resetem zostanie utworzona kopia katalogu /root. Możesz ją później przywrócić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso vai fazer backup do diretório /root antes de redefinir. Você pode restaurá-lo depois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se va face o copie a directorului /root înainte de resetare. O poți restaura mai târziu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед сбросом будет создана резервная копия папки /root. Её можно восстановить позже."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกระทำนี้จะสำรองไดเรกทอรี /root ก่อนรีเซ็ต คุณกู้คืนได้ภายหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem sıfırlamadan önce /root dizinini yedekler. Daha sonra geri yükleyebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重置前将备份 /root 目录。稍后可以恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重設前將備份 /root 目錄。稍後可以恢復。"
          }
        }
      }
    },
    "This will backup your /root directory, then reset the rootfs. You can restore the backup later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr /root-Verzeichnis wird gesichert, dann wird das Rootfs zurückgesetzt. Sie können die Sicherung später wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will backup your /root directory, then reset the rootfs. You can restore the backup later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto hará una copia de seguridad de tu directorio /root y luego restablecerá el rootfs. Podrás restaurar la copia más tarde."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iba-backup nito ang /root directory mo, tapos ire-reset ang rootfs. Puwede mong i-restore ang backup mamaya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier /root sera sauvegardé, puis le rootfs sera réinitialisé. Vous pourrez restaurer la sauvegarde plus tard."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo će izraditi sigurnosnu kopiju vašeg direktorija /root, a zatim resetirati rootfs. Kopiju možete kasnije vratiti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan mencadangkan direktori /root Anda, lalu menyetel ulang rootfs. Anda dapat memulihkan cadangannya nanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
