    "Add the server your backups were saved to. Servers added here are also available as backup destinations." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge den Server hinzu, auf dem deine Sicherungen gespeichert wurden. Hier hinzugefügte Server stehen auch als Sicherungsziele zur Verfügung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the server your backups were saved to. Servers added here are also available as backup destinations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el servidor donde se guardaron tus copias de seguridad. Los servidores añadidos aquí también están disponibles como destinos de copia de seguridad."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idagdag ang server kung saan na-save ang mga backup mo. Available din bilang destinasyon ng backup ang mga server dito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez le serveur sur lequel vos sauvegardes ont été enregistrées. Les serveurs ajoutés ici sont aussi proposés comme destinations de sauvegarde."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte poslužitelj na koji su spremljene vaše sigurnosne kopije. Poslužitelji dodani ovdje dostupni su i kao odredišta sigurnosnih kopija."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan server tempat cadangan Anda disimpan. Server yang ditambahkan di sini juga tersedia sebagai tujuan cadangan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップの保存先サーバを追加します。ここで追加したサーバは、バックアップの保存先としても使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업이 저장된 서버를 추가하십시오. 여기서 추가한 서버는 백업 대상으로도 사용할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah server tempat sandaran anda disimpan. Server yang ditambah di sini juga tersedia sebagai destinasi sandaran."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj serwer, na którym zapisano Twoje kopie. Serwery dodane tutaj są też dostępne jako miejsca docelowe kopii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o servidor onde seus backups foram salvos. Os servidores adicionados aqui também ficam disponíveis como destinos de backup."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă serverul pe care au fost salvate copiile tale. Serverele adăugate aici sunt disponibile și ca destinații de rezervă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте сервер, на который сохранялись ваши копии. Добавленные здесь серверы также доступны как назначения для копий."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มเซิร์ฟเวอร์ที่บันทึกข้อมูลสำรองของคุณไว้ เซิร์ฟเวอร์ที่เพิ่มที่นี่ใช้เป็นปลายทางสำรองข้อมูลได้ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedeklerinizin kaydedildiği sunucuyu ekleyin. Buraya eklenen sunucular yedek hedefi olarak da kullanılabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加保存备份的服务器。在此添加的服务器也可用作备份目的地。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入你儲存備份的伺服器。在這裡加入的伺服器也可以當作備份目的地。"
          }
        }
      }
    },
