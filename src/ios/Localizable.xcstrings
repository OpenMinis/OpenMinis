    "Safari will open the launcher page. Tap the Share button → Add to Home Screen to pin the icon." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari öffnet die Launcher-Seite. Tippe auf die Teilen-Taste → Zum Home-Bildschirm, um das Symbol anzuheften."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari will open the launcher page. Tap the Share button → Add to Home Screen to pin the icon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari abrirá la página del lanzador. Toca el botón Compartir → Añadir a pantalla de inicio para fijar el icono."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bubuksan ng Safari ang launcher page. I-tap ang Share button → Add to Home Screen para i-pin ang icon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari ouvrira la page du lanceur. Appuie sur le bouton Partager → Ajouter à l’écran d’accueil pour épingler l’icône."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari će otvoriti stranicu pokretača. Dodirnite gumb Dijeli → Dodaj na početni zaslon da prikvačite ikonu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari akan membuka halaman peluncur. Ketuk tombol Bagikan → Tambahkan ke Layar Utama untuk menyematkan ikonnya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari がランチャーページを開きます。共有ボタン →「ホーム画面に追加」をタップしてアイコンを固定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari가 실행기 페이지를 엽니다. 공유 버튼 → 홈 화면에 추가를 눌러 아이콘을 고정하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari akan membuka halaman pelancar. Ketik butang Kongsi → Tambah ke Skrin Utama untuk menyematkan ikonnya."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari otworzy stronę uruchamiającą. Dotknij przycisku Udostępnij → Do ekranu początkowego, aby przypiąć ikonę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Safari vai abrir a página do atalho. Toque em Compartilhar → Adicionar à Tela de Início para fixar o ícone."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari va deschide pagina de lansare. Atinge butonul Partajează → Adaugă la ecranul principal pentru a fixa pictograma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari откроет страницу запуска. Нажмите кнопку «Поделиться» → «На экран “Домой”», чтобы закрепить значок."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari จะเปิดหน้าตัวเปิด แตะปุ่มแชร์ → เพิ่มไปยังหน้าจอโฮม เพื่อปักหมุดไอคอน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari başlatıcı sayfasını açar. Simgeyi sabitlemek için Paylaş düğmesi → Ana Ekrana Ekle'ye dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari 将打开启动器页面。点按分享按钮 →“添加到主屏幕”即可固定图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari 將開啟啟動器頁面。點按分享按鈕 →「加入主畫面」即可固定圖示。"
          }
        }
      }
    },
