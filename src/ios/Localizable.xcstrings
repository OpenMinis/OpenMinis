            "value" : "iCloud 동기화가 데이터를 주고받을 때 동기화 이벤트가 기록됩니다. 최대 1,000개의 항목이 보관됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peristiwa penyegerakan direkodkan semasa iCloud menghantar dan menerima data. Sehingga 1,000 entri disimpan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdarzenia są zapisywane w miarę wysyłania i odbierania danych przez iCloud. Przechowywanych jest do 1000 wpisów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os eventos são registrados conforme o iCloud envia e recebe dados. São mantidas até 1.000 entradas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evenimentele se înregistrează pe măsură ce iCloud trimite și primește date. Se păstrează până la 1.000 de intrări."
          }
        },
        "ru" : {
          "stringUnit" : {
