    "This provider uses an official protocol, so its thinking parameters are maintained by Minis. Custom rules apply to OpenAI-compatible providers on the Chat Completions API." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Anbieter verwendet ein offizielles Protokoll, daher werden seine Denkparameter von Minis gepflegt. Eigene Regeln gelten für OpenAI-kompatible Anbieter über die Chat-Completions-API."
          }
        },
        "en" : {
          "stringUnit" : {
