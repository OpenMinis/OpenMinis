    "Opens Minis, sends your prompt, and shows the conversation. Starts a new session, or continues an existing one when you pick a session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet Minis, sendet deine Eingabe und zeigt die Unterhaltung an. Startet eine neue Sitzung oder setzt eine bestehende fort, wenn du eine Sitzung auswählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens Minis, sends your prompt, and shows the conversation. Starts a new session, or continues an existing one when you pick a session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Minis, envía tu prompt y muestra la conversación. Inicia una sesión nueva o continúa una existente si eliges una sesión."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bubuksan ang Minis, ipapadala ang prompt mo, at ipapakita ang usapan. Magsisimula ng bagong session, o magpapatuloy sa umiiral kapag pumili ka ng session."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Minis, envoie ton invite et affiche la conversation. Démarre une nouvelle session, ou en poursuit une existante si tu choisis une session."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvara Minis, šalje vaš prompt i prikazuje razgovor. Započinje novu sesiju ili nastavlja postojeću kada odaberete sesiju."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka Minis, mengirim prompt Anda, dan menampilkan percakapannya. Memulai sesi baru, atau melanjutkan sesi yang ada bila Anda memilih satu sesi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis を開いてプロンプトを送信し、会話を表示します。新しいセッションを開始するか、セッションを選ぶと既存のものを続行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis를 열어 프롬프트를 보내고 대화를 표시합니다. 새 세션을 시작하거나, 세션을 선택하면 기존 세션을 이어갑니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuka Minis, menghantar prompt anda, dan menunjukkan perbualannya. Memulakan sesi baharu, atau meneruskan sesi sedia ada apabila anda memilih satu sesi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera Minis, wysyła prompt i pokazuje rozmowę. Rozpoczyna nową sesję albo kontynuuje istniejącą, jeśli ją wskażesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o Minis, envia seu prompt e mostra a conversa. Começa uma nova sessão ou continua uma existente, se você escolher uma."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deschide Minis, trimite promptul și afișează conversația. Începe o sesiune nouă sau o continuă pe cea existentă, dacă alegi una."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает Minis, отправляет ваш запрос и показывает диалог. Начинает новую сессию или продолжает существующую, если вы выберете сессию."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิด Minis ส่งพรอมต์ของคุณ และแสดงการสนทนา จะเริ่มเซสชันใหม่ หรือดำเนินการต่อจากเซสชันเดิมเมื่อคุณเลือกเซสชัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis'i açar, isteminizi gönderir ve sohbeti gösterir. Yeni bir oturum başlatır ya da bir oturum seçtiğinizde var olanı sürdürür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 Minis，发送你的提示词并显示对话。开始新会话，或在你选择某个会话时继续该会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟 Minis，傳送你的提示詞並顯示對話。開始新工作階段，或在你選擇某個工作階段時繼續該工作階段。"
          }
        }
      }
    },
