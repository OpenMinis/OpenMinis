        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、ロックされたセッションは内容を表示する前に %@（またはデバイスのパスコード）を要求します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용하면 잠긴 세션은 내용을 표시하기 전에 %@(또는 기기 암호)가 필요합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila diaktifkan, sesi berkunci memerlukan %@ (atau kod laluan peranti) sebelum kandungannya didedahkan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy włączone, zablokowane sesje wymagają: %@ (lub kodu urządzenia) przed pokazaniem zawartości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, as sessões bloqueadas exigem %@ (ou o código do dispositivo) antes de mostrar o conteúdo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când e activat, sesiunile blocate cer %@ (sau codul dispozitivului) înainte de a-și afișa conținutul."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включено, для показа содержимого заблокированных сессий требуется %@ (или код-пароль устройства)."
          }
