          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lecturas y escrituras de memoria realizadas por Minis Agent durante esta sesión."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga pagbasa at pagsulat sa memory na ginawa ng agent sa session na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lectures et écritures mémoire effectuées par Minis Agent pendant cette session."
          }
        },
        "hr" : {
