          "stringUnit" : {
            "state" : "translated",
            "value" : "Prekratko — zadržite i govorite malo dulje"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu singkat — tahan dan bicara sedikit lebih lama"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短すぎます — もう少し長く話してください"
