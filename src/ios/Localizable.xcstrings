            "value" : "Kurallar yukarıdan aşağıya değerlendirilir. Modelle eşleşen ilk kural, hangi düşünme parametrelerinin gönderileceğini belirler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
