          "stringUnit" : {
            "state" : "translated",
            "value" : "Ștergerea cookie-urilor te va deconecta de pe toate site-urile din browserul Minis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление файлов cookie приведёт к выходу из всех сайтов в браузере Minis."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การล้างคุกกี้จะทำให้คุณออกจากระบบทุกเว็บไซต์ในเบราว์เซอร์ Minis"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çerezleri temizlemek, Minis tarayıcısındaki tüm sitelerden çıkış yapmanıza yol açar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除 Cookie 将退出 Minis 浏览器中所有网站的登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除 Cookie 將退出 Minis 瀏覽器中所有網站的登入。"
          }
        }
      }
    },
