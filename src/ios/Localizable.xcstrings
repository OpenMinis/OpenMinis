    "Use a static bearer token instead of the OAuth sign-in flow. Useful with custom proxy endpoints." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie ein statisches Bearer Token anstelle des OAuth-Anmeldeflusses. Nützlich mit benutzerdefinierten Proxy-Endpoints."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a static bearer token instead of the OAuth sign-in flow. Useful with custom proxy endpoints."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser un jeton Bearer statique au lieu du flux OAuth. Utile avec des endpoints proxy personnalisés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OAuthサインインの代わりに静態Bearerトークンを使用します。カスタムプロキシエンドポイントに便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OAuth 로그인 대신 정적 Bearer Token을 사용합니다. 사용자 정의 프록시 엔드포인트에 유용합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использовать статический bearer-токен вместо входа через OAuth. Удобно с произвольными прокси-эндпоинтами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用静态 Bearer Token 代替 OAuth 登录流程。适用于自定义代理端点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用靜態 Bearer Token 代替 OAuth 登錄流程。適用於自定義代理端點。"
          }
        }
      }
    },
