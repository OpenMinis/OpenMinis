    "Speech ignored while editing — finish editing first" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprache beim Bearbeiten ignoriert — beende zuerst die Bearbeitung"
