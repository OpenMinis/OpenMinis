    "Gets the current status of a Minis session, including whether the agent is still running, the latest message, and last tool call." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruft den aktuellen Status einer Minis-Sitzung ab, einschließlich ob der Agent noch läuft, die letzte Nachricht und den letzten Tool-Aufruf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gets the current status of a Minis session, including whether the Agent is still running, the latest message, and last tool call."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtiene el estado actual de una sesión de Minis, incluido si Minis Agent sigue en ejecución, el último mensaje y la última llamada a una herramienta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinukuha ang kasalukuyang status ng Minis session, kasama kung tumatakbo pa ang agent, ang pinakabagong mensahe, at huling tool call."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtient l'état actuel d'une session Minis, y compris si Minis Agent est encore en cours d'exécution, le dernier message et le dernier appel d'outil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dohvaća trenutni status Minis sesije, uključujući je li Agent još uvijek aktivan, posljednju poruku i posljednji poziv alata."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengambil status terkini sesi Minis, termasuk apakah agen masih berjalan, pesan terbaru, dan panggilan alat terakhir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis セッションの現在の状態を取得します。Agent がまだ実行中か、最新のメッセージ、最後のツール呼び出しを含みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis 세션의 현재 상태를 가져옵니다. Agent 실행 여부, 최신 메시지, 마지막 도구 호출 포함."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mendapatkan status semasa sesi Minis, termasuk sama ada ejen masih berjalan, mesej terkini, dan panggilan alat terakhir."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobiera bieżący stan sesji Minis: czy agent nadal działa, ostatnią wiadomość i ostatnie wywołanie narzędzia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtém o status atual de uma sessão do Minis, incluindo se o agente ainda está rodando, a última mensagem e a última chamada de ferramenta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obține starea curentă a unei sesiuni Minis, inclusiv dacă agentul încă rulează, ultimul mesaj și ultimul apel de unealtă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получает текущий статус сессии Minis, включая то, выполняется ли ещё Agent, последнее сообщение и последний вызов инструмента."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูสถานะปัจจุบันของเซสชัน Minis รวมถึงว่าเอเจนต์ยังทำงานอยู่หรือไม่ ข้อความล่าสุด และการเรียกเครื่องมือครั้งล่าสุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir Minis oturumunun geçerli durumunu alır: aracının hâlâ çalışıp çalışmadığı, son mesaj ve son araç çağrısı dahil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "获取 Minis 会话的当前状态，包括 Agent 是否仍在运行、最新消息和最后的工具调用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "獲取 Minis 工作階段的當前狀態，包括 Agent 是否仍在運行、最新訊息和最後的工具調用。"
          }
        }
      }
    },
