          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette connexion n’est pas privée"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この接続はプライベートではありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 연결은 비공개가 아닙니다"
          }
        },
        "ru" : {
