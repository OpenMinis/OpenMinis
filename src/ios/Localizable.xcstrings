    "Configure which models the agent uses, manage API keys & OAuth for each provider, and create model groups for fallback or load balancing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurieren Sie die Modelle von Minis Agent, verwalten Sie API Keys und OAuth für jeden KI-Anbieter und erstellen Sie Modellgruppen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure which models the Agent uses, manage API keys & OAuth for each provider, and create model groups for fallback or load balancing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura qué modelos usa Minis Agent, gestiona las claves de API y OAuth de cada proveedor, y crea grupos de modelos para conmutación o balanceo de carga."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-configure kung anong model ang gagamitin ng agent, pamahalaan ang mga API key at OAuth kada provider, at gumawa ng model group para sa fallback o load balancing."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez les modèles utilisés par Minis Agent, gérez les clés API et OAuth de chaque fournisseur AI, et créez des groupes de modèles."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odredite koje modele Agent koristi, upravljajte API ključevima i OAuth-om za svakog pružatelja usluge te izradite grupe modela za zamjenu ili raspodjelu opterećenja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurasikan model yang dipakai agen, kelola kunci API & OAuth tiap penyedia, dan buat grup model untuk cadangan atau penyeimbangan beban."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent が使用するモデルの設定、各AIプロバイダーのAPI KeyとOAuthの管理、フォールバックや負荷分散のためのモデルグループの作成ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent가 사용할 모델을 설정하고, 각 AI 공급자의 API Key와 OAuth를 관리하며, 대체 또는 부하 분산을 위한 모델 그룹을 만드세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurasi model yang digunakan ejen, urus kunci API & OAuth setiap pembekal, dan cipta kumpulan model untuk sandaran atau imbangan beban."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skonfiguruj modele używane przez agenta, zarządzaj kluczami API i OAuth dla każdego dostawcy oraz twórz grupy modeli do przełączania awaryjnego lub równoważenia obciążenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure quais modelos o agente usa, gerencie chaves de API e OAuth de cada provedor e crie grupos de modelos para fallback ou equilíbrio de carga."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurează ce modele folosește agentul, gestionează cheile API și OAuth pentru fiecare furnizor și creează grupuri de modele pentru rezervă sau echilibrarea încărcării."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте, какие модели использует Agent, управляйте ключами API и OAuth для каждого провайдера и создавайте группы моделей для резервирования или балансировки нагрузки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำหนดว่าเอเจนต์ใช้โมเดลใด จัดการคีย์ API และ OAuth ของผู้ให้บริการแต่ละราย และสร้างกลุ่มโมเดลสำหรับตัวสำรองหรือกระจายโหลด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aracının hangi modelleri kullanacağını yapılandırın, her sağlayıcı için API anahtarlarını ve OAuth'u yönetin, yedek veya yük dengeleme için model grupları oluşturun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置 Agent 使用的模型，管理各 AI 服务商的 API Key 和 OAuth，以及创建模型分组以实现回退或负载均衡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置智能體使用的模型，管理各 AI 服務商的 API Key 和 OAuth，以及創建模型分組以實現回退或負載均衡。"
          }
        }
      }
    },
