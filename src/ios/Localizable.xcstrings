    "Too short — hold on and speak a little longer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu kurz — halte gedrückt und sprich etwas länger"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too short — hold on and speak a little longer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiado corto: mantén pulsado y habla un poco más"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masyadong maikli — pindutin nang matagal at magsalita nang mas mahaba"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
