    "Depending on which provider you configure, your data will be sent directly to one or more of the following third-party services:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je nach konfiguriertem KI-Anbieter werden Ihre Daten direkt an einen oder mehrere der folgenden Drittanbieterdienste gesendet:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depending on which provider you configure, your data will be sent directly to one or more of the following third-party services:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Según el proveedor que configures, tus datos se enviarán directamente a uno o varios de los siguientes servicios de terceros:"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depende sa provider na iko-configure mo, direktang ipapadala ang datos mo sa isa o higit pa sa mga sumusunod na third-party na serbisyo:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selon le fournisseur AI que vous configurez, vos données seront envoyées directement à un ou plusieurs des services tiers suivants :"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovisno o tome kojeg pružatelja usluge postavite, vaši će se podaci slati izravno jednoj ili više sljedećih usluga trećih strana:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tergantung penyedia yang Anda konfigurasi, data Anda akan dikirim langsung ke satu atau beberapa layanan pihak ketiga berikut:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定したAIプロバイダーに応じて、データは以下のサードパーティサービスに直接送信されます："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구성한 AI 공급자에 따라 데이터가 다음 타사 서비스 중 하나 이상에 직접 전송됩니다:"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergantung pada pembekal yang anda konfigurasi, data anda akan dihantar terus ke satu atau lebih perkhidmatan pihak ketiga berikut:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zależnie od skonfigurowanego dostawcy Twoje dane trafią bezpośrednio do jednej lub kilku z następujących usług zewnętrznych:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dependendo do provedor que você configurar, seus dados serão enviados diretamente a um ou mais dos seguintes serviços de terceiros:"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "În funcție de furnizorul pe care îl configurezi, datele tale vor fi trimise direct către unul sau mai multe dintre următoarele servicii terțe:"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В зависимости от того, какого провайдера вы настроите, ваши данные будут отправляться напрямую в один или несколько следующих сторонних сервисов:"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขึ้นอยู่กับผู้ให้บริการที่คุณกำหนดค่า ข้อมูลของคุณจะถูกส่งตรงไปยังบริการภายนอกต่อไปนี้อย่างน้อยหนึ่งราย:"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapılandırdığınız sağlayıcıya bağlı olarak verileriniz doğrudan aşağıdaki üçüncü taraf hizmetlerden birine veya birkaçına gönderilir:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据您配置的 AI 服务商，您的数据将直接发送到以下一个或多个第三方服务："
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據您配置的 AI 服務商，您的資料將直接傳送到以下一個或多個第三方服務："
          }
        }
      }
    },
