    "Add an MCP server to give the agent extra tools. Tap + to add one manually or import a JSON config." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen MCP-Server hinzu, um dem Agent zusätzliche Werkzeuge zu geben. Tippe auf +, um manuell einen hinzuzufügen, oder importiere eine JSON-Konfiguration."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add an MCP server to give the Agent extra tools. Tap + to add one manually or import a JSON config."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un servidor MCP para dar herramientas adicionales a Minis Agent. Toca + para añadir uno manualmente o importar una configuración JSON."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng MCP server para bigyan ang agent ng dagdag na tool. I-tap ang + para magdagdag nang manual o mag-import ng JSON config."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un serveur MCP pour donner des outils supplémentaires à Minis Agent. Touchez + pour en ajouter un manuellement ou importez une configuration JSON."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte MCP poslužitelj da biste Agentu dali dodatne alate. Dodirnite + za ručno dodavanje ili uvezite JSON konfiguraciju."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan server MCP untuk memberi agen alat tambahan. Ketuk + untuk menambah manual atau mengimpor konfigurasi JSON."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP サーバを追加して、Agent に追加のツールを提供します。+ をタップして手動で追加するか、JSON 設定をインポートしてください。"
          }
