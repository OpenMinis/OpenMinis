          }
        }
      }
    },
    "This is an unofficial compatibility experiment. It is not authorized, endorsed or supported by GitHub, and Minis has no affiliation with GitHub." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is an unofficial compatibility experiment. It is not authorized, endorsed or supported by GitHub, and Minis has no affiliation with GitHub."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是一项非官方的兼容性实验，未获得 GitHub 的授权、认可或支持，Minis 与 GitHub 无任何从属关系。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
