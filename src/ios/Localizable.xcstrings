    "Show a live preview thumbnail alongside the tool status bar during agent execution." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt während der Agent-Ausführung eine Live-Vorschau-Miniatur neben der Werkzeug-Statusleiste an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a live preview thumbnail alongside the tool status bar during Agent execution."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una miniatura de vista previa en vivo junto a la barra de estado de herramientas mientras se ejecuta Minis Agent."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpakita ng live preview thumbnail sa tabi ng tool status bar habang tumatakbo ang agent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche une vignette d'aperçu en direct à côté de la barre d'état de l'outil pendant l'exécution de Minis Agent."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži sličicu pregleda uživo uz statusnu traku alata tijekom izvršavanja Agenta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan gambar mini pratinjau langsung di samping bilah status alat selama agen berjalan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 実行中、ツールステータスバーの横にライブプレビューサムネイルを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 실행 중 도구 상태 표시줄 옆에 실시간 미리보기 썸네일을 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan imej kecil pratonton langsung di sebelah bar status alat semasa ejen berjalan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj miniaturę podglądu na żywo obok paska stanu narzędzia w trakcie pracy agenta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar uma miniatura de prévia ao vivo junto à barra de status das ferramentas durante a execução do agente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează o miniatură live lângă bara de stare a uneltelor în timpul execuției agentului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать миниатюру предпросмотра в реальном времени рядом со строкой состояния инструментов во время выполнения Agent."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงภาพตัวอย่างแบบเรียลไทม์ข้างแถบสถานะเครื่องมือขณะเอเจนต์ทำงาน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aracı çalışırken araç durum çubuğunun yanında canlı önizleme küçük resmi göster."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Agent 执行期间，于工具状态栏旁显示实时预览缩略图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Agent 執行期間，於工具狀態欄旁顯示實時預覽縮略圖。"
          }
        }
      }
    },
    "Show a sticky title pill at the top of the chat once you scroll up to read history." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt oben im Chat eine angeheftete Titelpille an, sobald du nach oben scrollst, um den Verlauf zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a sticky title pill at the top of the chat once you scroll up to read history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una etiqueta de título fija en la parte superior del chat cuando te desplazas hacia arriba para leer el historial."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magpakita ng nakadikit na title pill sa itaas ng chat kapag nag-scroll ka pataas para magbasa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche une pastille de titre épinglée en haut de la discussion lorsque vous remontez pour lire l'historique."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikaži zalijepljenu oznaku s naslovom na vrhu razgovora kada se pomaknete gore radi čitanja povijesti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampilkan pil judul menetap di atas obrolan saat Anda menggulir ke atas membaca riwayat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴を読むために上にスクロールすると、チャット上部に固定タイトルピルを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록을 보기 위해 위로 스크롤하면 채팅 상단에 고정된 제목 알약을 표시합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan pil tajuk melekat di atas sembang apabila anda menatal ke atas membaca sejarah."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuj przypięty tytuł u góry czatu po przewinięciu w górę do historii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrar um título fixo no topo do chat quando você rolar para cima para ler o histórico."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afișează un titlu fixat în partea de sus a chatului când derulezi în sus prin istoric."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывать закреплённую плашку с заголовком вверху чата при прокрутке вверх для чтения истории."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงป้ายชื่อแบบติดหนึบด้านบนของแชทเมื่อคุณเลื่อนขึ้นเพื่ออ่านประวัติ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmişi okumak için yukarı kaydırdığınızda sohbetin üstünde sabit bir başlık rozeti göster."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上滚动查看历史时，在对话顶部显示一个吸顶的标题胶囊。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上捲動查看歷史時，在對話頂端顯示一個吸頂的標題膠囊。"
          }
        }
      }
    },
    "Show agent task progress on the Lock Screen and in the Dynamic Island. Turning this off also removes the currently displayed Live Activity." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
