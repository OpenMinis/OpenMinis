        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP 서버를 추가하여 Agent에 추가 도구를 제공합니다. +를 눌러 직접 추가하거나 JSON 구성을 가져오세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah server MCP untuk memberi ejen alat tambahan. Ketik + untuk menambah secara manual atau mengimport konfigurasi JSON."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj serwer MCP, aby dać agentowi dodatkowe narzędzia. Dotknij +, aby dodać ręcznie lub zaimportować konfigurację JSON."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um servidor MCP para dar ferramentas extras ao agente. Toque em + para adicionar manualmente ou importar um JSON."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă un server MCP pentru a-i da agentului unelte suplimentare. Atinge + pentru a adăuga manual sau a importa o configurație JSON."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте сервер MCP, чтобы дать Minis Agent дополнительные инструменты. Нажмите +, чтобы добавить вручную, или импортируйте конфигурацию JSON."
          }
        },
        "th" : {
