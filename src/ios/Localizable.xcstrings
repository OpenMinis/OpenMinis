          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma pasta para copiar cada backup também para lá — inclusive um servidor conectado no app Arquivos (SMB, WebDAV) ou um provedor de nuvem."
