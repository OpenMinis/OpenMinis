        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zamontowanie jest tylko do odczytu, aby chronić je przed przypadkową edycją."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta montagem fica somente leitura para protegê-la de edições acidentais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această montare este doar în citire, pentru a o proteja de modificări accidentale."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это подключение доступно только для чтения, чтобы защитить его от случайных изменений."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมานต์นี้เปิดเป็นแบบอ่านอย่างเดียวเพื่อป้องกันการแก้ไขโดยไม่ตั้งใจ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu bağlama, kazara düzenlemelere karşı korumak için salt okunur sunulur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此挂载以只读方式公开，以防止意外修改。"
