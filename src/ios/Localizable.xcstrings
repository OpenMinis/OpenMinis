    "Context is full and could not be compacted further. Start a new session or clear the chat to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kontext ist voll und konnte nicht weiter komprimiert werden. Starte eine neue Sitzung oder leere den Chat, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Context is full and could not be compacted further. Start a new session or clear the chat to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contexto está lleno y no se pudo compactar más. Inicia una sesión nueva o borra el chat para continuar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puno na ang context at hindi na ma-compact pa. Magsimula ng bagong session o i-clear ang chat para magpatuloy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contexte est plein et n’a pas pu être davantage compacté. Démarre une nouvelle session ou vide la conversation pour continuer."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontekst je pun i nije ga moguće dalje sažeti. Pokrenite novu sesiju ili očistite razgovor za nastavak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konteks penuh dan tidak dapat diringkas lebih jauh. Mulai sesi baru atau bersihkan obrolan untuk melanjutkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテキストがいっぱいで、これ以上圧縮できませんでした。続行するには新しいセッションを開始するか、チャットをクリアしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨텍스트가 가득 차 더 이상 압축할 수 없습니다. 계속하려면 새 세션을 시작하거나 채팅을 지우세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konteks penuh dan tidak dapat dipadatkan lagi. Mulakan sesi baharu atau kosongkan sembang untuk teruskan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontekst jest pełny i nie da się go bardziej skompresować. Rozpocznij nową sesję lub wyczyść czat, aby kontynuować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O contexto está cheio e não pode ser compactado mais. Comece uma nova sessão ou limpe o chat para continuar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contextul este plin și nu mai poate fi comprimat. Începe o sesiune nouă sau golește chatul pentru a continua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контекст переполнен и не может быть сжат дальше. Начните новую сессию или очистите чат, чтобы продолжить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บริบทเต็มแล้วและบีบอัดต่อไม่ได้ เริ่มเซสชันใหม่หรือล้างแชทเพื่อดำเนินการต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlam dolu ve daha fazla sıkıştırılamadı. Sürdürmek için yeni bir oturum başlatın ya da sohbeti temizleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下文已满且无法进一步压缩。请开始新会话或清空对话以继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下文已滿且無法進一步壓縮。請開始新工作階段或清空對話以繼續。"
          }
        }
      }
    },
