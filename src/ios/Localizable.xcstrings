    "Pending changes are preserved locally and pushed once the pause ends." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausstehende Änderungen bleiben lokal erhalten und werden nach Ende der Pause übertragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pending changes are preserved locally and pushed once the pause ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cambios pendientes se conservan localmente y se envían cuando termine la pausa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napapanatili nang lokal ang mga nakabinbing pagbabago at ipapadala kapag natapos ang pause."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modifications en attente sont conservées localement et envoyées à la fin de la pause."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promjene na čekanju čuvaju se lokalno i šalju se čim pauza završi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan tertunda disimpan secara lokal dan dikirim setelah jeda berakhir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留中の変更はローカルに保持され、一時停止の解除後に送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보류 중인 변경 사항은 로컬에 보관되며, 일시 정지가 해제되면 전송됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan tertunda disimpan secara tempatan dan dihantar setelah jeda tamat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczekujące zmiany są zachowywane lokalnie i wysyłane po zakończeniu wstrzymania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações pendentes ficam salvas localmente e são enviadas quando a pausa terminar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificările în așteptare sunt păstrate local și trimise după încheierea pauzei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидающие изменения сохраняются локально и отправляются после окончания паузы."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเปลี่ยนแปลงที่รออยู่จะถูกเก็บในเครื่องและส่งเมื่อสิ้นสุดการหยุดชั่วคราว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekleyen değişiklikler yerelde saklanır ve duraklatma bitince gönderilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待同步的内容会保存在本地，暂停结束后自动推送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待處理的變更會保留在本機，暫停結束後再上傳。"
          }
        }
      }
    },
