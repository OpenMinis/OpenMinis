    "Backups are copied to the enabled destinations. Tap for details, or swipe to remove." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherungen werden zu den aktivierten Zielen kopiert. Für Details tippen oder zum Entfernen streichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups are copied to the enabled destinations. Tap for details, or swipe to remove."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad se copian a los destinos activados. Toca para ver los detalles o desliza para quitarlos."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinokopya ang mga backup sa mga naka-enable na destinasyon. I-tap para sa detalye, o i-swipe para mag-alis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes sont copiées vers les destinations activées. Touchez pour les détails, ou balayez pour en supprimer une."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurnosne kopije kopiraju se na omogućena odredišta. Dodirnite za pojedinosti ili povucite za uklanjanje."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadangan disalin ke tujuan yang aktif. Ketuk untuk detail, atau geser untuk menghapus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップは有効な保存先にコピーされます。タップで詳細、スワイプで削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업은 활성화된 대상으로 복사됩니다. 탭하면 세부 정보, 쓸어넘기면 제거할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandaran disalin ke destinasi yang diaktifkan. Ketik untuk butiran, atau leret untuk membuang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie są kopiowane do włączonych miejsc docelowych. Dotknij po szczegóły lub przesuń, aby usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups são copiados para os destinos ativos. Toque para ver detalhes ou deslize para remover."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiile sunt trimise către destinațiile active. Atinge pentru detalii sau glisează pentru a elimina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копии отправляются во включённые назначения. Нажмите для подробностей или смахните, чтобы удалить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลสำรองจะถูกคัดลอกไปยังปลายทางที่เปิดใช้งาน แตะเพื่อดูรายละเอียด หรือปัดเพื่อนำออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedekler, etkin hedeflere kopyalanır. Ayrıntılar için dokunun, kaldırmak için kaydırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份会复制到已启用的目的地。点击查看详情，左滑移除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份會複製到已啟用的目的地。點一下可看詳細資訊，滑動可移除。"
          }
        }
      }
    },
    "Backups are stored in iCloud Drive and sync across your devices. Restoring will replace your current local data." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sicherungen werden in iCloud Drive gespeichert und über Ihre Geräte synchronisiert. Beim Wiederherstellen werden Ihre aktuellen lokalen Daten ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups are stored in iCloud Drive and sync across your devices. Restoring will replace your current local data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad se guardan en iCloud Drive y se sincronizan entre tus dispositivos. Al restaurar se reemplazarán tus datos locales actuales."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakaimbak ang mga backup sa iCloud Drive at sini-sync sa lahat ng device mo. Papalitan ng restore ang kasalukuyang lokal na datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes sont stockées dans iCloud Drive et synchronisées entre vos appareils. La restauration remplacera vos données locales actuelles."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurnosne kopije pohranjuju se u iCloud Drive i sinkroniziraju među vašim uređajima. Vraćanje će zamijeniti vaše trenutne lokalne podatke."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadangan disimpan di iCloud Drive dan disinkronkan ke perangkat Anda. Pemulihan akan mengganti data lokal Anda saat ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップは iCloud Drive に保存され、デバイス間で同期されます。復元すると、現在のローカルデータが置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업은 iCloud Drive에 저장되고 기기 간에 동기화됩니다. 복원하면 현재 로컬 데이터가 교체됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sandaran disimpan dalam iCloud Drive dan disegerakkan merentas peranti anda. Pemulihan akan menggantikan data tempatan semasa anda."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie są przechowywane w iCloud Drive i synchronizowane między urządzeniami. Przywracanie zastąpi bieżące dane lokalne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os backups ficam no iCloud Drive e sincronizam entre seus dispositivos. Restaurar vai substituir seus dados locais atuais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiile sunt stocate în iCloud Drive și se sincronizează între dispozitivele tale. Restaurarea va înlocui datele locale curente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервные копии хранятся в iCloud Drive и синхронизируются между вашими устройствами. Восстановление заменит текущие локальные данные."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลสำรองถูกจัดเก็บใน iCloud Drive และซิงค์ข้ามอุปกรณ์ของคุณ การกู้คืนจะแทนที่ข้อมูลในเครื่องปัจจุบัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedekler iCloud Drive'da saklanır ve aygıtlarınız arasında eşitlenir. Geri yükleme, geçerli yerel verilerinizi değiştirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份存储在 iCloud Drive 中并跨设备同步。恢复将替换当前的本地数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份儲存在 iCloud Drive 中並跨裝置同步。還原將取代目前的本機資料。"
          }
        }
      }
    },
