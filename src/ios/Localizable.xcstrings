    "Permanently erase all Minis data from iCloud. Local data on this device is not affected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Minis-Daten dauerhaft aus iCloud löschen. Lokale Daten auf diesem Gerät sind nicht betroffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently erase all Minis data from iCloud. Local data on this device is not affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra permanentemente todos los datos de Minis de iCloud. Los datos locales de este dispositivo no se ven afectados."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanenteng burahin lahat ng Minis data sa iCloud. Hindi maaapektuhan ang lokal na datos sa device na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacer définitivement toutes les données Minis d'iCloud. Les données locales sur cet appareil ne sont pas affectées."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trajno izbrišite sve Minis podatke s iClouda. Lokalni podaci na ovom uređaju ostaju netaknuti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus permanen semua data Minis dari iCloud. Data lokal di perangkat ini tidak terpengaruh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis のすべてのデータを iCloud から完全に削除します。このデバイスのローカルデータは影響を受けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud의 모든 Minis 데이터를 영구적으로 삭제합니다. 이 기기의 로컬 데이터에는 영향을 미치지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padam kekal semua data Minis dari iCloud. Data tempatan pada peranti ini tidak terjejas."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwale usuń wszystkie dane Minis z iCloud. Dane lokalne na tym urządzeniu pozostaną nietknięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar definitivamente todos os dados do Minis no iCloud. Os dados locais deste dispositivo não são afetados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Șterge definitiv toate datele Minis din iCloud. Datele locale de pe acest dispozitiv nu sunt afectate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безвозвратно удалить все данные Minis из iCloud. Локальные данные на этом устройстве не затрагиваются."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบข้อมูล Minis ทั้งหมดออกจาก iCloud อย่างถาวร ข้อมูลในเครื่องบนอุปกรณ์นี้จะไม่ได้รับผลกระทบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud'daki tüm Minis verilerini kalıcı olarak sil. Bu aygıttaki yerel veriler etkilenmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久从 iCloud 中删除所有 Minis 数据。本设备上的本地数据不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久從 iCloud 中刪除所有 Minis 資料。本設備上的本地資料不受影響。"
          }
        }
      }
    },
