    "“*” matches any characters. Matching ignores case and treats “.” and “-” as the same character." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„*“ steht für beliebige Zeichen. Die Übereinstimmung ignoriert Groß-/Kleinschreibung und behandelt „.“ und „-“ als dasselbe Zeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“*” matches any characters. Matching ignores case and treats “.” and “-” as the same character."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«*» coincide con cualquier carácter. La coincidencia no distingue mayúsculas de minúsculas y trata «.» y «-» como el mismo carácter."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumutugma ang “*” sa kahit anong karakter. Hindi ito sensitibo sa laki ng letra at pareho ang turing sa “.” at “-”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« * » correspond à n'importe quels caractères. La correspondance ignore la casse et traite « . » et « - » comme le même caractère."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“*” odgovara bilo kojim znakovima. Podudaranje zanemaruje velika i mala slova te “.” i “-” tretira kao isti znak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“*” cocok dengan karakter apa pun. Pencocokan mengabaikan huruf besar/kecil dan menganggap “.” dan “-” sebagai karakter yang sama."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「*」は任意の文字に一致します。大文字と小文字は区別せず、「.」と「-」は同じ文字として扱われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'*'는 모든 문자와 일치합니다. 대소문자는 구분하지 않으며 '.'과 '-'는 같은 문자로 취급됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“*” sepadan dengan mana-mana aksara. Padanan mengabaikan huruf besar/kecil dan menganggap “.” dan “-” sebagai aksara sama."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„*” pasuje do dowolnych znaków. Dopasowanie ignoruje wielkość liter i traktuje „.” oraz „-” jako ten sam znak."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“*” corresponde a quaisquer caracteres. A correspondência ignora maiúsculas e trata “.” e “-” como o mesmo caractere."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„*” se potrivește cu orice caractere. Potrivirea ignoră majusculele și tratează „.” și „-” ca același caracter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«*» соответствует любым символам. При сопоставлении регистр не учитывается, а «.» и «-» считаются одним символом."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“*” ตรงกับอักขระใดก็ได้ การจับคู่ไม่สนใจตัวพิมพ์ใหญ่เล็ก และถือว่า “.” กับ “-” เป็นอักขระเดียวกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“*” herhangi bir karakterle eşleşir. Eşleştirme büyük/küçük harfe duyarsızdır ve “.” ile “-” aynı sayılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“*”匹配任意字符。匹配时忽略大小写，且将“.”与“-”视为同一字符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
