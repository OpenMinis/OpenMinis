    "Existing session to continue. Leave empty for a new session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestehende Sitzung fortsetzen. Leer lassen für eine neue Sitzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existing session to continue. Leave empty for a new session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesión existente que se va a continuar. Déjalo vacío para una sesión nueva."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umiiral na session na ipagpapatuloy. Iwanang blangko para sa bagong session."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session existante à continuer. Laissez vide pour une nouvelle session."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Postojeća sesija za nastavak. Ostavite prazno za novu sesiju."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi yang ada untuk dilanjutkan. Kosongkan untuk sesi baru."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続行する既存のセッション。空にすると新規セッションが作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속할 기존 세션. 비워두면 새 세션이 생성됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi sedia ada untuk diteruskan. Biarkan kosong untuk sesi baharu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istniejąca sesja do kontynuacji. Pozostaw puste, aby utworzyć nową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessão existente a continuar. Deixe vazio para uma nova sessão."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiunea existentă de continuat. Lasă gol pentru o sesiune nouă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Существующая сессия для продолжения. Оставьте пустым для новой сессии."
          }
        },
        "th" : {
