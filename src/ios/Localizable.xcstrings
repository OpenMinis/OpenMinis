    "Above the provider's reported limit of %lld — the API may reject requests." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über dem vom Anbieter gemeldeten Limit von %lld — die API kann Anfragen ablehnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Above the provider's reported limit of %lld — the API may reject requests."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por encima del límite de %lld indicado por el proveedor: la API podría rechazar las solicitudes."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lampas sa iniulat na limitasyon ng provider na %lld — maaaring tanggihan ng API ang mga request."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au-dessus de la limite signalée par le fournisseur de %lld — l'API peut rejeter les requêtes."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iznad ograničenja koje pružatelj prijavljuje (%lld) — API bi mogao odbiti zahtjeve."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di atas batas %lld yang dilaporkan penyedia — API mungkin menolak permintaan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダーが報告した上限 %lld を超えています — API がリクエストを拒否する可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공급자가 보고한 %lld 한도를 초과했습니다 — API가 요청을 거부할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
