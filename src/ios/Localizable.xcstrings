    "Issued by your storage provider, together with the secret key." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird von deinem Speicheranbieter zusammen mit dem Secret Key ausgegeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Issued by your storage provider, together with the secret key."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo emite tu proveedor de almacenamiento, junto con la clave secreta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibinigay ng iyong storage provider, kasama ang secret key."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournie par votre fournisseur de stockage, avec la clé secrète."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izdaje ga vaš pružatelj usluge pohrane, zajedno s tajnim ključem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diterbitkan oleh penyedia penyimpanan Anda, bersama kunci rahasianya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シークレットキーとあわせて、ストレージプロバイダーから発行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비밀 키와 함께 스토리지 공급자가 발급합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikeluarkan oleh pembekal storan anda, bersama kunci rahsianya."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydawany przez dostawcę magazynu wraz z kluczem tajnym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emitida pelo seu provedor de armazenamento, junto com a chave secreta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emis de furnizorul tău de stocare, împreună cu cheia secretă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выдаётся вашим провайдером хранилища вместе с секретным ключом."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ออกโดยผู้ให้บริการพื้นที่จัดเก็บของคุณ พร้อมกับคีย์ลับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depolama sağlayıcınız tarafından gizli anahtarla birlikte verilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由存储服务商签发，与密钥成对提供。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由你的儲存服務商與金鑰一併核發。"
          }
        }
      }
    },
    "Items from the backup are merged into your existing data. Nothing is deleted, and anything you've changed more recently is kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge aus der Sicherung werden mit deinen vorhandenen Daten zusammengeführt. Nichts wird gelöscht, und was du zuletzt geändert hast, bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos de la copia de seguridad se combinan con tus datos actuales. No se elimina nada y se conserva todo lo que hayas modificado más recientemente."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isinasama sa umiiral mong datos ang mga item mula sa backup. Walang tinatanggal, at napapanatili ang mga mas bagong binago mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments de la sauvegarde sont fusionnés avec vos données existantes. Rien n'est supprimé, et ce que vous avez modifié plus récemment est conservé."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stavke iz sigurnosne kopije spajaju se s vašim postojećim podacima. Ništa se ne briše, a sve što ste izmijenili u novije vrijeme ostaje sačuvano."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item dari cadangan digabungkan ke data Anda yang ada. Tidak ada yang dihapus, dan apa pun yang Anda ubah lebih baru tetap dipertahankan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップの項目は既存のデータに統合されます。何も削除されず、より新しく変更した内容はそのまま保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업의 항목은 기존 데이터에 병합됩니다. 삭제되는 항목은 없으며, 더 최근에 변경한 내용은 그대로 유지됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Item dari sandaran digabungkan ke dalam data sedia ada anda. Tiada apa-apa dipadam, dan apa sahaja yang anda ubah lebih baharu dikekalkan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementy z kopii są scalane z istniejącymi danymi. Nic nie jest usuwane, a nowsze zmiany zostają zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens do backup são mesclados com os seus dados atuais. Nada é excluído, e o que você alterou mais recentemente é mantido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elementele din copie sunt îmbinate cu datele tale existente. Nimic nu se șterge, iar ce ai modificat mai recent se păstrează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элементы из копии объединяются с вашими данными. Ничего не удаляется, а изменённое вами позднее сохраняется."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รายการจากข้อมูลสำรองจะถูกรวมเข้ากับข้อมูลที่มีอยู่ ไม่มีอะไรถูกลบ และสิ่งที่คุณเปลี่ยนแปลงล่าสุดจะยังคงอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedekteki öğeler var olan verilerinizle birleştirilir. Hiçbir şey silinmez ve daha yakın zamanda değiştirdikleriniz korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份中的条目会合并到你现有的数据中。不会删除任何内容，你最近修改过的内容也会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "備份中的項目會合併到你現有的資料中。不會刪除任何內容，你較近期修改的內容也會保留。"
          }
        }
      }
    },
