    },
    "This mount is exposed as read-only to protect it from accidental edits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mount ist schreibgeschützt, um versehentliche Änderungen zu verhindern."
          }
