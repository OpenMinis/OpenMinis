    "Conversation context is nearly full. Compact the history to free up space before sending." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Konversationskontext ist nahezu voll. Komprimieren Sie den Verlauf, um vor dem Senden Platz zu schaffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversation context is nearly full. Compact the history to free up space before sending."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contexto de la conversación está casi lleno. Compacta el historial para liberar espacio antes de enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contexte de la conversation est presque plein. Compactez l'historique pour libérer de l'espace avant l'envoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話のコンテキストがほぼ満杯です。送信する前に履歴を圧縮して空きを作ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화 컨텍스트가 거의 가득 찼습니다. 보내기 전에 기록을 압축하여 공간을 확보하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контекст разговора почти заполнен. Сожмите историю, чтобы освободить место перед отправкой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对话上下文接近上限。请先压缩历史以释放空间，然后再发送。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對話上下文接近上限。請先壓縮歷史以釋放空間，然後再發送。"
          }
        }
      }
    },
    "Conversation context is nearly full. Compact the history to free up space before sending. Enabling auto-compact will do this automatically from now on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gesprächskontext ist fast voll. Komprimiere den Verlauf, um vor dem Senden Platz freizugeben. Mit Auto-Komprimierung geschieht das künftig automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversation context is nearly full. Compact the history to free up space before sending. Enabling auto-compact will do this automatically from now on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contexto de la conversación está casi lleno. Compacta el historial para liberar espacio antes de enviar. Si activas la compactación automática, esto se hará solo a partir de ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contexte de la conversation est presque plein. Compactez l'historique pour libérer de l'espace avant l'envoi. L'auto-compactage le fera automatiquement à l'avenir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会話のコンテキストがほぼ満杯です。送信前に履歴を圧縮して空きを確保してください。自動圧縮を有効にすると、今後は自動的に実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대화 컨텍스트가 거의 가득 찼습니다. 전송 전에 기록을 압축하여 공간을 확보하세요. 자동 압축을 켜면 앞으로는 자동으로 실행됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Контекст беседы почти заполнен. Сожмите историю, чтобы освободить место перед отправкой. При включённом автосжатии это будет происходить автоматически."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对话上下文即将占满。发送前请压缩历史记录以释放空间。开启自动压缩后,今后将自动执行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對話上下文即將佔滿。傳送前請壓縮歷史記錄以釋放空間。開啟自動壓縮後,今後將自動執行。"
          }
        }
      }
    },
