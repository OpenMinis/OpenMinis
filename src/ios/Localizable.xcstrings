    "This will replace your current %@ data with the backup from %@. This cannot be undone." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden Ihre aktuellen %1$@-Daten durch die Sicherung vom %2$@ ersetzt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This will replace your current %1$@ data with the backup from %2$@. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto reemplazará tus datos actuales de %@ con la copia de seguridad de %@. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela remplacera vos données %1$@ actuelles par la sauvegarde du %2$@. Cette action est irréversible."
