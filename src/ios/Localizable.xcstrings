    "The server's certificate isn't signed by a known authority — usual for a NAS using its own certificate." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zertifikat des Servers ist nicht von einer bekannten Stelle signiert — üblich bei einem NAS mit eigenem Zertifikat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server's certificate isn't signed by a known authority — usual for a NAS using its own certificate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El certificado del servidor no está firmado por una autoridad conocida, algo habitual en un NAS que usa su propio certificado."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi pinirmahan ng kilalang awtoridad ang certificate ng server — karaniwan ito sa NAS na gumagamit ng sariling certificate."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le certificat du serveur n'est pas signé par une autorité connue — courant pour un NAS utilisant son propre certificat."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifikat poslužitelja nije potpisalo poznato tijelo — uobičajeno za NAS koji koristi vlastiti certifikat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sertifikat server tidak ditandatangani otoritas yang dikenal — hal biasa untuk NAS yang memakai sertifikatnya sendiri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバの証明書が既知の認証局に署名されていません。自己署名証明書を使う NAS では一般的です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버 인증서가 알려진 기관에서 서명되지 않았습니다. 자체 인증서를 쓰는 NAS에서는 흔한 일입니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sijil server tidak ditandatangani oleh pihak berkuasa yang dikenali — perkara biasa bagi NAS yang menggunakan sijilnya sendiri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certyfikat serwera nie jest podpisany przez znany urząd — to typowe dla serwera NAS z własnym certyfikatem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O certificado do servidor não é assinado por uma autoridade conhecida — comum em um NAS que usa o próprio certificado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificatul serverului nu este semnat de o autoritate cunoscută — obișnuit pentru un NAS cu certificat propriu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертификат сервера не подписан известным центром — обычное дело для NAS с собственным сертификатом."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใบรับรองของเซิร์ฟเวอร์ไม่ได้ลงนามโดยผู้ออกที่รู้จัก — เป็นเรื่องปกติสำหรับ NAS ที่ใช้ใบรับรองของตนเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunun sertifikası bilinen bir makam tarafından imzalanmamış — kendi sertifikasını kullanan bir NAS için olağandır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器证书未由已知机构签发 —— 使用自有证书的 NAS 通常如此。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伺服器憑證並非由已知的憑證機構簽發，使用自簽憑證的 NAS 常會如此。"
          }
        }
      }
    },
