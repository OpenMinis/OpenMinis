        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linux 환경이 초기화되었습니다. 터미널을 사용하기 전에 앱을 다시 시작하여 재설치하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
