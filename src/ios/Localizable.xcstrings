    },
    "A Shortcut sent to Minis may not have finished. Open the session to check." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein an Minis gesendeter Kurzbefehl wurde möglicherweise nicht abgeschlossen. Öffne die Sitzung, um dies zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Shortcut sent to Minis may not have finished. Open the session to check."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un raccourci envoyé à Minis n’est peut-être pas terminé. Ouvre la session pour vérifier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis に送信されたショートカットが完了していない可能性があります。セッションを開いて確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minis로 보낸 단축어가 완료되지 않았을 수 있습니다. 세션을 열어 확인하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрая команда, отправленная в Minis, возможно, не завершилась. Откройте сессию, чтобы проверить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送给 Minis 的快捷指令可能尚未完成。请打开会话查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送給 Minis 的捷徑可能尚未完成。請開啟工作階段查看。"
          }
        }
      }
    },
    "A task is running in this chat. Starting a new chat will stop it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Chat läuft eine Aufgabe. Ein neuer Chat beendet sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
