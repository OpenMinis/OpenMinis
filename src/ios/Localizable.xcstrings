    "Last attempt failed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letzter Versuch fehlgeschlagen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last attempt failed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El último intento falló"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nabigo ang huling pagsubok"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière tentative a échoué"
          }
        },
        "hr" : {
