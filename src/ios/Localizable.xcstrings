    "Exports provider configuration including API key. Share via AirDrop, Messages, etc. to set up on another device." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiert die Anbieterkonfiguration einschließlich API-Schlüssel. Teilen Sie per AirDrop, Nachrichten usw. zur Einrichtung auf einem anderen Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exports provider configuration including API key. Share via AirDrop, Messages, etc. to set up on another device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta la configuración del proveedor, incluida la clave de API. Compártela por AirDrop, Mensajes, etc. para configurarla en otro dispositivo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini-export ang configuration ng provider kasama ang API key. Ibahagi sa AirDrop, Messages, atbp. para ma-set up sa ibang device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporte la configuration du fournisseur incluant la clé API. Partagez via AirDrop, Messages, etc. pour configurer un autre appareil."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izvozi konfiguraciju pružatelja usluge uključujući API ključ. Podijelite putem AirDropa, Poruka i sl. za postavljanje na drugom uređaju."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengekspor konfigurasi penyedia termasuk kunci API. Bagikan via AirDrop, Pesan, dll. untuk menyiapkannya di perangkat lain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API キーを含むプロバイダー設定をエクスポートします。AirDrop やメッセージなどで別のデバイスに共有できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 키를 포함한 제공자 구성을 내보냅니다. AirDrop, 메시지 등으로 다른 기기에 설정하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengeksport konfigurasi pembekal termasuk kunci API. Kongsi melalui AirDrop, Mesej, dll. untuk menyediakannya pada peranti lain."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportuje konfigurację dostawcy wraz z kluczem API. Udostępnij przez AirDrop, Wiadomości itp., aby skonfigurować inne urządzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta a configuração do provedor, incluindo a chave de API. Compartilhe por AirDrop, Mensagens etc. para configurar em outro dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportă configurația furnizorului, inclusiv cheia API. Partajează prin AirDrop, Mesaje etc. pentru a configura alt dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспортирует конфигурацию провайдера, включая API-ключ. Поделитесь через AirDrop, Сообщения и т. п., чтобы настроить на другом устройстве."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งออกการกำหนดค่าผู้ให้บริการรวมถึงคีย์ API แชร์ผ่าน AirDrop, ข้อความ ฯลฯ เพื่อตั้งค่าบนอุปกรณ์อื่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API anahtarı dahil sağlayıcı yapılandırmasını dışa aktarır. Başka bir aygıtta kurmak için AirDrop, Mesajlar vb. ile paylaşın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
