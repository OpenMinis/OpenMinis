        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aracı görev ilerlemesini Kilit Ekranı'nda ve Dynamic Island'da göster. Bunu kapatmak, o anda görünen Live Activity'yi de kaldırır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在锁定屏幕和灵动岛上显示 Agent 任务进度。关闭后会同时移除当前正在显示的实时活动。"
          }
