        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、AIの完了を待ち、後続のアクションで使用する完全な応答を返します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 AI가 완료될 때까지 기다린 후 후속 작업에 사용할 전체 응답을 반환합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila diaktifkan, menunggu AI selesai dan mengembalikan respons penuh untuk digunakan dalam tindakan seterusnya."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy włączone, czeka na zakończenie pracy AI i zwraca pełną odpowiedź do użycia w kolejnych działaniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, espera a IA terminar e retorna a resposta completa para uso nas ações seguintes."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când e activat, așteaptă ca AI-ul să termine și returnează răspunsul complet pentru acțiunile următoare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда включено, ожидает завершения ответа ИИ и возвращает полный ответ для использования в последующих действиях."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้งาน จะรอให้ AI ทำงานเสร็จและส่งคำตอบฉบับเต็มกลับมาเพื่อใช้ในขั้นตอนถัดไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde yapay zekânın bitirmesini bekler ve sonraki eylemlerde kullanmak üzere tam yanıtı döndürür."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，等待 AI 完成并返回完整响应，供后续操作使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟用後，等待 AI 完成並返回完整響應，供後續操作使用。"
          }
        }
      }
    },
    "When enabled, waits for the AI to finish and returns the full response. Use this to chain the result into subsequent Shortcuts actions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, wird auf die Fertigstellung der KI gewartet und die vollständige Antwort zurückgegeben. Verwenden Sie dies, um das Ergebnis in nachfolgende Kurzbefehl-Aktionen zu verketten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, waits for the AI to finish and returns the full response. Use this to chain the result into subsequent Shortcuts actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se activa, espera a que la IA termine y devuelve la respuesta completa. Úsalo para encadenar el resultado con acciones posteriores de Atajos."
