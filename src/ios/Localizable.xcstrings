    "The URL is used verbatim. Include the full path up to (but not including) the endpoint, e.g. \"/chat/completions\"." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die URL wird unverändert verwendet. Geben Sie den vollständigen Pfad bis zum (aber nicht einschließlich) Endpunkt an, z. B. „/chat/completions“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The URL is used verbatim. Include the full path up to (but not including) the endpoint, e.g. \"/chat/completions\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La URL se usa tal cual. Incluye la ruta completa hasta el endpoint, sin incluirlo, por ejemplo \"/chat/completions\"."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit ang URL nang eksakto. Isama ang buong path hanggang (pero hindi kasama) ang endpoint, hal. \"/chat/completions\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'URL est utilisée telle quelle. Incluez le chemin complet jusqu'au (mais sans) le point de terminaison, p. ex. « /chat/completions »."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL se koristi doslovno. Uključite punu putanju do krajnje točke (bez nje same), npr. \"/chat/completions\"."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL dipakai apa adanya. Sertakan jalur lengkap sampai (tetapi tidak termasuk) endpoint, mis. \"/chat/completions\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL はそのまま使用されます。エンドポイントの前までのフルパスを含めてください（例：「/chat/completions」）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL은 그대로 사용됩니다. 엔드포인트 전까지의 전체 경로를 포함하세요(예: \"/chat/completions\")."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL digunakan seadanya. Sertakan laluan penuh sehingga (tetapi tidak termasuk) endpoint, cth. \"/chat/completions\"."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adres jest używany dosłownie. Podaj pełną ścieżkę aż do punktu końcowego (bez niego), np. \"/chat/completions\"."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A URL é usada exatamente como está. Inclua o caminho completo até o endpoint (sem incluí-lo), ex.: \"/chat/completions\"."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresa este folosită întocmai. Include calea completă până la endpoint (fără el), de ex. „/chat/completions\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL используется как есть. Укажите полный путь до конечной точки (не включая её), например «/chat/completions»."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL จะถูกใช้ตามที่ป้อนทุกประการ ใส่พาธเต็มจนถึง (แต่ไม่รวม) เอนด์พอยต์ เช่น \"/chat/completions\""
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL olduğu gibi kullanılır. Uç noktaya kadar olan (uç nokta hariç) tam yolu ekleyin, ör. \"/chat/completions\"."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL 将按原样使用。请包含到端点之前的完整路径，例如 \"/chat/completions\"。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL 將按原樣使用。請包含到端點之前的完整路徑，例如 \"/chat/completions\"。"
          }
        }
      }
    },
