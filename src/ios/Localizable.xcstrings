          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passer à la saisie de texte"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト入力に切り替え"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 입력으로 전환"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключиться на ввод текста"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切换到文字输入"
          }
        },
