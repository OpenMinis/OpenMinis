    "Every run of this sub agent uses this level, overriding the Model Group's own default. Models that cannot reason this hard are clamped to their own ceiling." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every run of this sub agent uses this level, overriding the Model Group's own default. Models that cannot reason this hard are clamped to their own ceiling."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svako izvođenje ovog podagenta koristi ovu razinu i nadjačava zadanu vrijednost grupe modela. Modeli koji ne mogu zaključivati tako zahtjevno ograničeni su na vlastiti maksimum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
