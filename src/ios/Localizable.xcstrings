    "Leave blank unless SSH runs on a non-standard port." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave blank unless SSH runs on a non-standard port."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo en blanco salvo que SSH funcione en un puerto no estándar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非 SSH 使用非标准端口，否则留空。"
          }
        }
      }
    },
    "Leave Context Window empty to use auto-detected value. Leave Max Output Tokens empty to follow the provider default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasse das Kontextfenster leer, um den automatisch erkannten Wert zu verwenden. Lasse „Max. Ausgabe-Tokens“ leer, um den Anbieter-Standard zu übernehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave Context Window empty to use auto-detected value. Leave Max Output Tokens empty to follow the provider default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja la ventana de contexto vacía para usar el valor detectado automáticamente. Deja el máximo de tokens de salida vacío para seguir el valor predeterminado del proveedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisse la fenêtre de contexte vide pour utiliser la valeur détectée automatiquement. Laisse Jetons de sortie max. vide pour suivre la valeur par défaut du fournisseur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテキストウィンドウを空欄にすると自動検出値を使用します。最大出力トークンを空欄にするとプロバイダーのデフォルトに従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨텍스트 창을 비워 두면 자동 감지된 값을 사용합니다. 최대 출력 토큰을 비워 두면 제공자 기본값을 따릅니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте окно контекста пустым, чтобы использовать автоопределённое значение. Оставьте «Макс. выходных токенов» пустым, чтобы следовать значению провайдера по умолчанию."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将上下文窗口留空以使用自动检测的值。将最大输出 Token 留空以采用服务商默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將上下文視窗留空以使用自動偵測的值。將最大輸出 Token 留空以採用服務商預設值。"
          }
        }
      }
    },
    "Leave display name empty to use the model ID." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen, um die Modell-ID zu verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave display name empty to use the model ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja el nombre visible vacío para usar el ID del modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide pour utiliser l'ID du modèle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示名を空にするとモデルIDが使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "표시 이름을 비워두면 모델 ID가 사용됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте отображаемое имя пустым, чтобы использовать ID модели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空则使用模型 ID 作为显示名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空則使用模型 ID 作爲顯示名稱。"
          }
        }
      }
    },
    "Leave empty to use the default endpoint. \"/v1\" is appended automatically — enter the base host only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leer lassen, um den Standard-Endpunkt zu verwenden. „/v1“ wird automatisch angehängt — geben Sie nur den Basis-Host ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave empty to use the default endpoint. \"/v1\" is appended automatically — enter the base host only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjalo vacío para usar el endpoint predeterminado. \"/v1\" se añade automáticamente: introduce solo el host base."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez vide pour utiliser le point de terminaison par défaut. « /v1 » est ajouté automatiquement — saisissez uniquement l'hôte de base."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空のままにするとデフォルトのエンドポイントを使用します。「/v1」は自動で付加されます — ベースホストのみ入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비워두면 기본 엔드포인트를 사용합니다. \"/v1\"은 자동으로 추가되므로 베이스 호스트만 입력하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставьте пустым, чтобы использовать конечную точку по умолчанию. «/v1» добавляется автоматически — укажите только базовый хост."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空则使用默认端点。\"/v1\" 会自动附加 — 只需输入基础主机地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "留空則使用默認端點。\"/v1\" 會自動附加 — 只需輸入基礎主機地址。"
          }
        }
      }
    },
    "Leave empty to use the default Google endpoint. Enter the full base URL including version path." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
