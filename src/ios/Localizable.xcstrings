    "Delivered to all %lld destination(s) and verified. The copy on this iPhone was removed to save space." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An alle %lld Ziel(e) übertragen und verifiziert. Die Kopie auf diesem iPhone wurde entfernt, um Speicher zu sparen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delivered to all %lld destination(s) and verified. The copy on this iPhone was removed to save space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se entregó y verificó en los %lld destinos. La copia en este iPhone se eliminó para ahorrar espacio."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naihatid sa lahat ng %lld destinasyon at na-verify. Inalis ang kopya sa iPhone na ito para makatipid ng espasyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transmis à %lld destination(s) et vérifié. La copie sur cet iPhone a été supprimée pour libérer de l'espace."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isporučeno na sva odredišta (%lld) i provjereno. Kopija na ovom iPhoneu uklonjena je radi uštede prostora."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terkirim ke semua %lld tujuan dan terverifikasi. Salinan di iPhone ini dihapus untuk menghemat ruang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 件すべての保存先に転送し、検証しました。容量節約のため、この iPhone 上のコピーは削除されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld개 대상 모두에 전달하고 확인했습니다. 공간 확보를 위해 이 iPhone의 사본은 삭제되었습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dihantar ke semua %lld destinasi dan disahkan. Salinan pada iPhone ini dibuang untuk menjimatkan ruang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostarczono do wszystkich miejsc docelowych (%lld) i zweryfikowano. Kopię z tego iPhone'a usunięto, aby zwolnić miejsce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entregue a todos os %lld destino(s) e verificado. A cópia neste iPhone foi removida para economizar espaço."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Livrat către toate destinațiile (%lld) și verificat. Copia de pe acest iPhone a fost eliminată pentru a economisi spațiu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доставлено во все назначения (%lld) и проверено. Копия на этом iPhone удалена для экономии места."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งไปยังปลายทางทั้ง %lld แห่งและยืนยันแล้ว สำเนาบน iPhone นี้ถูกลบเพื่อประหยัดพื้นที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
