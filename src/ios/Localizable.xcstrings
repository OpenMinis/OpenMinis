          "stringUnit" : {
            "state" : "translated",
            "value" : "การนำออกจะลืมเซิร์ฟเวอร์นี้และรหัสผ่านบน iPhone เครื่องนี้ ข้อมูลสำรองที่จัดเก็บบนเซิร์ฟเวอร์แล้วจะไม่ถูกแตะต้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaldırmak, bu sunucuyu ve parolasını bu iPhone'da unutur. Sunucuda zaten bulunan yedeklere dokunulmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除后将在本机忘记该服务器及其密码。服务器上已有的备份不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除後這台 iPhone 會忘記該伺服器與密碼。伺服器上既有的備份不受影響。"
          }
        }
      }
    },
