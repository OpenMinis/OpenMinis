    "Please review how your data is handled before adding an AI provider." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte lesen Sie, wie Ihre Daten verarbeitet werden, bevor Sie einen KI-Anbieter hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please review how your data is handled before adding an AI provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa cómo se tratan tus datos antes de añadir un proveedor de IA."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakisuri kung paano hinahawakan ang datos mo bago magdagdag ng AI provider."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez consulter le traitement de vos données avant d'ajouter un fournisseur AI."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregledajte kako se postupa s vašim podacima prije dodavanja AI pružatelja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harap tinjau cara data Anda ditangani sebelum menambahkan penyedia AI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIプロバイダーを追加する前に、データの取り扱いについてご確認ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 공급자를 추가하기 전에 데이터 처리 방식을 확인하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sila semak cara data anda dikendalikan sebelum menambah pembekal AI."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapoznaj się z tym, jak przetwarzane są Twoje dane, zanim dodasz dostawcę AI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia como seus dados são tratados antes de adicionar um provedor de IA."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifică modul în care sunt tratate datele tale înainte de a adăuga un furnizor AI."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед добавлением AI-провайдера ознакомьтесь с тем, как обрабатываются ваши данные."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โปรดตรวจสอบวิธีจัดการข้อมูลของคุณก่อนเพิ่มผู้ให้บริการ AI"
