    "Add a folder in Settings ▸ Shared Folders — including a server connected in the Files app (SMB, WebDAV) or a cloud provider — and it can be selected here." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge unter Einstellungen ▸ Geteilte Ordner einen Ordner hinzu — auch einen in der App „Dateien“ verbundenen Server (SMB, WebDAV) oder einen Cloud-Anbieter — dann kann er hier ausgewählt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a folder in Settings ▸ Shared Folders — including a server connected in the Files app (SMB, WebDAV) or a cloud provider — and it can be selected here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una carpeta en Ajustes ▸ Carpetas compartidas —incluido un servidor conectado en la app Archivos (SMB, WebDAV) o un proveedor en la nube— y podrás seleccionarla aquí."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magdagdag ng folder sa Settings ▸ Shared Folders — kasama ang server na nakakonekta sa Files app (SMB, WebDAV) o cloud provider — at mapipili ito dito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un dossier dans Réglages ▸ Dossiers partagés — y compris un serveur connecté dans l'app Fichiers (SMB, WebDAV) ou un fournisseur cloud — et il pourra être sélectionné ici."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodajte mapu u Postavke ▸ Dijeljene mape — uključujući poslužitelj povezan u aplikaciji Files (SMB, WebDAV) ili pružatelja usluga u oblaku — i moći ćete je odabrati ovdje."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan folder di Pengaturan ▸ Folder Bersama — termasuk server yang terhubung di aplikasi Files (SMB, WebDAV) atau penyedia cloud — dan folder itu dapat dipilih di sini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 ▸ 共有フォルダ でフォルダを追加すると、ここで選択できるようになります。「ファイル」アプリで接続したサーバ（SMB、WebDAV）やクラウドも指定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 ▸ 공유 폴더에서 폴더를 추가하면 여기서 선택할 수 있습니다. 파일 앱에서 연결한 서버(SMB, WebDAV)나 클라우드도 지정할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambah folder dalam Tetapan ▸ Folder Dikongsi — termasuk server yang disambung dalam apl Files (SMB, WebDAV) atau pembekal awan — dan ia boleh dipilih di sini."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj folder w Ustawienia ▸ Foldery udostępnione — również serwer podłączony w Plikach (SMB, WebDAV) lub chmurę — a będzie można go tu wybrać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma pasta em Ajustes ▸ Pastas compartilhadas — inclusive um servidor conectado no app Arquivos (SMB, WebDAV) ou um provedor de nuvem — e ela poderá ser escolhida aqui."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adaugă un dosar în Configurări ▸ Dosare partajate — inclusiv un server conectat în aplicația Fișiere (SMB, WebDAV) sau un furnizor cloud — și îl vei putea selecta aici."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте папку в «Настройки ▸ Общие папки» — включая сервер, подключённый в приложении «Файлы» (SMB, WebDAV), или облачного провайдера — и её можно будет выбрать здесь."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มโฟลเดอร์ในการตั้งค่า ▸ โฟลเดอร์ที่แชร์ — รวมถึงเซิร์ฟเวอร์ที่เชื่อมต่อในแอป Files (SMB, WebDAV) หรือผู้ให้บริการคลาวด์ — แล้วจะเลือกได้ที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar ▸ Paylaşılan Klasörler'den bir klasör ekleyin — Dosyalar uygulamasına bağlı bir sunucu (SMB, WebDAV) veya bulut sağlayıcısı dahil — ardından burada seçilebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 ▸ 共享文件夹”中添加文件夹（包括在“文件”App 中连接的服务器，如 SMB、WebDAV，或各类云盘），即可在此选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定 ▸ 共用資料夾」中加入資料夾後即可在此選擇，包括在「檔案」App 中連線的伺服器（SMB、WebDAV）或雲端服務。"
          }
        }
      }
    },
    "Add a folder to also copy each backup there — including a server connected in the Files app (SMB, WebDAV) or a cloud provider." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen Ordner hinzu, um jede Sicherung auch dorthin zu kopieren — auch auf einen in der App „Dateien“ verbundenen Server (SMB, WebDAV) oder zu einem Cloud-Anbieter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a folder to also copy each backup there — including a server connected in the Files app (SMB, WebDAV) or a cloud provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una carpeta para copiar allí también cada copia de seguridad, incluido un servidor conectado en la app Archivos (SMB, WebDAV) o un proveedor en la nube."
          }
        },
        "fil" : {
          "stringUnit" : {
