          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este proveedor usa un protocolo oficial, por lo que Minis gestiona sus parámetros de razonamiento. Las reglas personalizadas se aplican a los proveedores compatibles con OpenAI en la API de Chat Completions."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
