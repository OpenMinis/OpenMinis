    "Uses low-accuracy location updates to prevent iOS from suspending the app while agent tasks are running in the background." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet ungenaue Standortaktualisierungen, um zu verhindern, dass iOS die App während der Hintergrundausführung pausiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses low-accuracy location updates to prevent iOS from suspending the app while Agent tasks are running in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliza actualizaciones de ubicación de baja precisión para evitar que iOS suspenda la app mientras las tareas de Minis Agent se ejecutan en segundo plano."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagamit ng mababang-katumpakang location update para pigilan ang iOS na i-suspend ang app habang tumatakbo ang mga agent task sa background."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise des mises à jour de localisation basse précision pour empêcher iOS de suspendre l'app pendant les tâches en arrière-plan."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi ažuriranja lokacije niske točnosti kako iOS ne bi obustavio aplikaciju dok se zadaci Agenta izvršavaju u pozadini."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memakai pembaruan lokasi berakurasi rendah agar iOS tidak menangguhkan aplikasi selama tugas agen berjalan di latar belakang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低精度の位置情報更新を使用して、Agent タスクのバックグラウンド実行中にiOSがアプリを一時停止するのを防ぎます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 작업이 백그라운드에서 실행되는 동안 iOS가 앱을 일시 중지하지 않도록 저정밀 위치 업데이트를 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menggunakan kemas kini lokasi berketepatan rendah untuk menghalang iOS daripada menggantung apl semasa tugas ejen berjalan di latar belakang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używa mało dokładnych aktualizacji lokalizacji, aby iOS nie wstrzymał aplikacji, gdy zadania agenta działają w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa atualizações de localização de baixa precisão para impedir que o iOS suspenda o app enquanto tarefas do agente rodam em segundo plano."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește actualizări de locație cu precizie redusă pentru a împiedica iOS să suspende aplicația cât timp sarcinile agentului rulează în fundal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует обновления геопозиции с низкой точностью, чтобы iOS не приостанавливала приложение, пока задачи Agent выполняются в фоне."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้การอัปเดตตำแหน่งความแม่นยำต่ำเพื่อป้องกันไม่ให้ iOS ระงับแอปขณะที่งานของเอเจนต์ทำงานอยู่เบื้องหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aracı görevleri arka planda çalışırken iOS'un uygulamayı askıya almasını önlemek için düşük duyarlıklı konum güncellemeleri kullanır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用低精度定位更新，防止 iOS 在后台运行 Agent 任务时挂起应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用低精度定位更新，防止 iOS 在背景運行智能體任務時掛起應用。"
          }
        }
      }
    },
    "Using custom viewport %lld×%lld. Tap Default to revert to the UA default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzerdefiniertes Viewport %lld×%lld wird verwendet. Tippen Sie auf „Standard“, um zur UA-Standardeinstellung zurückzukehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
