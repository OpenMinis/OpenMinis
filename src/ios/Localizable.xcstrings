            "value" : "详细"
          }
        }
      }
    },
    "Whether to proceed is your decision, and you accept the risk of doing so." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether to proceed is your decision, and you accept the risk of doing so."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否继续由你自行决定，并由你承担由此产生的风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是否繼續由你自行決定，並由你承擔由此產生的風險。"
          }
        }
      }
    },
    "Using it may put your GitHub Copilot entitlement or your GitHub account at risk, including restriction or suspension. That consequence falls on your account." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using it may put your GitHub Copilot entitlement or your GitHub account at risk, including restriction or suspension. That consequence falls on your account."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用它可能使你的 GitHub Copilot 权益或 GitHub 账号面临风险，包括被限制或停用。相关后果由你的账号承担。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用它可能使你的 GitHub Copilot 權益或 GitHub 帳號面臨風險，包括被限制或停用。相關後果由你的帳號承擔。"
          }
        }
      }
    },
    "You can define up to %d sub agents." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können bis zu %d Subagenten definieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can define up to %d sub agents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes definir hasta %d subagentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez définir jusqu’à %d sous-agents."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najveći broj podagenata koje možete definirati: %d."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブエージェントは最大 %d 個まで定義できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서브 에이전트는 최대 %d개까지 정의할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
