            "state" : "translated",
            "value" : "El servidor “%@” tardó demasiado en responder."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masyadong matagal bago tumugon ang server na “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
