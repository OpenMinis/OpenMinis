        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat aktif, menunggu AI selesai dan mengembalikan respons lengkapnya. Gunakan ini untuk merangkai hasilnya ke tindakan Pintasan berikutnya."
