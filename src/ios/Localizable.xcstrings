    "About %lld local records will upload to iCloud. Estimated time ~%lld hr depending on iCloud throttling. You can pause or cancel any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa %lld lokale Datensätze werden in iCloud hochgeladen. Geschätzte Dauer ~%lld Std., abhängig von der iCloud-Drosselung. Du kannst jederzeit pausieren oder abbrechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "About %1$lld local records will upload to iCloud. Estimated time ~%2$lld hr depending on iCloud throttling. You can pause or cancel any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se subirán unos %lld registros locales a iCloud. Tiempo estimado: ~%lld h, según la limitación de iCloud. Puedes pausar o cancelar en cualquier momento."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mga %lld lokal na record ang mag-a-upload sa iCloud. Tinatayang ~%lld oras depende sa throttling ng iCloud. Puwede kang mag-pause o mag-cancel anumang oras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ %lld enregistrements locaux seront envoyés vers iCloud. Durée estimée ~%lld h selon la limitation d'iCloud. Vous pouvez suspendre ou annuler à tout moment."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Približno %1$lld lokalnih zapisa poslat će se na iCloud. Procijenjeno vrijeme ~%2$lld h, ovisno o iCloud ograničenjima. Možete pauzirati ili otkazati u bilo kojem trenutku."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekitar %lld catatan lokal akan diunggah ke iCloud. Perkiraan waktu ~%lld jam tergantung pembatasan iCloud. Anda dapat menjeda atau membatalkan kapan saja."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約 %lld 件のローカルレコードが iCloud にアップロードされます。iCloud の制限により、推定所要時間は約 %lld 時間です。いつでも一時停止・キャンセルできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약 %lld개의 로컬 레코드가 iCloud로 업로드됩니다. iCloud 제한에 따라 예상 시간은 약 %lld시간입니다. 언제든지 일시 정지하거나 취소할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kira-kira %lld rekod tempatan akan dimuat naik ke iCloud. Anggaran masa ~%lld jam bergantung pada pengehadan iCloud. Anda boleh menjeda atau membatalkan bila-bila masa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do iCloud trafi około %lld rekordów lokalnych. Szacowany czas to ~%lld godz., zależnie od ograniczeń iCloud. Możesz w każdej chwili wstrzymać lub anulować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca de %lld registros locais serão enviados ao iCloud. Tempo estimado de ~%lld h, dependendo das limitações do iCloud. Você pode pausar ou cancelar quando quiser."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aproximativ %lld înregistrări locale se vor încărca în iCloud. Timp estimat ~%lld h, în funcție de limitările iCloud. Poți întrerupe sau anula oricând."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В iCloud будет отправлено около %lld локальных записей. Расчётное время ~%lld ч в зависимости от ограничений iCloud. Вы можете приостановить или отменить в любой момент."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ระเบียนในเครื่องประมาณ %lld รายการจะอัปโหลดไปยัง iCloud คาดว่าใช้เวลา ~%lld ชั่วโมง ขึ้นอยู่กับการจำกัดของ iCloud คุณหยุดชั่วคราวหรือยกเลิกได้ทุกเมื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaklaşık %lld yerel kayıt iCloud'a yüklenecek. iCloud sınırlamasına bağlı olarak tahmini süre ~%lld saat. İstediğiniz zaman duraklatabilir ya da iptal edebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "约 %1$lld 条本地记录将上传至 iCloud。预计耗时 ~%2$lld 小时（受 iCloud 限流影响）。可随时暂停或取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約有 %lld 筆本機記錄會上傳到 iCloud。視 iCloud 限流情況，預估約需 %lld 小時。你可以隨時暫停或取消。"
          }
        }
      }
    },
