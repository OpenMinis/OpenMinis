          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões são distribuídas entre os modelos para equilibrar a carga."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiunile sunt distribuite între modele pentru echilibrarea încărcării."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сессии распределяются между моделями для балансировки нагрузки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซสชันจะถูกกระจายไปยังโมเดลต่างๆ เพื่อกระจายโหลด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
