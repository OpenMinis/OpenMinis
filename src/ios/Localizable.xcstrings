    "Prevent the screen from sleeping while any session is running a task. May increase battery drain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhindert, dass der Bildschirm in den Ruhezustand wechselt, während eine Sitzung eine Aufgabe ausführt. Kann den Akkuverbrauch erhöhen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prevent the screen from sleeping while any session is running a task. May increase battery drain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita que la pantalla se apague mientras alguna sesión esté ejecutando una tarea. Puede aumentar el consumo de batería."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pigilan ang screen na matulog habang may session na tumatakbong task. Maaaring makadagdag sa paggamit ng baterya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empêche l'écran de se mettre en veille pendant qu'une session exécute une tâche. Peut augmenter la consommation de la batterie."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spriječi uspavljivanje zaslona dok bilo koja sesija izvodi zadatak. Može povećati potrošnju baterije."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cegah layar tertidur selama ada sesi yang menjalankan tugas. Dapat mempercepat pemakaian baterai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションがタスクを実行している間、画面がスリープしないようにします。バッテリーの消費が増える可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이 작업을 실행하는 동안 화면이 절전 모드로 들어가지 않도록 합니다. 배터리 소모가 늘어날 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halang skrin daripada tidur semasa ada sesi menjalankan tugas. Mungkin meningkatkan penggunaan bateri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapobiega wygaszaniu ekranu, gdy jakakolwiek sesja wykonuje zadanie. Może zwiększyć zużycie baterii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impede que a tela apague enquanto alguma sessão estiver executando uma tarefa. Pode aumentar o consumo de bateria."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Împiedică stingerea ecranului cât timp o sesiune execută o sarcină. Poate crește consumul de baterie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не давать экрану гаснуть, пока какая-либо сессия выполняет задачу. Может увеличить расход заряда."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป้องกันไม่ให้หน้าจอดับขณะที่มีเซสชันกำลังทำงาน อาจทำให้แบตเตอรี่หมดเร็วขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir oturum görev çalıştırırken ekranın kapanmasını engeller. Pil tüketimini artırabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有会话任务运行时保持屏幕不熄灭，可能增加电量损耗。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有工作階段任務運行時保持螢幕不熄滅，可能增加電量損耗。"
          }
        }
      }
    },
