          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话在模型之间分配以实现负载均衡。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段在模型之間分配以實現負載均衡。"
          }
        }
      }
    },
    "Sessions are distributed across models. Each session sticks to its assigned model unless it fails." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sitzungen werden auf Modelle verteilt. Jede Sitzung bleibt bei ihrem zugewiesenen Modell, es sei denn, es schlägt fehl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessions are distributed across models. Each session sticks to its assigned model unless it fails."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones se distribuyen entre los modelos. Cada sesión se mantiene en el modelo asignado salvo que este falle."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ipinapamahagi ang mga session sa iba't ibang model. Mananatili ang bawat session sa itinalagang model maliban kung mabigo ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sessions sont réparties entre les modèles. Chaque session reste sur son modèle assigné sauf en cas d'échec."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesije se raspoređuju među modelima. Svaka sesija ostaje na dodijeljenom modelu osim ako on ne zakaže."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi dibagikan ke beberapa model. Tiap sesi tetap memakai model yang ditugaskan kecuali model itu gagal."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションはモデル間で分配されます。各セッションは、失敗しない限り割り当てられたモデルに固定されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이 모델 간에 분배됩니다. 각 세션은 실패하지 않는 한 할당된 모델을 유지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesi diagihkan kepada beberapa model. Setiap sesi kekal pada model yang ditugaskan melainkan ia gagal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesje są rozdzielane między modele. Każda sesja zostaje przy przypisanym modelu, chyba że ten zawiedzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sessões são distribuídas entre os modelos. Cada sessão fica com o modelo atribuído, a menos que ele falhe."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesiunile sunt distribuite între modele. Fiecare sesiune rămâne la modelul atribuit, dacă acesta nu eșuează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сессии распределяются между моделями. Каждая сессия остаётся на назначенной модели, пока она не даст сбой."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เซสชันจะถูกกระจายไปยังโมเดลต่างๆ แต่ละเซสชันจะยึดกับโมเดลที่กำหนดไว้ เว้นแต่โมเดลนั้นล้มเหลว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumlar modeller arasında dağıtılır. Her oturum, başarısız olmadıkça atandığı modelde kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话分布在各模型之间。每个会话固定使用其分配的模型，除非失败。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作階段分佈在各模型之間。每個工作階段固定使用其分配的模型，除非失敗。"
          }
        }
      }
