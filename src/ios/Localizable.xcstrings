        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该服务商使用官方协议，思考参数由 Minis 内置维护。自定义规则适用于走 Chat Completions 接口的 OpenAI 兼容服务商。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個服務商使用官方協定，因此其思考參數由 Minis 維護。自訂規則適用於使用 Chat Completions API 的 OpenAI 相容服務商。"
          }
        }
      }
    },
