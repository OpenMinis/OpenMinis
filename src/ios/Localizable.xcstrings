    "“*” matches any characters. Matching ignores case and treats “.” and “-” as the same character." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“*” matches any characters. Matching ignores case and treats “.” and “-” as the same character."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«*» coincide con cualquier carácter. La coincidencia no distingue mayúsculas de minúsculas y trata «.» y «-» como el mismo carácter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“*”匹配任意字符。匹配时忽略大小写，且将“.”与“-”视为同一字符。"
          }
        }
      }
    },
