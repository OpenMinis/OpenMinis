          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso exclui todos os registros e arquivos da zona. Não pode ser desfeito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se șterge fiecare înregistrare și resursă din zonă. Acțiunea nu poate fi anulată."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит все записи + объекты внутри зоны. Отменить нельзя."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกระทำนี้จะลบทุกระเบียนและแอสเซตในโซน และย้อนกลับไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, bölgedeki her kaydı ve varlığı siler. Geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将删除区域内的所有记录 + 资源。此操作无法撤销。"
