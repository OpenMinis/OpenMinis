    "Text input is always enabled. Configure which additional input modalities this model supports." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texteingabe ist immer aktiviert. Konfigurieren Sie die zusätzlichen Eingabemodalitäten dieses Modells."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text input is always enabled. Configure which additional input modalities this model supports."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrada de texto siempre está activada. Configura qué modalidades de entrada adicionales admite este modelo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laging naka-enable ang text input. I-configure kung anong karagdagang input modality ang sinusuportahan ng model na ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entrée texte est toujours activée. Configurez les modalités d'entrée supplémentaires prises en charge."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos teksta uvijek je omogućen. Odredite koje dodatne vrste ulaza ovaj model podržava."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukan teks selalu aktif. Konfigurasikan modalitas masukan tambahan apa saja yang didukung model ini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト入力は常に有効です。このモデルがサポートする追加の入力モダリティを設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 입력은 항상 활성화되어 있습니다. 이 모델이 지원하는 추가 입력 방식을 설정하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Input teks sentiasa aktif. Konfigurasi modaliti input tambahan yang disokong model ini."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wprowadzanie tekstu jest zawsze włączone. Skonfiguruj dodatkowe rodzaje wejścia obsługiwane przez ten model."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A entrada de texto está sempre ativa. Configure quais outros tipos de entrada este modelo aceita."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introducerea de text este mereu activă. Configurează ce alte tipuri de intrare acceptă acest model."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ввод текста всегда включён. Настройте, какие дополнительные типы ввода поддерживает эта модель."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อินพุตข้อความเปิดใช้งานเสมอ กำหนดว่าโมเดลนี้รองรับรูปแบบอินพุตเพิ่มเติมใดบ้าง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin girişi her zaman etkindir. Bu modelin desteklediği ek giriş kiplerini yapılandırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本输入始终启用。配置此模型支持的其他输入模态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字輸入始終啟用。配置此模型支持的其他輸入模態。"
          }
        }
      }
    },
    "Text input is always supported. Disable modalities the model doesn't actually support to prevent sending unsupported attachments." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texteingabe wird immer unterstützt. Deaktivieren Sie nicht unterstützte Modalitäten, um das Senden inkompatibler Anhänge zu vermeiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text input is always supported. Disable modalities the model doesn't actually support to prevent sending unsupported attachments."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrada de texto siempre es compatible. Desactiva las modalidades que el modelo no admita realmente para evitar enviar adjuntos no compatibles."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laging suportado ang text input. I-disable ang mga modality na hindi talaga sinusuportahan ng model para maiwasang magpadala ng hindi suportadong attachment."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entrée texte est toujours prise en charge. Désactivez les modalités non supportées pour éviter d'envoyer des pièces jointes incompatibles."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos teksta uvijek je podržan. Onemogućite vrste ulaza koje model zapravo ne podržava kako se ne bi slali nepodržani privici."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukan teks selalu didukung. Nonaktifkan modalitas yang sebenarnya tidak didukung model agar lampiran tak didukung tidak terkirim."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト入力は常にサポートされています。モデルがサポートしないモダリティを無効にして、未対応の添付ファイルの送信を防ぎましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 입력은 항상 지원됩니다. 모델이 지원하지 않는 방식을 비활성화하여 지원되지 않는 첨부 파일 전송을 방지하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Input teks sentiasa disokong. Nyahaktifkan modaliti yang sebenarnya tidak disokong model untuk mengelakkan penghantaran lampiran tidak disokong."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wprowadzanie tekstu jest zawsze obsługiwane. Wyłącz rodzaje wejścia, których model faktycznie nie obsługuje, aby nie wysyłać nieobsługiwanych załączników."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A entrada de texto sempre tem suporte. Desative os tipos que o modelo não aceita de fato, para não enviar anexos incompatíveis."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introducerea de text este mereu acceptată. Dezactivează tipurile de intrare pe care modelul nu le acceptă cu adevărat, ca să nu se trimită atașamente incompatibile."
