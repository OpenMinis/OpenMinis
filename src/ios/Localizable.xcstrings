          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마운트 이름은 비어 있거나 '/'를 포함하거나 '.' 또는 '..'일 수 없습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama lekapan tidak boleh kosong, mengandungi '/', atau menjadi '.' atau '..'."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwa zamontowania nie może być pusta, zawierać „/” ani być „.” lub „..”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome da montagem não pode ficar vazio, conter '/' nem ser '.' ou '..'."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numele montării nu poate fi gol, nu poate conține „/” și nu poate fi „.” sau „..”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя подключения не должно быть пустым, содержать «/» или быть «.» или «..»."
          }
        },
        "th" : {
          "stringUnit" : {
