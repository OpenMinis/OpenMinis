    "Any image works. It's cropped to a square and shown with rounded corners." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Bild funktioniert. Es wird quadratisch zugeschnitten und mit runden Ecken angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Any image works. It's cropped to a square and shown with rounded corners."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirve cualquier imagen. Se recorta en cuadrado y se muestra con esquinas redondeadas."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kahit anong larawan puwede. Ginagawa itong parisukat at may bilog na sulok."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'importe quelle image convient. Elle est recadrée en carré et affichée avec des coins arrondis."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilo koja slika odgovara. Izrezuje se u kvadrat i prikazuje sa zaobljenim kutovima."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar apa pun bisa. Gambar dipotong menjadi persegi dan ditampilkan dengan sudut membulat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの画像でも使えます。正方形に切り抜かれ、角丸で表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 이미지든 사용할 수 있습니다. 정사각형으로 잘려 둥근 모서리로 표시됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mana-mana imej boleh. Ia dipangkas menjadi segi empat sama dan dipaparkan dengan bucu bulat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dowolny obraz się nada. Zostanie przycięty do kwadratu i pokazany z zaokrąglonymi rogami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer imagem serve. Ela é cortada em quadrado e exibida com cantos arredondados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orice imagine este bună. Se decupează pătrat și se afișează cu colțuri rotunjite."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подойдёт любое изображение. Оно обрезается до квадрата и показывается со скруглёнными углами."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้รูปภาพใดก็ได้ ระบบจะครอบตัดเป็นสี่เหลี่ยมจัตุรัสและแสดงแบบมุมมน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herhangi bir görsel olur. Kare olarak kırpılır ve köşeleri yuvarlatılmış gösterilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意图片都可以。将裁剪为正方形并以圆角显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意圖片都可以。將裁剪為正方形並以圓角顯示。"
          }
        }
      }
    },
