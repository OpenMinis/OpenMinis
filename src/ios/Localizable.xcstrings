    "This will clear all customizations (including force-enabled thinking) and restore the provider's default values." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Anpassungen (einschließlich erzwungenem Denkmodus) werden gelöscht und die Standardwerte des Anbieters wiederhergestellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will clear all customizations (including force-enabled thinking) and restore the provider's default values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto borrará todas las personalizaciones (incluido el razonamiento forzado) y restaurará los valores predeterminados del proveedor."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ic-clear nito lahat ng pagbabago (kasama ang sapilitang thinking) at ibabalik ang mga default na halaga ng provider."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela effacera toutes les personnalisations (y compris la réflexion forcée) et restaurera les valeurs par défaut du fournisseur."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo će ukloniti sve prilagodbe (uključujući prisilno omogućeno razmišljanje) i vratiti zadane vrijednosti pružatelja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan membersihkan semua kustomisasi (termasuk berpikir yang dipaksa aktif) dan memulihkan nilai bawaan penyedia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのカスタマイズ（強制有効化した思考を含む）がクリアされ、プロバイダのデフォルト値に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 사용자 정의(강제 활성화된 사고 포함)가 삭제되고 제공자의 기본값으로 복원됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan mengosongkan semua penyesuaian (termasuk berfikir yang dipaksa aktif) dan memulihkan nilai lalai pembekal."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyczyści to wszystkie własne ustawienia (w tym wymuszone myślenie) i przywróci wartości domyślne dostawcy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso vai limpar todas as personalizações (inclusive o raciocínio forçado) e restaurar os valores padrão do provedor."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vor șterge toate personalizările (inclusiv gândirea forțată) și se vor restaura valorile implicite ale furnizorului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все настройки (включая принудительно включённый режим мышления) будут сброшены, и восстановлены значения провайдера по умолчанию."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกระทำนี้จะล้างการปรับแต่งทั้งหมด (รวมถึงการบังคับเปิดการคิด) และคืนค่าเริ่มต้นของผู้ให้บริการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem tüm özelleştirmeleri (zorla etkinleştirilen düşünme dahil) temizler ve sağlayıcının varsayılan değerlerini geri yükler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将清除所有自定义设置（包括强制开启的深度思考），恢复为服务商默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將清除所有自訂設定（包括強制開啟的深度思考），恢復為服務商預設值。"
          }
        }
      }
    },
