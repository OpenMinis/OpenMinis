    "Migration canceled. Tap to resume backfilling local history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migration abgebrochen. Tippe, um das Nachtragen des lokalen Verlaufs fortzusetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migration canceled. Tap to resume backfilling local history."
