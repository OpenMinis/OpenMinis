    "Enables background audio playback for text-to-speech narration and music/audio playback while the app is in the background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviert die Hintergrund-Audiowiedergabe für Sprachsynthese und Musik-/Audiowiedergabe, während die App im Hintergrund ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enables background audio playback for text-to-speech narration and music/audio playback while the app is in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite la reproducción de audio en segundo plano para la narración de texto a voz y para reproducir música o audio mientras la app está en segundo plano."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinapagana ang background audio playback para sa text-to-speech narration at music/audio playback habang nasa background ang app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active la lecture audio en arrière-plan pour la synthèse vocale et la lecture de musique/audio lorsque l'app est en arrière-plan."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omogućuje reprodukciju zvuka u pozadini za čitanje teksta naglas te reprodukciju glazbe i zvuka dok je aplikacija u pozadini."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengaktifkan pemutaran audio latar belakang untuk narasi teks-ke-ucapan dan pemutaran musik/audio saat aplikasi di latar belakang."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリがバックグラウンドの間、テキスト読み上げや音楽・オーディオ再生のためのバックグラウンドオーディオ再生を有効にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 백그라운드에 있을 때 텍스트 음성 변환 및 음악/오디오 재생을 위한 백그라운드 오디오 재생을 활성화합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membolehkan main balik audio latar belakang untuk naratif teks-ke-pertuturan dan main balik muzik/audio semasa apl di latar belakang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącza odtwarzanie dźwięku w tle dla narracji tekst-na-mowę oraz muzyki, gdy aplikacja działa w tle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativa a reprodução de áudio em segundo plano para a narração de texto para fala e para música/áudio enquanto o app está em segundo plano."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite redarea audio în fundal pentru narațiunea text-to-speech și pentru muzică/audio cât timp aplicația este în fundal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включает фоновое воспроизведение аудио для озвучивания текста и проигрывания музыки/аудио, когда приложение работает в фоне."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดใช้งานการเล่นเสียงเบื้องหลังสำหรับการบรรยายข้อความเป็นเสียงพูดและการเล่นเพลง/เสียงขณะแอปอยู่เบื้องหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama arka plandayken metin okuma anlatımı ve müzik/ses çalma için arka plan ses oynatmayı etkinleştirir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许在后台播放音频，以增强文本朗读和音乐音频播放等功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許在背景播放音頻，以增強文字朗讀和音樂音頻播放等功能。"
          }
        }
      }
    },
