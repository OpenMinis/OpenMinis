      }
    },
    "Models and groups listed here can be invoked from the terminal via minis-model-use. Only these are visible to the agent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die hier aufgeführten Modelle und Gruppen können über das Terminal mit minis-model-use aufgerufen werden. Nur diese sind für den Agent sichtbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Models and groups listed here can be invoked from the terminal via minis-model-use. Only these are visible to the Agent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos y grupos que aparecen aquí se pueden invocar desde la terminal con minis-model-use. Solo estos son visibles para Minis Agent."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles et groupes listés ici peuvent être invoqués depuis le terminal via minis-model-use. Seuls ceux-ci sont visibles par Minis Agent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここに表示されるモデルとグループは、ターミナルから minis-model-use で呼び出せます。Agent にはこれらのみが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에 나열된 모델과 그룹은 터미널에서 minis-model-use를 통해 호출할 수 있습니다. Agent에게는 이것만 보입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перечисленные здесь модели и группы можно вызывать из терминала через minis-model-use. Только они видны для Agent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此处列出的模型和分组可通过终端 minis-model-use 命令调用。仅这些对 Agent 可见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此處列出的模型和分組可通過終端 minis-model-use 命令調用。僅這些對 Agent 可見。"
          }
        }
      }
    },
    "Models are tried in order. If one fails, the next is used." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle werden der Reihe nach versucht. Bei Fehler wird das nächste verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Models are tried in order. If one fails, the next is used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos se prueban en orden. Si uno falla, se usa el siguiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles sont essayés dans l'ordre. En cas d'échec, le suivant est utilisé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルは順番に試行されます。失敗した場合、次のモデルが使用されます。"
