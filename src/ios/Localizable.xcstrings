    "Switch to text input" : {
      "comment" : "Mic button exits voice mode",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zur Texteingabe wechseln"
          }
        },
        "en" : {
