    "Are you absolutely sure?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du dir absolut sicher?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you absolutely sure?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás totalmente seguro?"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigurado ka ba talaga?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous absolument sûr ?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeste li potpuno sigurni?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah Anda benar-benar yakin?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本当に実行しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말 확실합니까?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adakah anda benar-benar pasti?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno chcesz to zrobić?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza absoluta?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ești absolut sigur?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы полностью уверены?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณแน่ใจจริงๆ หรือไม่"
