    "Removes this server from Minis and forgets its password. Backups already stored on the server are left untouched." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt diesen Server aus Minis und vergisst sein Passwort. Bereits auf dem Server gespeicherte Sicherungen bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes this server from Minis and forgets its password. Backups already stored on the server are left untouched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita este servidor de Minis y olvida su contraseña. Las copias de seguridad ya guardadas en el servidor no se modifican."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaalis ang server na ito sa Minis at kinakalimutan ang password nito. Hindi ginagalaw ang mga backup na nakaimbak na sa server."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retire ce serveur de Minis et oublie son mot de passe. Les sauvegardes déjà stockées sur le serveur restent intactes."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanja ovaj poslužitelj iz Minisa i zaboravlja njegovu lozinku. Sigurnosne kopije već pohranjene na poslužitelju ostaju netaknute."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus server ini dari Minis dan melupakan kata sandinya. Cadangan yang sudah tersimpan di server tidak diusik."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサーバを Minis から削除し、パスワードを破棄します。サーバ上のバックアップはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 서버를 Minis에서 제거하고 암호를 삭제합니다. 서버에 저장된 백업은 그대로 남습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuang server ini dari Minis dan melupakan kata laluannya. Sandaran yang telah disimpan di server tidak diusik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa ten serwer z Minis i zapomina jego hasło. Kopie już przechowywane na serwerze pozostają nietknięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove este servidor do Minis e esquece a senha dele. Os backups já guardados no servidor não são alterados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimină acest server din Minis și uită parola lui. Copiile deja stocate pe server rămân neatinse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет этот сервер из Minis и забывает его пароль. Копии, уже хранящиеся на сервере, остаются нетронутыми."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นำเซิร์ฟเวอร์นี้ออกจาก Minis และลืมรหัสผ่านของมัน ข้อมูลสำรองที่จัดเก็บบนเซิร์ฟเวอร์แล้วจะไม่ถูกแตะต้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu sunucuyu Minis'ten kaldırır ve parolasını unutur. Sunucuda zaten bulunan yedeklere dokunulmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从 Minis 中移除此服务器并清除其密码。服务器上已有的备份不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將這台伺服器從 Minis 移除並忘記其密碼。伺服器上既有的備份不受影響。"
          }
        }
      }
    },
