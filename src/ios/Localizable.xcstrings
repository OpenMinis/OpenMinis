    "These directories appear in iOS Files under On My iPhone → Minis. Tap a row to see details, browse, or toggle visibility." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Verzeichnisse erscheinen in der iOS-App „Dateien“ unter „Auf meinem iPhone“ → Minis. Tippen Sie auf einen Eintrag, um Details anzuzeigen, zu durchsuchen oder die Sichtbarkeit umzuschalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These directories appear in iOS Files under On My iPhone → Minis. Tap a row to see details, browse, or toggle visibility."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos directorios aparecen en Archivos de iOS, en En mi iPhone → Minis. Toca una fila para ver los detalles, explorar o cambiar la visibilidad."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lumalabas ang mga directory na ito sa iOS Files sa ilalim ng On My iPhone → Minis. I-tap ang row para makita ang detalye, mag-browse, o i-toggle ang visibility."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces dossiers apparaissent dans l'app Fichiers d'iOS sous Sur mon iPhone → Minis. Touchez une ligne pour voir les détails, parcourir ou activer/désactiver la visibilité."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovi se direktoriji pojavljuju u iOS aplikaciji Files pod On My iPhone → Minis. Dodirnite redak za detalje, pregledavanje ili promjenu vidljivosti."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direktori ini muncul di Files iOS pada Di iPhone Saya → Minis. Ketuk baris untuk melihat detail, menelusuri, atau mengalihkan visibilitas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのディレクトリは iOS の「ファイル」App の「この iPhone 内」→ Minis に表示されます。行をタップすると詳細の確認、ブラウズ、表示/非表示の切り替えができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 디렉터리는 iOS 파일 앱의 내 iPhone → Minis에 표시됩니다. 행을 탭하여 세부 정보 보기, 탐색 또는 표시 여부를 전환할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direktori ini muncul dalam Files iOS di bawah Pada iPhone Saya → Minis. Ketik baris untuk melihat butiran, melayari, atau menogol keterlihatan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te katalogi są widoczne w Plikach iOS w Na moim iPhonie → Minis. Dotknij wiersza, aby zobaczyć szczegóły, przeglądać lub przełączyć widoczność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes diretórios aparecem em Arquivos do iOS, em No meu iPhone → Minis. Toque em uma linha para ver detalhes, navegar ou alternar a visibilidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceste directoare apar în Fișiere iOS la Pe iPhone → Minis. Atinge un rând pentru detalii, navigare sau comutarea vizibilității."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти папки отображаются в «Файлах» iOS в разделе «На моём iPhone» → Minis. Нажмите строку, чтобы посмотреть сведения, просмотреть содержимое или изменить видимость."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไดเรกทอรีเหล่านี้แสดงใน Files ของ iOS ภายใต้ On My iPhone → Minis แตะแถวเพื่อดูรายละเอียด เรียกดู หรือสลับการแสดงผล"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu dizinler iOS Dosyalar'da iPhone'umda → Minis altında görünür. Ayrıntıları görmek, göz atmak ya da görünürlüğü değiştirmek için bir satıra dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些目录会显示在 iOS“文件”App 的“我的 iPhone → Minis”下。轻点某一行可查看详情、浏览内容或切换可见性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些目錄會顯示在 iOS“檔案”App 的“我的 iPhone → Minis”下。輕點某一行可查看詳情、瀏覽內容或切換可見性。"
          }
        }
      }
    },
