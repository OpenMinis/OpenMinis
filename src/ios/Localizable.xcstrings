    "settings_memory_global_enabled_footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn deaktiviert, überspringen neue Sitzungen standardmäßig GLOBAL.md und tägliche Erinnerungen. Bestehende Sitzungen behalten ihre eigene Einstellung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, new sessions skip GLOBAL.md and daily memory by default. Existing sessions keep their own setting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando está desactivado, las sesiones nuevas omiten GLOBAL.md y la memoria diaria de forma predeterminada. Las sesiones existentes conservan su propia configuración."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag naka-off, nilalaktawan ng mga bagong session ang GLOBAL.md at ang daily memory bilang default. Pinapanatili ng mga umiiral na session ang sarili nilang setting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : les nouvelles sessions ignorent GLOBAL.md et la mémoire quotidienne par défaut. Les sessions existantes conservent leur propre réglage."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada je isključeno, nove sesije prema zadanom preskaču GLOBAL.md i dnevnu memoriju. Postojeće sesije zadržavaju vlastitu postavku."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat nonaktif, sesi baru melewati GLOBAL.md dan memory harian secara default. Sesi yang sudah ada mempertahankan pengaturannya sendiri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、新しいセッションは既定で GLOBAL.md と日次メモリをスキップします。既存セッションの設定は維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꺼두면 새 세션은 기본적으로 GLOBAL.md와 일일 메모리를 건너뜁니다. 기존 세션은 각자의 설정을 유지합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila dimatikan, sesi baharu melangkau GLOBAL.md dan memory harian secara lalai. Sesi sedia ada mengekalkan tetapannya sendiri."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy wyłączone, nowe sesje domyślnie pomijają GLOBAL.md i pamięć dzienną. Istniejące sesje zachowują własne ustawienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando desativado, as novas sessões ignoram o GLOBAL.md e a memória diária por padrão. As sessões existentes mantêm o próprio ajuste."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când e dezactivat, sesiunile noi sar implicit peste GLOBAL.md și memoria zilnică. Sesiunile existente își păstrează propria setare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда выключено, новые сессии по умолчанию пропускают GLOBAL.md и ежедневную память. Существующие сессии сохраняют собственные настройки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อปิด เซสชันใหม่จะข้าม GLOBAL.md และ memory รายวันตามค่าเริ่มต้น เซสชันที่มีอยู่จะคงการตั้งค่าของตัวเองไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalıyken yeni oturumlar varsayılan olarak GLOBAL.md ve günlük belleği atlar. Mevcut oturumlar kendi ayarını korur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后所有新会话默认不使用记忆（不注入 GLOBAL.md 与每日记忆）。已存在的会话保留各自的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉後所有新工作階段預設不使用記憶（不注入 GLOBAL.md 與每日記憶）。已存在的工作階段保留各自的設定。"
          }
        }
      }
    },
