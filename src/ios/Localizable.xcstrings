    "This will delete all local messages for this chat and re-download them from iCloud. Local changes that haven't synced yet will be lost. Continue?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle lokalen Nachrichten dieses Chats gelöscht und neu aus iCloud geladen. Nicht synchronisierte lokale Änderungen gehen verloren. Fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will delete all local messages for this chat and re-download them from iCloud. Local changes that haven't synced yet will be lost. Continue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará todos los mensajes locales de este chat y los volverá a descargar desde iCloud. Se perderán los cambios locales que aún no se hayan sincronizado. ¿Continuar?"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tatanggalin nito lahat ng lokal na mensahe sa chat na ito at ida-download ulit mula sa iCloud. Mawawala ang mga lokal na pagbabagong hindi pa na-sync. Magpatuloy?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera toutes les messages locaux de ce chat et les retéléchargera depuis iCloud. Les modifications locales non synchronisées seront perdues. Continuer ?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo će obrisati sve lokalne poruke ovog razgovora i ponovno ih preuzeti s iClouda. Lokalne promjene koje još nisu sinkronizirane bit će izgubljene. Želite li nastaviti?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan menghapus semua pesan lokal untuk obrolan ini dan mengunduhnya ulang dari iCloud. Perubahan lokal yang belum tersinkronisasi akan hilang. Lanjutkan?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このチャットのローカル メッセージをすべて削除し、iCloud から再ダウンロードします。未同期のローカル変更は失われます。続行しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 채팅의 로컬 메시지를 모두 삭제하고 iCloud에서 다시 내려받습니다. 아직 동기화되지 않은 로컬 변경 사항은 사라집니다. 계속할까요?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan memadam semua mesej tempatan untuk sembang ini dan memuat turunnya semula dari iCloud. Perubahan tempatan yang belum disegerakkan akan hilang. Teruskan?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunie to wszystkie lokalne wiadomości tego czatu i pobierze je ponownie z iCloud. Niezsynchronizowane zmiany lokalne zostaną utracone. Kontynuować?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso vai excluir todas as mensagens locais deste chat e baixá-las de novo do iCloud. As alterações locais ainda não sincronizadas serão perdidas. Continuar?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vor șterge toate mesajele locale ale acestui chat și se vor descărca din nou din iCloud. Modificările locale nesincronizate încă se vor pierde. Continui?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это удалит все локальные сообщения этого чата и заново загрузит их из iCloud. Локальные изменения, которые ещё не синхронизированы, будут потеряны. Продолжить?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การกระทำนี้จะลบข้อความในเครื่องทั้งหมดของแชทนี้และดาวน์โหลดใหม่จาก iCloud การเปลี่ยนแปลงในเครื่องที่ยังไม่ได้ซิงค์จะสูญหาย ดำเนินการต่อหรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu işlem bu sohbetin tüm yerel mesajlarını siler ve iCloud'dan yeniden indirir. Henüz eşitlenmemiş yerel değişiklikler kaybolur. Sürdürülsün mü?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将删除此对话本地的所有消息并从 iCloud 重新下载。尚未同步的本地修改会丢失。继续吗？"
