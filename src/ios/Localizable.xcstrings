    "Chats includes every file in each conversation, not just the messages." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Chats“ umfasst jede Datei in jeder Unterhaltung, nicht nur die Nachrichten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats incluye todos los archivos de cada conversación, no solo los mensajes."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasama sa Chats ang bawat file sa bawat usapan, hindi lang ang mga mensahe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Conversations » inclut tous les fichiers de chaque conversation, pas seulement les messages."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razgovori uključuju svaku datoteku u svakom razgovoru, ne samo poruke."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrolan mencakup setiap file dalam tiap percakapan, bukan hanya pesannya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「チャット」にはメッセージだけでなく、各会話のすべてのファイルが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'채팅'에는 메시지뿐 아니라 각 대화의 모든 파일이 포함됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembang merangkumi setiap file dalam tiap perbualan, bukan hanya mesejnya."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czaty obejmują wszystkie pliki każdej rozmowy, nie tylko wiadomości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As conversas incluem todos os arquivos de cada uma, não só as mensagens."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversațiile includ toate fișierele din fiecare discuție, nu doar mesajele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Чаты» включают все файлы каждого диалога, а не только сообщения."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชทรวมทุกไฟล์ในแต่ละการสนทนา ไม่ใช่แค่ข้อความ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbetler, yalnızca mesajları değil her sohbetteki tüm dosyaları kapsar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“聊天”不仅包含消息，还包含每个对话中的所有文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「聊天」不只包含訊息，還包含每個對話中的所有檔案。"
          }
        }
      }
    },
    "Chats includes every file in each conversation, not just the messages. Files larger than %lld MB are listed in the backup but not included." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Chats“ umfasst jede Datei in jeder Unterhaltung, nicht nur die Nachrichten. Dateien über %lld MB werden in der Sicherung gelistet, aber nicht eingeschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats includes every file in each conversation, not just the messages. Files larger than %lld MB are listed in the backup but not included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats incluye todos los archivos de cada conversación, no solo los mensajes. Los archivos de más de %lld MB aparecen en la copia de seguridad, pero no se incluyen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasama sa Chats ang bawat file sa bawat usapan, hindi lang ang mga mensahe. Nakalista sa backup pero hindi kasama ang mga file na lampas %lld MB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Conversations » inclut tous les fichiers de chaque conversation, pas seulement les messages. Les fichiers de plus de %lld Mo sont répertoriés dans la sauvegarde mais non inclus."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razgovori uključuju svaku datoteku u svakom razgovoru, ne samo poruke. Datoteke veće od %lld MB navedene su u sigurnosnoj kopiji, ali nisu uključene."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrolan mencakup setiap file dalam tiap percakapan, bukan hanya pesannya. File lebih besar dari %lld MB terdaftar dalam cadangan tetapi tidak disertakan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「チャット」にはメッセージだけでなく、各会話のすべてのファイルが含まれます。%lld MB を超えるファイルは、バックアップに記載されますが中身は含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'채팅'에는 메시지뿐 아니라 각 대화의 모든 파일이 포함됩니다. %lld MB를 초과하는 파일은 백업에 기재되지만 내용은 포함되지 않습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembang merangkumi setiap file dalam tiap perbualan, bukan hanya mesejnya. File lebih besar daripada %lld MB disenaraikan dalam sandaran tetapi tidak disertakan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czaty obejmują każdy plik w rozmowie, nie tylko wiadomości. Pliki większe niż %lld MB są wypisane w kopii, ale nie są w niej zawarte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats inclui todos os arquivos de cada conversa, não só as mensagens. Arquivos maiores que %lld MB são listados no backup, mas não incluídos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat-urile includ toate fișierele din fiecare conversație, nu doar mesajele. Fișierele mai mari de %lld MB sunt listate în copie, dar nu incluse."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Чаты» включают все файлы каждого диалога, а не только сообщения. Файлы больше %lld МБ указываются в копии, но не включаются в неё."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชทรวมทุกไฟล์ในแต่ละการสนทนา ไม่ใช่แค่ข้อความ ไฟล์ที่ใหญ่กว่า %lld MB จะอยู่ในรายการของข้อมูลสำรองแต่ไม่ถูกรวมไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sohbetler, yalnızca mesajları değil her sohbetteki tüm dosyaları içerir. %lld MB'tan büyük dosyalar yedekte listelenir ama dahil edilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话备份包含每个对话中的所有文件，而不仅是消息。超过 %lld MB 的文件会记录在备份中，但不包含其内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「聊天」不只包含訊息，還包含每個對話中的所有檔案。超過 %lld MB 的檔案會列在備份中，但不會納入內容。"
          }
        }
      }
    },
