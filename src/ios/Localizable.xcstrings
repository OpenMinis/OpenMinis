    "Use the braces button to insert a reference to an App environment variable as $$NAME. Its value is filled in at runtime." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende die Klammern-Schaltfläche, um einen Verweis auf eine App-Umgebungsvariable als $$NAME einzufügen. Ihr Wert wird zur Laufzeit eingesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the braces button to insert a reference to an App environment variable as $$NAME. Its value is filled in at runtime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el botón de llaves para insertar una referencia a una variable de entorno de la app como $$NAME. Su valor se completa en tiempo de ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le bouton accolades pour insérer une référence à une variable d'environnement de l'app sous la forme $$NAME. Sa valeur est renseignée à l'exécution."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "波括弧ボタンをタップすると、$$NAME の形式で App 環境変数への参照を挿入できます。値は実行時に埋め込まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중괄호 버튼을 눌러 $$NAME 형식으로 앱 환경 변수에 대한 참조를 삽입하세요. 값은 실행 시 채워집니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите кнопку с фигурными скобками, чтобы вставить ссылку на переменную окружения приложения в виде $$NAME. Её значение подставляется во время выполнения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按花括号按钮，以 $$NAME 的形式插入对 App 环境变量的引用。其值会在运行时填入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點按花括號按鈕，以 $$NAME 的形式插入對 App 環境變量的引用。其值會在運行時填入。"
          }
        }
      }
    },
