# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.kotlin/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore
# Default Minis Ultra upload key — tracked so CI and local release APKs
# share one certificate (UpdateChecker). Override with MINIS_UPLOAD_*.
!src/android/release.keystore
# [T-signing-secret-untracked] The password file is NOT tracked: a plaintext
# credential next to a tracked private key lets anyone sign an APK with this
# project's upgrade identity. Copy signing.properties.example and fill it in
# locally; CI supplies MINIS_UPLOAD_* from repository secrets.
src/android/signing.properties

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Xcode
xcuserdata/
*.xcscmblueprint
*.xccheckout
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# iOS
*.ipa
*.dSYM.zip
*.dSYM

# CocoaPods
Pods/
Podfile.lock

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store

# Environment and secrets
.env
.env.*

# Private key material must never enter the tree. `git ls-files` carries no
# file of these shapes today, and the only committed keystore is the public
# upload certificate exempted under "Keystore files" above. Runtime credentials
# (SSH keys, MCP OAuth tokens, provider API keys) live in the device keystore /
# filesDir and are read from there — never from a tracked path.
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# App Store Connect API keys
fastlane/.env
fastlane/appstore-keys/

# Claude Code
.claude/

# Temporary patches
deps/*.patch

# iSH build outputs
deps/libs/
deps/include/
deps/resources/
deps/ish/build-ios/
deps/ish/build-native/
deps/.cache/

# iOS framework bundles produced by deps/build_rclone_ios.sh (Rclone
# .xcframework). Regenerated, never authored — same treatment as rclone.aar.
deps/frameworks/

# deps/ffmpeg-6.1.2/, deps/alpine/ and the deps/lame-3.100 rules were dropped
# together with their builders in the hygiene pass: nothing in this tree
# generates those paths any more (deps/build_ffmpeg.sh, deps/build_lame.sh and
# the QEMU Alpine qcow2 trio under scripts/ were the only producers).
# deps/frameworks/ stays because deps/build_rclone_ios.sh still writes there.

src-bak/
src/android/app/src/main/assets/bashism/

# Xcode debugger state (breakpoints) — personal dev state, never track
xcshareddata/xcdebugger/

# Build-time generated Swift (from ProviderCustomization.xcconfig); regenerated each build
src/ios/Generated/

# Debug-only skill assets staged by scripts/gen_debug_skill_android.sh from
# .claude/skills/debug-server/; regenerated on every debug build.
src/android/app/src/debug/assets/debug-skill/

# ── Build artifacts produced by deps/ scripts — never commit binaries ──
# These are generated, not authored: rebuild them from source instead of
# tracking them (tracked binaries also leak the build machine's paths via
# debug symbols). See deps/build_proot.sh, deps/prepare_alpine_rootfs.sh
# and docs for the build order.
src/android/app/src/main/assets/proot-aarch64
src/android/app/src/main/assets/alpine-minirootfs.tar.gz
src/android/app/src/main/assets/ubuntu-base.tar.gz
src/android/app/src/main/jniLibs/arm64-v8a/*.so
# The two proot ELF loaders are TRACKED, as an exception to the rule above.
# They are vendored Termux builds (proot 5.1.107-70) whose Android-specific
# loader patches our deps/proot fork does not carry; pairing the fork-built
# loader with our proot SEGVs the guest on some ROMs (OnePlus 7 Pro /
# crDroid 12.11: "vpid 1: terminated with signal 11"), and the exact Termux
# deb has been rotated out of their repo — these bytes cannot be re-downloaded
# or rebuilt from anything in this tree. See deps/build_proot.sh.
!src/android/app/src/main/jniLibs/arm64-v8a/libproot-loader.so
!src/android/app/src/main/jniLibs/arm64-v8a/libproot-loader32.so

# Never track a compiler output under deps/, whatever builder appears there.
# The vendored deps/lame-3.100 tree carried 56 committed .o/.lo files because
# the old LAME-specific list covered autotools *config* output (.la, .libs,
# Makefile, config.status) but not the object files themselves.
deps/**/*.o
deps/**/*.lo
deps/**/*.la
deps/**/*.lai
deps/**/.libs/
deps/**/.deps/

# rclone.aar is a build artifact of deps/build_rclone_android.sh (~15MB),
# not a vendored binary — same treatment as the iOS Rclone.xcframework it is
# built alongside (deps/build_rclone_ios.sh).
src/android/app/libs/rclone.aar

src/android/mirrors.local.properties

# Python bytecode (scripts/*.py)
__pycache__/
*.pyc
