fastlane/.env
fastlane/appstore-keys/

# Claude Code
.claude/

# Temporary patches
deps/*.patch

# Alpine downloadable assets (ISO, rootfs, qcow2, etc.)
deps/alpine/

# iSH build outputs
deps/libs/
deps/include/
deps/resources/
deps/ish/build-ios/
deps/ish/build-native/
deps/.cache/

# FFmpeg source (downloaded by build_ffmpeg.sh). Note the trailing -6.1.2:
# a bare `deps/ffmpeg-*/` also swallowed deps/ffmpeg-patch/, which is hand
# written source that the build needs and must stay tracked.
deps/ffmpeg-6.1.2/

# FFmpeg framework build products (regenerated by deps/build_ffmpeg.sh).
deps/frameworks/

src-bak/
src/android/app/src/main/assets/bashism/

# Xcode debugger state (breakpoints) — personal dev state, never track
xcshareddata/xcdebugger/

# Build-time generated Swift (from ProviderCustomization.xcconfig); regenerated each build
src/ios/Generated/

# Debug-only skill assets staged by scripts/gen_debug_skill_android.sh from
# .claude/skills/debug-server/; regenerated on every debug build.
src/android/app/src/debug/assets/debug-skill/

# ── Build artifacts produced by deps/ scripts — never commit binaries ──
# These are generated, not authored: rebuild them from source instead of
# tracking them (tracked binaries also leak the build machine's paths via
# debug symbols). See deps/build_proot.sh, deps/build_lame.sh,
# deps/prepare_alpine_rootfs.sh and docs for the build order.
src/android/app/src/main/assets/proot-aarch64
src/android/app/src/main/assets/alpine-minirootfs.tar.gz
src/android/app/src/main/jniLibs/arm64-v8a/*.so
# The two proot ELF loaders are TRACKED, as an exception to the rule above.
# They are vendored Termux builds (proot 5.1.107-70) whose Android-specific
# loader patches our deps/proot fork does not carry; pairing the fork-built
# loader with our proot SEGVs the guest on some ROMs (OnePlus 7 Pro /
# crDroid 12.11: "vpid 1: terminated with signal 11"), and the exact Termux
# deb has been rotated out of their repo — these bytes cannot be re-downloaded
# or rebuilt from anything in this tree. See deps/build_proot.sh.
!src/android/app/src/main/jniLibs/arm64-v8a/libproot-loader.so
!src/android/app/src/main/jniLibs/arm64-v8a/libproot-loader32.so
deps/lame-build/
deps/lame-3.100/**/.libs/

# LAME autotools output (./configure writes absolute build paths into these)
deps/lame-3.100/**/Makefile
deps/lame-3.100/config.status
deps/lame-3.100/config.h
deps/lame-3.100/libtool
deps/lame-3.100/**/stamp-h1
deps/lame-3.100/**/*.la
deps/lame-3.100/**/*.lai
deps/lame-3.100/**/.libs/
deps/lame-3.100/**/.deps/

# rclone.aar is a build artifact of deps/build_rclone_android.sh (~15MB),
# not a vendored binary — same treatment as the iOS Rclone.xcframework it is
# built alongside (deps/build_rclone_ios.sh).
src/android/app/libs/rclone.aar
